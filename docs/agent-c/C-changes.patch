diff --git a/phpstan.ops.neon b/phpstan.ops.neon
new file mode 100644
index 0000000..d89b3dd
--- /dev/null
+++ b/phpstan.ops.neon
@@ -0,0 +1,25 @@
+# Scoped static analysis for the platform/operations code (Agent C).
+#
+# WHY A SECOND CONFIG
+# -------------------
+# `phpstan.neon` analyses app/, config/, database/ and routes/ at level 8, which
+# is the intent — but it had never actually run (it listed two parameters that
+# PHPStan 2 rejects, so the whole configuration was invalid), and a full run
+# over the application takes far longer than a CI job should.
+#
+# This file inherits the project rules and narrows the paths to the code this
+# branch owns, so the gate runs in seconds and can be made blocking today.
+# Widening it back to the whole application is a separate, tracked task that
+# needs a baseline of the existing findings — see docs/ops/HANDOFF-C.md.
+includes:
+    - phpstan.neon
+
+parameters:
+    paths:
+        - app/Support/Backup
+        - app/Support/Ops
+        - app/Logging
+        - app/Console/Commands/Ops
+        - app/Console/Commands/Infrastructure
+        - app/Services/Infrastructure
+    reportUnmatchedIgnoredErrors: false
diff --git a/routes/console.php b/routes/console.php
index c37cf68..98c5eee 100644
--- a/routes/console.php
+++ b/routes/console.php
@@ -289,3 +289,52 @@ Schedule::job(new ExpireReportExportsJob)
     ->name('reporting-export-retention')
     ->withoutOverlapping()
     ->onOneServer();
+
+/* -------------------------------------------------------------------------
+| Platform operations lanes (Agent C: runtime / CI / operations)
+|--------------------------------------------------------------------------
+|
+| Two entries, both of which fail silently if they are missing:
+|
+|   ops:heartbeat  proves the scheduler itself is alive. If `schedule:work`
+|                  stops, nothing else in this file runs to report it, and
+|                  every HTTP health probe stays green while settlement,
+|                  prize expiry and payouts quietly stop.
+|
+|   backup:...worm takes the encrypted database backup. A backup lane that is
+|                  not scheduled produces no error anywhere; the first
+|                  symptom is a restore with nothing to restore.
+|
+| Both are switched by config/ops.php so an operator can disable a lane per
+| deployment without editing this file, and the backup window is configurable
+| because it must not overlap the draw window.
+|
+*/
+
+if ((bool) config('ops.lanes.heartbeat', true)) {
+    // Every minute, and `withoutOverlapping` is deliberately absent: a
+    // heartbeat that waits for a lock is not a heartbeat, and this command
+    // finishes in microseconds.
+    Schedule::command('ops:heartbeat')
+        ->everyMinute()
+        ->name('platform-heartbeat')
+        ->onOneServer();
+}
+
+if ((bool) config('ops.backup_schedule.enabled', true)) {
+    $backupAt = (string) config('ops.backup_schedule.at', '02:20');
+
+    $event = Schedule::command('backup:execute-encrypted-worm', ['--keep' => (string) config('backup.minimum_keep', 7)])
+        ->dailyAt($backupAt)
+        ->name('database-encrypted-backup')
+        // Two backups racing over the same output directory would each prune
+        // the other's half-written archive.
+        ->withoutOverlapping(180)
+        ->onOneServer();
+
+    $timezone = config('ops.backup_schedule.timezone');
+
+    if (is_string($timezone) && $timezone !== '') {
+        $event->timezone($timezone);
+    }
+}
diff --git a/scripts/ci/assert-ops-assets.sh b/scripts/ci/assert-ops-assets.sh
new file mode 100755
index 0000000..d277bd4
--- /dev/null
+++ b/scripts/ci/assert-ops-assets.sh
@@ -0,0 +1,261 @@
+#!/usr/bin/env bash
+# =============================================================================
+# assert-ops-assets.sh — the platform/operations surface is complete and sound.
+#
+# Every check here exists because of a specific way the repository was broken
+# or could regress silently:
+#
+#   * scripts/ops/*.sh must be executable and pass `bash -n`. A backup script
+#     committed without +x is a backup script that fails at 2am.
+#   * shellcheck must pass at error severity: `set -e` that does not actually
+#     stop on the failure inside a pipeline is the classic way an ops script
+#     reports success after doing nothing.
+#   * the compose file must parse and must not run a development server, must
+#     not publish the database port, and must declare healthchecks for the
+#     services that can hang.
+#   * the production Dockerfile must end as a non-root user and must not
+#     contain a dev server or a package manager in the runtime stage.
+#   * the scheduler and backup lanes must be wired (config/ops.php + routes/
+#     console.php) — a lane that is implemented but unscheduled is a lane that
+#     never runs.
+#
+# USAGE
+#   scripts/ci/assert-ops-assets.sh
+# =============================================================================
+set -Eeuo pipefail
+IFS=$'\n\t'
+
+ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd -- "${ROOT}"
+
+fail=0
+ok()  { printf '  ok   %s\n' "$*"; }
+bad() { printf '::error::%s\n' "$*"; fail=1; }
+
+echo "--- ops scripts present, executable and syntactically valid ---"
+
+REQUIRED_SCRIPTS=(
+    scripts/ops/preflight.sh
+    scripts/ops/backup.sh
+    scripts/ops/restore.sh
+    scripts/ops/verify-backup.sh
+    scripts/ops/deploy.sh
+    scripts/ops/rollback.sh
+    scripts/ops/smoke-test.sh
+    scripts/ops/healthcheck.sh
+    scripts/ops/assert-ciphertext-only.sh
+    scripts/ops/migration-audit.php
+    scripts/ops/lib/common.sh
+)
+
+for script in "${REQUIRED_SCRIPTS[@]}"; do
+    if [[ ! -f "${script}" ]]; then
+        bad "missing operations asset: ${script}"
+        continue
+    fi
+
+    if [[ ! -x "${script}" ]]; then
+        bad "${script} is not executable (chmod +x)"
+    fi
+
+    case "${script}" in
+        *.sh) bash -n "${script}" && ok "${script}" || bad "${script} has a syntax error" ;;
+        *.php) php -l "${script}" >/dev/null && ok "${script}" || bad "${script} has a syntax error" ;;
+    esac
+done
+
+echo "--- shellcheck (error severity) ---"
+
+if command -v shellcheck >/dev/null 2>&1; then
+    # SC1091: sourced file paths are resolved at runtime.
+    if shellcheck --severity=error --exclude=SC1091 scripts/ops/*.sh scripts/ops/lib/*.sh scripts/ci/*.sh; then
+        ok "shellcheck found no errors"
+    else
+        bad "shellcheck reported errors in the ops scripts"
+    fi
+else
+    printf '  skip shellcheck not installed\n'
+fi
+
+echo "--- scheduled lanes are wired ---"
+
+if grep -q "ops:heartbeat" routes/console.php; then
+    ok "scheduler heartbeat lane is scheduled"
+else
+    bad "routes/console.php does not schedule ops:heartbeat; a stopped scheduler would be invisible"
+fi
+
+if grep -q "backup:execute-encrypted-worm" routes/console.php; then
+    ok "encrypted backup lane is scheduled"
+else
+    bad "routes/console.php does not schedule backup:execute-encrypted-worm"
+fi
+
+for command in ops:preflight ops:health backup:execute-encrypted-worm backup:verify backup:extract; do
+    if grep -rq "protected \$signature = '${command%% *}" app/Console/Commands 2>/dev/null; then
+        ok "command ${command} exists"
+    else
+        bad "command ${command} is referenced by the ops scripts but not implemented"
+    fi
+done
+
+echo "--- backup encryption is fail-closed ---"
+
+# A deny-list of known-weak keys is not the same thing as a usable default key,
+# so match the *use* of a fallback key rather than any mention of one:
+#   env('BACKUP_ENCRYPTION_KEY', 'something')   <- a key the app will happily use
+#   config(...) ?? 'some literal'               <- the same defect in disguise
+if grep -rnE "env\(\s*['\"]BACKUP_ENCRYPTION_KEY['\"]\s*," app/ config/ 2>/dev/null; then
+    bad "BACKUP_ENCRYPTION_KEY is given a default value; a backup key must never have a fallback"
+else
+    ok "no default value for BACKUP_ENCRYPTION_KEY"
+fi
+
+if grep -rnE "(backup_key|BACKUP_ENCRYPTION_KEY)[^;\n]{0,40}(\?\?|=)\s*['\"][^'\"]{8,}" app/ config/ 2>/dev/null; then
+    bad "a hardcoded backup key literal is assigned as a usable value"
+else
+    ok "no hardcoded backup key assigned to a usable value"
+fi
+
+# Authenticated encryption is the property that matters; assert both halves of
+# the construction actually exist rather than one magic string.
+CIPHER_FILE=app/Support/Backup/BackupCipher.php
+
+if grep -q "aes-256-gcm" "${CIPHER_FILE}" \
+    && grep -qE "HASH_HMAC|hash_hmac\(" "${CIPHER_FILE}" \
+    && grep -qE "hash_equals" "${CIPHER_FILE}"; then
+    ok "backup cipher uses authenticated encryption (AEAD envelope + HMAC, constant-time compare)"
+else
+    bad "backup cipher is not authenticated (need AEAD, HMAC and a constant-time compare)"
+fi
+
+echo "--- container definitions ---"
+
+if [[ -f docker/php/Dockerfile ]]; then
+    RUNTIME_STAGE="$(awk '/^FROM .* AS runtime/{flag=1} flag' docker/php/Dockerfile)"
+
+    if grep -qE '^USER [^r]' docker/php/Dockerfile; then
+        ok "production image declares a non-root USER"
+    else
+        bad "docker/php/Dockerfile never switches to a non-root user"
+    fi
+
+    if printf '%s' "${RUNTIME_STAGE}" | grep -qiE 'artisan serve|npm run dev|vite --host|composer install'; then
+        bad "the runtime stage of docker/php/Dockerfile contains a development server or a package manager"
+    else
+        ok "runtime stage contains no development server or package manager"
+    fi
+
+    grep -q 'HEALTHCHECK' docker/php/Dockerfile && ok "production image has a HEALTHCHECK" \
+        || bad "production image has no HEALTHCHECK"
+else
+    bad "docker/php/Dockerfile is missing"
+fi
+
+# The stale duplicate Dockerfile that could not build: it copied files that
+# .dockerignore excludes and pinned PHP 8.3 against a ^8.4 requirement.
+if [[ -f docker/php-fpm/Dockerfile ]]; then
+    bad "docker/php-fpm/Dockerfile still exists (stale PHP 8.3 build whose own context is excluded by .dockerignore)"
+else
+    ok "no stale duplicate Dockerfile"
+fi
+
+if [[ -f docker-compose.production.yml ]]; then
+    COMPOSE=docker-compose.production.yml
+
+    if command -v docker >/dev/null 2>&1; then
+        docker compose -f "${COMPOSE}" config --quiet 2>/dev/null && ok "compose file parses" || bad "compose file does not parse"
+    elif command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' >/dev/null 2>&1; then
+        # `docker compose config` also interpolates variables and checks the
+        # schema; a YAML parse only proves the file is well formed. That is
+        # strictly weaker, so the weaker result is labelled as such instead of
+        # being reported as a full compose validation.
+        python3 - "${COMPOSE}" <<'PYEOF' && ok "compose file is valid YAML (schema/interpolation NOT validated: docker absent)" || bad "compose file does not parse"
+import sys, yaml
+with open(sys.argv[1], encoding="utf-8") as handle:
+    document = yaml.safe_load(handle)
+if not isinstance(document, dict) or "services" not in document:
+    sys.exit("no services block")
+PYEOF
+    elif php -r 'exit(function_exists("yaml_parse") ? 0 : 1);' >/dev/null 2>&1; then
+        php -r '$d = yaml_parse_file("'"${COMPOSE}"'"); exit(is_array($d) && isset($d["services"]) ? 0 : 1);' \
+            && ok "compose file is valid YAML (schema/interpolation NOT validated: docker absent)" \
+            || bad "compose file does not parse"
+    else
+        printf '  skip compose parse (no docker, no python yaml, no php yaml)\n'
+    fi
+
+    grep -qiE 'artisan serve' "${COMPOSE}" && bad "compose runs a development server" || ok "no development server in compose"
+
+    if grep -qE '^\s+-\s+"?\$\{?DB_PORT' "${COMPOSE}" || grep -qE '3306:3306' "${COMPOSE}"; then
+        bad "compose publishes the database port on the host"
+    else
+        ok "database port is not published"
+    fi
+
+    for service in app nginx; do
+        awk -v svc="  ${service}:" '$0==svc{f=1} f&&/^  [a-z]/&&$0!=svc{f=0} f&&/healthcheck:/{print "found"}' "${COMPOSE}" | grep -q found \
+            && ok "compose service ${service} declares a healthcheck" \
+            || bad "compose service ${service} has no healthcheck"
+    done
+else
+    bad "docker-compose.production.yml is missing"
+fi
+
+echo "--- compose secret wiring has consumers ---"
+
+# A `*_FILE` variable that no code reads is worse than no variable at all: an
+# operator sets it, believes a secret is wired, and the service quietly falls
+# back to a default or fails later. Every such variable must be consumed.
+if [[ -f docker-compose.production.yml ]]; then
+    unconsumed=0
+
+    # Consumed by the official MySQL image itself, not by our code.
+    CONSUMED_BY_BASE_IMAGE='^(MYSQL_PASSWORD_FILE|MYSQL_ROOT_PASSWORD_FILE|MYSQL_RANDOM_ROOT_PASSWORD)$'
+
+    while IFS= read -r name; do
+        [[ -n "${name}" ]] || continue
+
+        if printf '%s' "${name}" | grep -qE "${CONSUMED_BY_BASE_IMAGE}"; then
+            continue
+        fi
+
+        # Every place a variable can legitimately be read: PHP source, config,
+        # the Rust worker, and the container entrypoint (which loads *_FILE
+        # secrets generically before PHP starts).
+        if ! grep -rqF "${name}" app/ config/ runtime/ bootstrap/ docker/ scripts/ .env.example 2>/dev/null; then
+            bad "compose passes ${name}, but nothing in app/, config/, runtime/, docker/ or scripts/ reads it"
+            unconsumed=1
+        fi
+    done < <(grep -oE '^[[:space:]]+[A-Z0-9_]+_FILE:' docker-compose.production.yml | tr -d ' :' | sort -u)
+
+    [[ "${unconsumed}" -eq 0 ]] && ok "every *_FILE variable in compose is read by application code"
+fi
+
+echo "--- structured logging wiring ---"
+
+if grep -q "LOG_FORMAT" config/logging.php && grep -q "php://stderr" config/logging.php; then
+    ok "log channel declares an explicit stream and a format switch"
+else
+    bad "the stderr log channel does not pin its stream or expose LOG_FORMAT"
+fi
+
+if [[ -x scripts/ci/assert-structured-logs.sh ]]; then
+    ok "structured-log assertion script is present and executable"
+else
+    bad "scripts/ci/assert-structured-logs.sh is missing or not executable"
+fi
+
+echo "--- preflight integration ---"
+
+grep -q "ops:preflight" scripts/ops/deploy.sh && ok "deploy runs ops:preflight" || bad "deploy.sh does not run ops:preflight"
+grep -q "migration-audit.php" scripts/ops/deploy.sh && ok "deploy runs the migration safety audit" || bad "deploy.sh does not audit migrations"
+grep -q "backup.sh" scripts/ops/deploy.sh && ok "deploy takes a backup before migrating" || bad "deploy.sh does not back up before migrating"
+
+echo
+if [[ "${fail}" -ne 0 ]]; then
+    echo "Operations asset assertions failed."
+    exit 1
+fi
+
+echo "Operations assets are complete and sound."
diff --git a/scripts/ci/assert-result-lane-seams.sh b/scripts/ci/assert-result-lane-seams.sh
new file mode 100755
index 0000000..b4dcf22
--- /dev/null
+++ b/scripts/ci/assert-result-lane-seams.sh
@@ -0,0 +1,93 @@
+#!/usr/bin/env bash
+# =============================================================================
+# assert-result-lane-seams.sh — the seams between a result lane and the rest of
+# the repository (moved verbatim in intent out of ci.yml).
+#
+# A lane can work perfectly and still be unreachable: robots.txt deindexes it,
+# .env.example never documents its keys, the guest navigation forgets it, or a
+# competitor's brand name ships in its copy. These are cheap greps, and they run
+# before the full suite so an obvious breach fails in a second.
+#
+# USAGE
+#   scripts/ci/assert-result-lane-seams.sh
+# =============================================================================
+set -Eeuo pipefail
+IFS=$'\n\t'
+
+ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd -- "${ROOT}"
+
+echo "--- robots.txt: search blocked, content crawlable ---"
+test -f public/robots.txt || { echo "::error::public/robots.txt is missing"; exit 1; }
+
+for lane in national-lottery weekly-lottery bingo-lottery pcso-lottery; do
+    grep -qx "Disallow: /${lane}/search" public/robots.txt \
+        || { echo "::error::robots.txt does not block /${lane}/search"; exit 1; }
+
+    if grep -qE "^Disallow:[[:space:]]*/${lane}/?[[:space:]]*$" public/robots.txt; then
+        echo "::error::robots.txt blocks the whole ${lane} lane, not just its search route"
+        exit 1
+    fi
+
+    if grep -qE "^Disallow:[[:space:]]*/${lane}/year" public/robots.txt; then
+        echo "::error::robots.txt blocks the ${lane} year archive"
+        exit 1
+    fi
+done
+
+echo "--- .env.example documents every key each lane config reads ---"
+node -e '
+  const fs = require("fs");
+  const example = fs.readFileSync(".env.example", "utf8");
+  let failed = false;
+
+  for (const lane of ["national_lottery", "weekly_lottery", "bingo_lottery", "pcso_lottery", "contact"]) {
+    const config = fs.readFileSync("config/" + lane + ".php", "utf8");
+    const prefix = lane === "contact" ? "CONTACT" : lane.toUpperCase();
+    const keys = new Set(
+      [...config.matchAll(new RegExp("env\\(\\s*[\x27\"](\\w*" + prefix + "_[A-Z0-9_]+)[\x27\"]", "g"))].map(m => m[1])
+    );
+
+    if (keys.size === 0) {
+      console.error("::error::no env keys parsed out of config/" + lane + ".php");
+      failed = true;
+      continue;
+    }
+
+    for (const key of keys) {
+      if (!new RegExp("^#?\\s*" + key + "=", "m").test(example)) {
+        console.error("::error::" + key + " is read by config/" + lane + ".php but undocumented in .env.example");
+        failed = true;
+      }
+
+      if (/(TOKEN|SECRET|KEY)$/.test(key) && new RegExp("^" + key + "=.+", "m").test(example)) {
+        console.error("::error::" + key + " has a value in .env.example");
+        failed = true;
+      }
+    }
+  }
+
+  process.exit(failed ? 1 : 0);
+'
+
+echo "--- /contact must stay crawlable ---"
+if grep -qE "^Disallow:[[:space:]]*/contact" public/robots.txt; then
+    echo "::error::robots.txt blocks /contact, which is ordinary public content"
+    exit 1
+fi
+
+echo "--- no competitor string in any public surface ---"
+if grep -rniE "thailotto" app config routes lang public database \
+        resources/views resources/css resources/js 2>/dev/null \
+    | grep -v "^resources/views/vendor/"; then
+    echo "::error::a competitor reference reached production source"
+    exit 1
+fi
+
+echo "--- guest navigation links both public lanes ---"
+for name in national-lottery.index weekly-lottery.index bingo-lottery.index pcso-lottery.index contact; do
+    grep -q "route('${name}')" resources/views/layouts/app.blade.php \
+        || { echo "::error::guest navigation has no link to ${name}"; exit 1; }
+done
+
+echo "Seam contracts hold."
diff --git a/scripts/ci/assert-runtime-alignment.sh b/scripts/ci/assert-runtime-alignment.sh
new file mode 100755
index 0000000..80b2fcb
--- /dev/null
+++ b/scripts/ci/assert-runtime-alignment.sh
@@ -0,0 +1,163 @@
+#!/usr/bin/env bash
+# =============================================================================
+# assert-runtime-alignment.sh — the CI runtime must be the runtime we ship.
+#
+# WHY THIS EXISTS
+# ---------------
+# The base commit's workflows installed PHP 8.3 and Node 20 while
+# `composer.json` requires PHP ^8.4 (and `composer.lock` pins that platform) and
+# `package.json` requires Node >=24 <25 with `.npmrc` setting
+# `engine-strict=true`. Three consequences, all of them real:
+#
+#   * `composer install` refuses to resolve the lock file on PHP 8.3, so the CI
+#     job fails before it can test anything;
+#   * `npm ci` fails the same way on Node 20 because engine-strict turns the
+#     engines field into a hard requirement;
+#   * and if either had been downgraded to "make CI green", the pipeline would
+#     have been validating a runtime the application cannot use in production.
+#
+# The fix is to make the alignment a checked invariant rather than a habit:
+# this script fails when the workflow, the lock file, .nvmrc and package.json
+# disagree. It is runnable locally:
+#
+#   scripts/ci/assert-runtime-alignment.sh
+# =============================================================================
+set -Eeuo pipefail
+IFS=$'\n\t'
+
+ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd -- "${ROOT}"
+
+fail=0
+note() { printf '  %s\n' "$*"; }
+bad()  { printf '::error::%s\n' "$*"; fail=1; }
+good() { printf '  ok  %s\n' "$*"; }
+
+echo "--- composer platform requirement ---"
+COMPOSER_PHP="$(php -r '$c=json_decode(file_get_contents("composer.json"),true); echo $c["require"]["php"] ?? "";')"
+LOCK_PHP="$(php -r '$c=json_decode(file_get_contents("composer.lock"),true); echo $c["platform"]["php"] ?? "";')"
+
+if [[ -z "${COMPOSER_PHP}" ]]; then
+    bad "composer.json does not declare a php requirement."
+else
+    good "composer.json requires php ${COMPOSER_PHP}"
+fi
+
+if [[ "${COMPOSER_PHP}" != "${LOCK_PHP}" ]]; then
+    bad "composer.lock platform (${LOCK_PHP}) disagrees with composer.json (${COMPOSER_PHP}); the lock is stale. Run composer update --lock."
+else
+    good "composer.lock platform matches: ${LOCK_PHP}"
+fi
+
+# The minimum PHP of the declared constraint, e.g. ^8.4 -> 8.4.
+REQUIRED_PHP="${COMPOSER_PHP#^}"
+REQUIRED_PHP="${REQUIRED_PHP%%[., ]*}"
+
+echo "--- package.json engines ---"
+NODE_ENGINE="$(php -r '$c=json_decode(file_get_contents("package.json"),true); echo $c["engines"]["node"] ?? "";')"
+NPM_ENGINE="$(php -r '$c=json_decode(file_get_contents("package.json"),true); echo $c["engines"]["npm"] ?? "";')"
+PACKAGE_MANAGER="$(php -r '$c=json_decode(file_get_contents("package.json"),true); echo $c["packageManager"] ?? "";')"
+
+if [[ -z "${NODE_ENGINE}" ]]; then
+    bad "package.json does not declare an engines.node range."
+else
+    good "package.json requires node ${NODE_ENGINE}"
+fi
+
+echo "--- .nvmrc ---"
+if [[ ! -f .nvmrc ]]; then
+    bad ".nvmrc is missing; local and CI Node drift is then unavoidable."
+else
+    NVMRC="$(tr -d 'v \n' < .nvmrc)"
+    good ".nvmrc pins node ${NVMRC}"
+
+    # Extract the engine floor, e.g. ">=24 <25" -> 24.
+    ENGINE_FLOOR="$(printf '%s' "${NODE_ENGINE}" | sed -E 's/^[^0-9]*([0-9]+).*/\1/')"
+    NVMRC_MAJOR="${NVMRC%%.*}"
+
+    if [[ -n "${ENGINE_FLOOR}" && "${NVMRC_MAJOR}" != "${ENGINE_FLOOR}" ]]; then
+        bad ".nvmrc pins node ${NVMRC} but package.json requires ${NODE_ENGINE}."
+    else
+        good ".nvmrc major (${NVMRC_MAJOR}) satisfies package.json (${NODE_ENGINE})"
+    fi
+fi
+
+if [[ ! -f .npmrc ]] || ! grep -q 'engine-strict=true' .npmrc; then
+    bad ".npmrc must set engine-strict=true; without it the engines field is advisory and CI silently installs on the wrong Node."
+else
+    good ".npmrc sets engine-strict=true"
+fi
+
+if [[ -n "${PACKAGE_MANAGER}" ]]; then
+    PM_NPM="${PACKAGE_MANAGER#npm@}"
+    good "packageManager pins ${PACKAGE_MANAGER}"
+
+    # The pinned npm must satisfy engines.npm, otherwise corepack installs a
+    # package manager the package itself declares unsupported.
+    if [[ -n "${NPM_ENGINE}" ]]; then
+        FLOOR="$(printf '%s' "${NPM_ENGINE}" | sed -E 's/^[^0-9]*([0-9]+).*/\1/')"
+        CEIL="$(printf '%s' "${NPM_ENGINE}" | sed -E 's/.*<([0-9]+).*/\1/')"
+        PM_MAJOR="${PM_NPM%%.*}"
+
+        if [[ "${PM_MAJOR}" -lt "${FLOOR}" ]] || { [[ "${CEIL}" =~ ^[0-9]+$ ]] && [[ "${PM_MAJOR}" -ge "${CEIL}" ]]; }; then
+            bad "packageManager npm@${PM_NPM} does not satisfy engines.npm (${NPM_ENGINE})."
+        else
+            good "packageManager npm@${PM_NPM} satisfies engines.npm (${NPM_ENGINE})"
+        fi
+    fi
+else
+    bad "package.json does not declare packageManager; the npm version used by CI is then whatever the runner image happens to ship."
+fi
+
+echo "--- workflow runtime declarations ---"
+shopt -s nullglob
+WORKFLOWS=(.github/workflows/*.yml .github/workflows/*.yaml)
+shopt -u nullglob
+
+if [[ "${#WORKFLOWS[@]}" -eq 0 ]]; then
+    bad "No workflows found under .github/workflows."
+fi
+
+for workflow in "${WORKFLOWS[@]}"; do
+    # php-version: '8.x' entries
+    while IFS= read -r line; do
+        version="$(printf '%s' "${line}" | sed -E "s/.*php-version:[[:space:]]*'?([0-9]+\.[0-9]+)'?.*/\1/")"
+
+        if [[ "${version}" < "${REQUIRED_PHP}" ]]; then
+            bad "${workflow}: php-version ${version} is below the required ${REQUIRED_PHP}."
+        else
+            good "${workflow}: php-version ${version}"
+        fi
+    done < <(grep -nE "php-version:[[:space:]]*'?[0-9]+\.[0-9]+" "${workflow}" || true)
+
+    # node-version: entries — either a quoted major or an .nvmrc reference.
+    while IFS= read -r line; do
+        value="$(printf '%s' "${line}" | sed -E "s/.*node-version:[[:space:]]*'?([^'\"#]+)'?.*/\1/" | tr -d ' ')"
+
+        case "${value}" in
+            *nvmrc*)
+                good "${workflow}: node-version from .nvmrc"
+                ;;
+            *)
+                major="${value%%.*}"
+                floor="$(printf '%s' "${NODE_ENGINE}" | sed -E 's/^[^0-9]*([0-9]+).*/\1/')"
+
+                if [[ "${major}" =~ ^[0-9]+$ ]] && [[ -n "${floor}" ]] && [[ "${major}" -lt "${floor}" ]]; then
+                    bad "${workflow}: node-version ${value} is below the required ${NODE_ENGINE}."
+                else
+                    good "${workflow}: node-version ${value}"
+                fi
+                ;;
+        esac
+    done < <(grep -nE "node-version:" "${workflow}" || true)
+done
+
+if [[ "${fail}" -ne 0 ]]; then
+    echo
+    echo "Runtime alignment failed. The CI runtime must satisfy composer.json and package.json;"
+    echo "downgrading the runtime to make a workflow green tests a runtime we do not ship."
+    exit 1
+fi
+
+echo
+echo "Runtime alignment holds: PHP ${REQUIRED_PHP}+, Node ${NODE_ENGINE}."
diff --git a/scripts/ci/assert-structure.sh b/scripts/ci/assert-structure.sh
new file mode 100755
index 0000000..ee1d308
--- /dev/null
+++ b/scripts/ci/assert-structure.sh
@@ -0,0 +1,130 @@
+#!/usr/bin/env bash
+# =============================================================================
+# assert-structure.sh — repository invariants that the test suite cannot see.
+#
+# Extracted from the inline YAML in the base commit's ci.yml so that it can be
+# run before pushing, and so the workflow file stays readable. The checks are
+# unchanged in intent; each one caught a real failure at some point:
+#
+#   php -l                 a parse error is a 500 on every route
+#   required files         a refactor that deletes a service still "builds"
+#   runtime directories    a missing storage/framework/views is a confusing
+#                          "Please provide a valid cache path" much later
+#   model/factory parity   a model with HasFactory and no factory fails only
+#                          in the one test that calls ::factory()
+#
+# USAGE
+#   scripts/ci/assert-structure.sh
+# =============================================================================
+set -Eeuo pipefail
+IFS=$'\n\t'
+
+ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd -- "${ROOT}"
+
+fail=0
+ok()  { printf '  ok   %s\n' "$*"; }
+bad() { printf '::error::%s\n' "$*"; fail=1; }
+
+echo "--- php syntax ---"
+COUNT=0
+
+while IFS= read -r -d '' file; do
+    if ! php -l "${file}" >/dev/null 2>&1; then
+        printf '::error file=%s::syntax error\n' "${file}"
+        fail=1
+    fi
+    COUNT=$((COUNT + 1))
+done < <(find app bootstrap config database routes tests scripts -name '*.php' -print0 2>/dev/null)
+
+ok "${COUNT} PHP files parse"
+
+echo "--- required structural files ---"
+REQUIRED=(
+    app/Models/User.php
+    app/Models/Agent.php
+    app/Services/Finance/FinancialReconciliationService.php
+    app/Services/Infrastructure/ImmutableBackupService.php
+    app/Services/Infrastructure/DatabaseDumpService.php
+    app/Support/Backup/BackupCipher.php
+    app/Support/Ops/ProductionPreflight.php
+    app/Logging/RedactSensitiveData.php
+    app/Http/Controllers/HealthController.php
+    app/Console/Commands/Ops/PreflightCommand.php
+    app/Console/Commands/Ops/HealthCommand.php
+    app/Console/Commands/Ops/HeartbeatCommand.php
+    app/Console/Commands/Infrastructure/ExecuteEncryptedBackupCommand.php
+    app/Console/Commands/Infrastructure/VerifyBackupCommand.php
+    app/Console/Commands/Infrastructure/ExtractBackupCommand.php
+    app/Console/Commands/Infrastructure/RestoreDatabaseCommand.php
+    config/backup.php
+    config/ops.php
+    routes/api.php
+    routes/web.php
+    public/index.php
+    .github/workflows/ci.yml
+    .github/workflows/security.yml
+    docker/php/Dockerfile
+    docker-compose.production.yml
+)
+
+MISSING=0
+
+for required in "${REQUIRED[@]}"; do
+    if [[ ! -f "${required}" ]]; then
+        bad "missing required file: ${required}"
+        MISSING=$((MISSING + 1))
+    fi
+done
+
+[[ "${MISSING}" -eq 0 ]] && ok "${#REQUIRED[@]} required files present"
+
+echo "--- runtime directories ---"
+for directory in \
+    bootstrap/cache \
+    storage/app/private \
+    storage/app/public \
+    storage/framework/cache/data \
+    storage/framework/sessions \
+    storage/framework/testing \
+    storage/framework/views \
+    storage/logs
+do
+    [[ -d "${directory}" ]] && continue
+    bad "missing runtime directory: ${directory}"
+done
+ok "runtime directories checked"
+
+echo "--- migrations and tests exist ---"
+[[ -n "$(find database/migrations -name '*.php' -print -quit)" ]] && ok "migrations present" || bad "no migrations found"
+[[ -n "$(find tests -name '*Test.php' -print -quit)" ]] && ok "tests present" || bad "no tests found"
+
+echo "--- HasFactory parity ---"
+PARITY=0
+
+while IFS= read -r -d '' model; do
+    name="$(basename "${model}" .php)"
+
+    # An abstract model cannot be instantiated, so `::factory()` on it is
+    # meaningless: the base classes under app/Models/Support are shared parents,
+    # not entities. Requiring a factory for them was a false positive in the
+    # previous workflow's version of this check.
+    if grep -qE '^\s*(abstract\s+)?(final\s+)?class ' "${model}" && grep -qE '^abstract\s+class ' "${model}"; then
+        continue
+    fi
+
+    if grep -q 'HasFactory' "${model}" && [[ ! -f "database/factories/${name}Factory.php" ]]; then
+        bad "model ${model} declares HasFactory but database/factories/${name}Factory.php is missing"
+        PARITY=1
+    fi
+done < <(find app/Models -name '*.php' -print0 2>/dev/null)
+
+[[ "${PARITY}" -eq 0 ]] && ok "every model with HasFactory has a factory"
+
+echo
+if [[ "${fail}" -ne 0 ]]; then
+    echo "Structural assertions failed."
+    exit 1
+fi
+
+echo "Structural assertions hold."
diff --git a/scripts/ci/assert-structured-logs.sh b/scripts/ci/assert-structured-logs.sh
new file mode 100755
index 0000000..0a3ee4e
--- /dev/null
+++ b/scripts/ci/assert-structured-logs.sh
@@ -0,0 +1,128 @@
+#!/usr/bin/env bash
+# =============================================================================
+# assert-structured-logs.sh — production logging is JSON, on stderr, redacted.
+#
+# WHY THIS EXISTS
+# ---------------
+# Three separate failures were possible here and all three were real at some
+# point in this repository's history:
+#
+#   1. `LOG_CHANNEL=stderr` resolved to a StreamHandler with no explicit stream,
+#      so the channel wrote to storage/logs/laravel.log instead of stderr. A
+#      container then has logs in a file nobody collects.
+#   2. that resolved handler carried no redaction tap, so a context array with
+#      `password` was written to disk in the clear.
+#   3. `LOG_FORMAT=json` had no effect because no JSON formatter was configured,
+#      so a log pipeline had prose to parse.
+#
+# This script boots the application the way a container does (LOG_CHANNEL=stderr,
+# LOG_FORMAT=json), logs a record containing a fake credential, and asserts:
+#
+#   * exactly one line was written, and it is valid JSON;
+#   * the credential is `[REDACTED]` and non-secret context survives;
+#   * the line went to stderr, not to storage/logs/laravel.log.
+#
+# USAGE
+#   scripts/ci/assert-structured-logs.sh
+#
+# EXIT
+#   0 structured, redacted logging verified · 1 otherwise
+# =============================================================================
+set -Eeuo pipefail
+IFS=$'\n\t'
+
+ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd -- "${ROOT}"
+
+fail=0
+ok()  { printf '  ok   %s\n' "$*"; }
+bad() { printf '::error::%s\n' "$*"; fail=1; }
+
+PROBE_SECRET='log-probe-do-not-leak-0001'
+STDERR_FILE="$(mktemp)"
+STDOUT_FILE="$(mktemp)"
+LOG_FILE='storage/logs/laravel.log'
+LOG_SIZE_BEFORE=0
+
+[[ -f "${LOG_FILE}" ]] && LOG_SIZE_BEFORE="$(wc -c < "${LOG_FILE}")"
+
+echo "--- structured logging (LOG_FORMAT=json, LOG_CHANNEL=stderr) ---"
+
+# APP_ENV is pinned here rather than inherited. The application refuses to boot
+# with a production environment that fails the safety guard (fixture GLO source,
+# insecure session cookies), and that refusal is correct — this script is about
+# log formatting, not about production readiness. ProductionPreflightTest covers
+# the guard. Nothing below depends on the environment name.
+if ! APP_ENV=testing LOG_CHANNEL=stderr LOG_FORMAT=json PROBE_SECRET="${PROBE_SECRET}" php -r '
+require "vendor/autoload.php";
+$app = require "bootstrap/app.php";
+$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
+Log::info("structured-log-probe", [
+    "password" => getenv("PROBE_SECRET"),
+    "amount" => 12.5,
+]);
+' >"${STDOUT_FILE}" 2>"${STDERR_FILE}"; then
+    bad "the probe could not boot the application (see stderr below)"
+    sed -n '1,20p' "${STDERR_FILE}"
+    rm -f "${STDERR_FILE}" "${STDOUT_FILE}"
+    exit 1
+fi
+
+LINES="$(grep -c . "${STDERR_FILE}" || true)"
+
+if [[ "${LINES}" -ne 1 ]]; then
+    bad "expected exactly one log line on stderr, found ${LINES}"
+    sed -n '1,10p' "${STDERR_FILE}"
+fi
+
+LINE="$(grep -m1 'structured-log-probe' "${STDERR_FILE}" || true)"
+
+if [[ -z "${LINE}" ]]; then
+    bad "no structured-log-probe line appeared on stderr — the channel is not writing to stderr"
+fi
+
+# 1. valid JSON, one object per line.
+if ! printf '%s' "${LINE}" | python3 -c 'import json,sys; json.loads(sys.stdin.read())' 2>/dev/null; then
+    bad "the log line is not valid JSON: ${LINE:0:200}"
+else
+    ok "the log line is a single valid JSON object"
+fi
+
+# 2. the credential is masked; non-secret context survives.
+if printf '%s' "${LINE}" | grep -qF "${PROBE_SECRET}"; then
+    bad "a credential reached the log line in the clear"
+else
+    ok "the credential value was redacted"
+fi
+
+if ! printf '%s' "${LINE}" | grep -q '\[REDACTED\]'; then
+    bad "the redaction mask is missing from the log line"
+fi
+
+if ! printf '%s' "${LINE}" | grep -q '"amount"'; then
+    bad "non-secret context was dropped from the log line"
+else
+    ok "non-secret context is preserved (the log is still useful)"
+fi
+
+# 3. nothing leaked into the application log file.
+LOG_SIZE_AFTER=0
+[[ -f "${LOG_FILE}" ]] && LOG_SIZE_AFTER="$(wc -c < "${LOG_FILE}")"
+
+if [[ "${LOG_SIZE_AFTER}" -ne "${LOG_SIZE_BEFORE}" ]]; then
+    if tail -c +$((LOG_SIZE_BEFORE + 1)) "${LOG_FILE}" | grep -q 'structured-log-probe'; then
+        bad "the record was written to ${LOG_FILE}; LOG_CHANNEL=stderr must stream to stderr"
+    fi
+else
+    ok "the record did not go to ${LOG_FILE}"
+fi
+
+rm -f "${STDERR_FILE}" "${STDOUT_FILE}"
+
+echo
+if [[ "${fail}" -ne 0 ]]; then
+    echo "Structured logging assertions failed."
+    exit 1
+fi
+
+echo "Structured logging is JSON, on stderr, and redacted."
diff --git a/scripts/ci/assert-vite-manifest.mjs b/scripts/ci/assert-vite-manifest.mjs
new file mode 100644
index 0000000..4c7553e
--- /dev/null
+++ b/scripts/ci/assert-vite-manifest.mjs
@@ -0,0 +1,167 @@
+#!/usr/bin/env node
+/**
+ * assert-vite-manifest.mjs — the build must produce every asset the app expects.
+ *
+ * WHY NODE AND NOT AN INLINE `node -e` IN ci.yml
+ * ----------------------------------------------
+ * The base commit checked the manifest with a ~20-line inline script embedded
+ * in YAML. Two problems with that shape: it could not be run locally without
+ * copy-pasting out of the workflow, and YAML line-continuations around its
+ * quotes were the kind of thing that breaks during an unrelated edit. A real
+ * file can be linted, tested and run by a developer before pushing.
+ *
+ * WHAT IT CHECKS
+ *   1. public/build/manifest.json exists and parses as an object.
+ *   2. Every entry point declared in vite.config.js produced an output file
+ *      that exists on disk.
+ *   3. No source entry point is an empty file (an empty CSS file "builds"
+ *      successfully and produces an unstyled site).
+ *   4. Every `imports`/`css` reference inside the manifest resolves on disk,
+ *      so a chunk that is referenced but missing is caught here rather than by
+ *      a 404 in the browser.
+ *   5. With --require-build, a missing manifest is fatal (production); without
+ *      it, a missing manifest only warns (developer running the check early).
+ *
+ * USAGE
+ *   node scripts/ci/assert-vite-manifest.mjs [--require-build] [--json]
+ */
+
+import { readFileSync, existsSync, statSync } from 'node:fs';
+import { resolve, dirname } from 'node:path';
+import process from 'node:process';
+
+const args = new Set(process.argv.slice(2));
+const requireBuild = args.has('--require-build');
+const asJson = args.has('--json');
+
+const root = resolve(dirname(new URL(import.meta.url).pathname), '..', '..');
+const manifestPath = resolve(root, 'public/build/manifest.json');
+const viteConfigPath = resolve(root, 'vite.config.js');
+
+/** @type {string[]} */
+const errors = [];
+/** @type {string[]} */
+const notes = [];
+
+function fail(message) {
+  errors.push(message);
+}
+
+if (!existsSync(manifestPath)) {
+  if (requireBuild) {
+    fail('public/build/manifest.json does not exist. `npm run build` must run during the release.');
+  } else {
+    notes.push('manifest missing (allowed outside --require-build)');
+  }
+} else {
+  let manifest;
+
+  try {
+    manifest = JSON.parse(readFileSync(manifestPath, 'utf8'));
+  } catch (error) {
+    fail(`public/build/manifest.json is not valid JSON: ${error.message}`);
+    manifest = null;
+  }
+
+  if (manifest) {
+    const names = Object.keys(manifest);
+
+    if (names.length === 0) {
+      fail('public/build/manifest.json is empty.');
+    } else {
+      notes.push(`${names.length} manifest entries`);
+    }
+
+    // 2 + 4: every file referenced by the manifest exists.
+    const referenced = new Set();
+
+    for (const [name, entry] of Object.entries(manifest)) {
+      if (!entry || typeof entry !== 'object') {
+        fail(`manifest entry "${name}" is not an object.`);
+        continue;
+      }
+
+      if (typeof entry.file === 'string') {
+        referenced.add(entry.file);
+      } else {
+        fail(`manifest entry "${name}" has no "file".`);
+      }
+
+      for (const key of ['css', 'assets']) {
+        for (const file of entry[key] ?? []) {
+          referenced.add(file);
+        }
+      }
+
+      for (const imported of entry.imports ?? []) {
+        if (!manifest[imported]) {
+          fail(`manifest entry "${name}" imports "${imported}", which is not in the manifest.`);
+        }
+      }
+    }
+
+    for (const file of referenced) {
+      const path = resolve(root, 'public/build', file);
+
+      if (!existsSync(path)) {
+        fail(`manifest references "${file}" but public/build/${file} does not exist.`);
+      } else if (statSync(path).size === 0 && /\.(css|js|mjs)$/.test(file)) {
+        fail(`public/build/${file} is empty.`);
+      }
+    }
+  }
+}
+
+// 2 + 3: every declared entry point built, and is not empty.
+if (!existsSync(viteConfigPath)) {
+  notes.push('vite.config.js missing; entry-point checks skipped');
+} else {
+  const config = readFileSync(viteConfigPath, 'utf8');
+  const matches = [...config.matchAll(/['"`](resources\/(?:js|css)\/[^'"`\s]+)['"`]/g)].map((m) => m[1]);
+  const entries = [...new Set(matches)];
+
+  if (entries.length === 0) {
+    fail('vite.config.js declares no resources/js or resources/css entry points.');
+  }
+
+  for (const entry of entries) {
+    const sourcePath = resolve(root, entry);
+
+    if (!existsSync(sourcePath)) {
+      fail(`vite entry "${entry}" does not exist on disk.`);
+      continue;
+    }
+
+    if (statSync(sourcePath).size === 0) {
+      fail(`vite entry "${entry}" is an empty file.`);
+    }
+
+    if (existsSync(manifestPath)) {
+      try {
+        const manifest = JSON.parse(readFileSync(manifestPath, 'utf8'));
+
+        if (!manifest[entry]) {
+          fail(`vite entry "${entry}" was not built into the manifest.`);
+        }
+      } catch {
+        // Already reported above.
+      }
+    }
+  }
+
+  notes.push(`${entries.length} declared entry points checked`);
+}
+
+if (asJson) {
+  process.stdout.write(`${JSON.stringify({ ok: errors.length === 0, errors, notes }, null, 2)}\n`);
+} else {
+  for (const note of notes) {
+    process.stdout.write(`  ok  ${note}\n`);
+  }
+
+  for (const error of errors) {
+    process.stdout.write(`::error::${error}\n`);
+  }
+}
+
+process.exit(errors.length === 0 ? 0 : 1);
diff --git a/scripts/ci/scan-secrets.sh b/scripts/ci/scan-secrets.sh
new file mode 100755
index 0000000..6ffae1a
--- /dev/null
+++ b/scripts/ci/scan-secrets.sh
@@ -0,0 +1,179 @@
+#!/usr/bin/env bash
+# =============================================================================
+# scan-secrets.sh — repository-scoped secret scanning with an explicit allowlist.
+#
+# WHY NOT JUST `grep` FOR "PRIVATE KEY"
+# -------------------------------------
+# The base commit's security workflow did exactly that, over the whole tree,
+# and then grepped for two vendor-specific key prefixes. It has two failure
+# modes that matter:
+#
+#   * it cannot distinguish documentation from a live credential, so the first
+#     real key it finds is as likely to be in a test fixture as in code — and a
+#     scanner that cries wolf gets muted;
+#   * it only knows two vendors.
+#
+# This scanner is deliberately narrow and boring: it looks for high-signal
+# credential shapes plus a small set of *this application's* secret variable
+# names assigned a non-placeholder value. Findings must be explained in
+# .github/secret-scan-allowlist.txt with a reason, so an exception is a
+# reviewed line in a diff rather than a muted rule.
+#
+# USAGE
+#   scripts/ci/scan-secrets.sh              # scan tracked files
+#   scripts/ci/scan-secrets.sh --all-files  # scan the working tree too
+#
+# EXIT CODES: 0 clean · 1 findings
+# =============================================================================
+set -Eeuo pipefail
+IFS=$'\n\t'
+
+ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd -- "${ROOT}"
+
+ALLOWLIST=".github/secret-scan-allowlist.txt"
+FINDINGS=0
+SCAN_ALL=0
+
+[[ "${1:-}" == "--all-files" ]] && SCAN_ALL=1
+
+# Files that legitimately contain credential-shaped example text. The .env
+# templates are checked separately below with a stricter, key-aware rule that
+# requires a PLACEHOLDER value.
+EXCLUDES=(
+    ':!.git'
+    ':!vendor'
+    ':!node_modules'
+    ':!storage'
+    ':!public/build'
+    ':!artifacts'
+    ':!evidence'
+    ':!*.lock'
+    ':!package-lock.json'
+)
+
+# Credential shapes with very few false positives.
+declare -A PATTERNS=(
+    [private_key_block]='-----BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----'
+    [aws_access_key]='AKIA[0-9A-Z]{16}'
+    [github_token]='gh[pousr]_[A-Za-z0-9]{36,}'
+    [stripe_live_key]='sk_live_[0-9a-zA-Z]{24,}'
+    [slack_token]='xox[baprs]-[0-9A-Za-z-]{10,}'
+    [google_api_key]='AIza[0-9A-Za-z\-_]{35}'
+    [jwt_like]='eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'
+)
+
+# Values that are obviously placeholders, mock fixtures, or references to
+# another variable — none of which are credentials.
+#   * `\$\{VAR:?msg\}` / `\$VAR` are interpolations: the value lives in the
+#     environment, not in the file.
+#   * `mock_*`, `test_*`, `sk_test_*`, `whsec_mock_*` are fixtures that the
+#     payment tests need in order to exercise signature verification.
+#   * policy keys (AUTH_PASSWORD_MIN_LENGTH) are numbers, not secrets; the key
+#     filter below excludes them by name.
+PLACEHOLDER='^(|null|NULL|false|true|0|[0-9]+|changeme|change-me|<[^>]*>|x+|\.\.\.|TODO|placeholder|your[-_].*|.*example.*|.*placeholder.*|.*your-.*|mock.*|test[-_].*|dummy.*|fake.*|sk_test_.*|pk_test_.*|whsec_mock.*|\$\{.*|\$[A-Za-z_]+|%.*%|\*+)$'
+
+# Keys that contain a credential word but are configuration ABOUT credentials.
+NON_SECRET_KEY='(LENGTH|MIN|MAX|EXPIRY|RESET|DAYS|TTL|ENABLED|DISABLED|POLICY|NAME|TYPE|HEADER|PREFIX|SUFFIX|URL|PATH|DRIVER|DAYS|ALGORITHM|PROVIDER|MODE|REQUIRE)'
+
+report() {
+    local rule="$1" file="$2" line="$3" excerpt="$4"
+
+    if [[ -f "${ALLOWLIST}" ]] && grep -qF "${file}:${line}" "${ALLOWLIST}" 2>/dev/null; then
+        printf '  allowed  %s:%s (%s)\n' "${file}" "${line}" "${rule}"
+        return
+    fi
+
+    printf '::error file=%s,line=%s::%s matched %s\n' "${file}" "${line}" "${rule}" "${excerpt}"
+    FINDINGS=$((FINDINGS + 1))
+}
+
+echo "--- credential shapes ---"
+
+for rule in "${!PATTERNS[@]}"; do
+    pattern="${PATTERNS[${rule}]}"
+
+    # -I skips binaries; grep -n gives the line for the annotation.
+    while IFS=: read -r file line _rest; do
+        [[ -z "${file}" ]] && continue
+        report "${rule}" "${file}" "${line}" "${rule}"
+    done < <(git grep -nIE -- "${pattern}" -- . "${EXCLUDES[@]}" 2>/dev/null || true)
+done
+
+echo "--- application secret variables with a real-looking value ---"
+
+# A named secret assigned something that is not a placeholder. This is the rule
+# that catches the failure mode that actually happened in this repository: a
+# backup encryption key hardcoded as a fallback default in PHP.
+SECRET_ASSIGNMENT='(BACKUP_ENCRYPTION_KEY|APP_KEY|DB_PASSWORD|REDIS_PASSWORD|MAIL_PASSWORD|JWT_SECRET|HMAC_SECRET|WEBHOOK_SECRET|API_SECRET|SETTLEMENT_WORKER_HMAC_SECRET)[[:space:]]*[:=][[:space:]]*["'"'"']([^"'"'"']{8,})["'"'"']'
+
+while IFS=: read -r file line _rest; do
+    [[ -z "${file}" ]] && continue
+
+    value="$(printf '%s' "${_rest}" | sed -E "s/.*[:=][[:space:]]*[\"']([^\"']+)[\"'].*/\1/")"
+
+    if [[ "${value}" =~ ${PLACEHOLDER} ]]; then
+        continue
+    fi
+
+    # Interpolations and command substitutions are computed at run time, not
+    # committed values: `APP_KEY=base64:$(openssl rand -base64 32)` in a CI
+    # smoke test generates a throwaway key per container.
+    if [[ "${value}" == *'${'* || "${value}" == '$'* || "${value}" == *'$('* ]]; then
+        continue
+    fi
+
+    # env('X', 'literal-fallback') is a finding: a committed fallback secret
+    # makes every deployment that forgets the variable decryptable by anyone
+    # who can read the repository.
+    if [[ "${_rest}" == *"env("* ]]; then
+        report "hardcoded_secret_fallback" "${file}" "${line}" "env() fallback for a secret"
+        continue
+    fi
+
+    report "hardcoded_secret_value" "${file}" "${line}" "secret variable assigned a literal"
+done < <(git grep -nIE -- "${SECRET_ASSIGNMENT}" -- '*.php' '*.js' '*.mjs' '*.sh' '*.yml' '*.yaml' '*.json' ':!.github/secret-scan-allowlist.txt' 2>/dev/null || true)
+
+echo "--- env templates must not carry secrets ---"
+
+for template in .env.example .env.production.example .env.ci; do
+    [[ -f "${template}" ]] || continue
+
+    # Only keys whose name ends in a credential word, and only when the right
+    # hand side is non-empty and not a placeholder.
+    while IFS= read -r line; do
+        [[ "${line}" =~ ^# ]] && continue
+        key="${line%%=*}"
+        value="${line#*=}"
+        value="${value%\"}"; value="${value#\"}"
+
+        [[ "${key}" =~ ${NON_SECRET_KEY} ]] && continue
+        [[ "${value}" =~ ${PLACEHOLDER} ]] && continue
+
+        printf '::error file=%s::%s carries a value for %s; templates must contain placeholders only\n' \
+            "${template}" "${template}" "${key}"
+        FINDINGS=$((FINDINGS + 1))
+    done < <(grep -E '^[A-Z0-9_]*(SECRET|PASSWORD|PRIVATE_KEY|APP_KEY|API_KEY|TOKEN)[A-Z0-9_]*=' "${template}" 2>/dev/null || true)
+done
+
+echo "--- committed .env files ---"
+
+while IFS= read -r tracked_env; do
+    [[ -z "${tracked_env}" ]] && continue
+
+    # Only the key list is committed; a real .env must never be.
+    case "$(basename "${tracked_env}")" in
+        .env.example|.env.production.example|.env.ci) continue ;;
+    esac
+
+    printf '::error file=%s::%s is committed; .env files must never be tracked\n' "${tracked_env}" "${tracked_env}"
+    FINDINGS=$((FINDINGS + 1))
+done < <(git ls-files | grep -E '(^|/)\.env($|\.)' | grep -vE '\.(example|ci)$' || true)
+
+echo
+if [[ "${FINDINGS}" -gt 0 ]]; then
+    echo "${FINDINGS} secret-scan finding(s). Fix them, or document a false positive in ${ALLOWLIST}."
+    exit 1
+fi
+
+echo "No committed credentials found."
