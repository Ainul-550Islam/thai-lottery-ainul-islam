@@ -0,0 +1,269 @@
+#!/usr/bin/env bash
+# =============================================================================
+# deploy.sh — the release sequence, in the order that makes rollback possible.
+#
+#   scripts/ops/deploy.sh --preflight-only        # gate only, change nothing
+#   scripts/ops/deploy.sh --dry-run               # print the plan
+#   scripts/ops/deploy.sh --yes                   # actually deploy
+#
+# ORDER, AND WHY EACH STEP IS WHERE IT IS
+#   1. preflight      refuse a misconfigured release before anything is cached
+#                     or migrated (config/ops:preflight)
+#   2. backup         take a verified encrypted backup BEFORE the migration, so
+#                     the "restore to the last good state" option exists for the
+#                     rest of the deploy
+#   3. migration audit  flag pending migrations that drop or rename columns; a
+#                     destructive migration stops the deploy unless it is
+#                     explicitly approved (see docs/ops/OPS-RUNBOOK.md)
+#   4. maintenance    put the app into maintenance mode (--maintenance/--no-maintenance)
+#   5. migrate        php artisan migrate --force
+#   6. cache          config/route/view/event caches, built artifacts verified
+#   7. restart        queue workers (queue:restart + horizon:terminate)
+#   8. smoke          HTTP probes; on failure the deploy fails and prints the
+#                     exact rollback command
+#
+# WHAT THIS SCRIPT WILL NOT DO
+#   It will not roll back the database automatically. A silent auto-restore is
+#   how a bad deploy becomes a data-loss incident: the deploy is recoverable,
+#   the overwritten ledger is not. Rollback guidance is printed instead, and
+#   `scripts/ops/rollback.sh` performs the reversible half.
+#
+# EXIT CODES
+#   0 deployed · 1 failed (deploy stopped; see output) · 2 refused
+# =============================================================================
+set -Eeuo pipefail
+IFS=$'\n\t'
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=lib/common.sh
+. "${SCRIPT_DIR}/lib/common.sh"
+
+YES=0
+DRY_RUN=0
+PREFLIGHT_ONLY=0
+SKIP_BACKUP=0
+SKIP_TESTS=0
+SKIP_SMOKE=0
+MAINTENANCE="auto"
+ALLOW_DESTRUCTIVE=0
+BASE_URL="${SMOKE_BASE_URL:-}"
+
+usage() {
+    cat <<'USAGE'
+Usage: scripts/ops/deploy.sh [options]
+
+  --yes                     Required to make any change (no prompt is more
+                            dangerous than a prompt that defaults to yes)
+  --dry-run                 Print the plan, change nothing
+  --preflight-only          Run the preflight gate and stop
+  --skip-backup             Do not take a backup first (discouraged)
+  --skip-tests              Do not run the PHP test suite
+  --skip-smoke              Do not run the HTTP smoke test
+  --maintenance / --no-maintenance
+                            Force maintenance mode on or off ("auto" enables it
+                            in production only)
+  --allow-destructive       Permit migrations that drop or rename columns
+  --base-url URL            Base URL for the smoke test
+
+Environment:
+  SMOKE_BASE_URL            Default for --base-url
+  CONFIRM=<APP_ENV>         Required in addition to --yes when APP_ENV=production
+USAGE
+}
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --yes)                 YES=1; shift ;;
+        --dry-run)             DRY_RUN=1; shift ;;
+        --preflight-only)      PREFLIGHT_ONLY=1; shift ;;
+        --skip-backup)         SKIP_BACKUP=1; shift ;;
+        --skip-tests)          SKIP_TESTS=1; shift ;;
+        --skip-smoke)          SKIP_SMOKE=1; shift ;;
+        --maintenance)         MAINTENANCE="on"; shift ;;
+        --no-maintenance)      MAINTENANCE="off"; shift ;;
+        --allow-destructive)   ALLOW_DESTRUCTIVE=1; shift ;;
+        --base-url)            BASE_URL="${2:?}"; shift 2 ;;
+        -h|--help)             usage; exit 0 ;;
+        *)                     die "Unknown option: $1" ;;
+    esac
+done
+
+ROOT="$(repo_root "${SCRIPT_DIR}")"
+require_repo_root "${ROOT}" >/dev/null
+require_php
+require_command git
+
+APP_ENV_VALUE="$(app_env "${ROOT}")"
+IS_PRODUCTION=0
+is_production "${APP_ENV_VALUE}" && IS_PRODUCTION=1
+
+if [[ "${MAINTENANCE}" == "auto" ]]; then
+    [[ "${IS_PRODUCTION}" -eq 1 ]] && MAINTENANCE="on" || MAINTENANCE="off"
+fi
+
+# A dirty working tree means the release is not what the branch says it is.
+if git -C "${ROOT}" rev-parse --git-dir >/dev/null 2>&1; then
+    if [[ -n "$(git -C "${ROOT}" status --porcelain --untracked-files=no)" ]]; then
+        warn "The working tree has uncommitted changes; the deploy will build something that is not a commit."
+    fi
+    info "Release commit: $(git -C "${ROOT}" rev-parse --short HEAD)"
+fi
+
+info "Environment: $(redact "${APP_ENV_VALUE}") maintenance=${MAINTENANCE}"
+
+# ---------------------------------------------------------------------------
+# 0. Consent
+# ---------------------------------------------------------------------------
+if [[ "${DRY_RUN}" -eq 0 && "${PREFLIGHT_ONLY}" -eq 0 ]]; then
+    if [[ "${YES}" -eq 0 ]]; then
+        die "Refusing to deploy without --yes. A deploy script that proceeds because it was invoked is a script that runs after a typo."
+    fi
+
+    if [[ "${IS_PRODUCTION}" -eq 1 ]]; then
+        require_confirmation "${APP_ENV_VALUE}" \
+            "This is a PRODUCTION deploy of $(git -C "${ROOT}" rev-parse --short HEAD) into ${APP_ENV_VALUE}."
+    fi
+fi
+
+if [[ "${DRY_RUN}" -eq 1 ]]; then
+    cat <<PLAN
+Plan (dry run — nothing will be changed):
+  1. php artisan ops:preflight --json
+  2. $( [[ "${SKIP_BACKUP}" -eq 1 ]] && echo "SKIPPED backup" || echo "php artisan backup:execute-encrypted-worm + backup:verify" )
+  3. php scripts/ops/migration-audit.php (destructive-change gate)
+  4. $( [[ "${MAINTENANCE}" == "on" ]] && echo "php artisan down" || echo "no maintenance mode" )
+  5. php artisan migrate --force
+  6. php artisan config:cache / route:cache / view:cache / event:cache
+  7. php artisan queue:restart (+ horizon:terminate when Horizon is installed)
+  8. scripts/ops/smoke-test.sh
+  9. php artisan up (when maintenance mode was enabled)
+On failure: scripts/ops/rollback.sh (application) — the database is NOT rolled back
+automatically; see docs/ops/OPS-RUNBOOK.md.
+PLAN
+    exit 0
+fi
+
+# ---------------------------------------------------------------------------
+# 1. Preflight
+# ---------------------------------------------------------------------------
+info "1/9 Deployment preflight"
+if ! artisan "${ROOT}" ops:preflight --json > /tmp/tl-deploy-preflight.$$.json; then
+    cat /tmp/tl-deploy-preflight.$$.json >&2 || true
+    rm -f /tmp/tl-deploy-preflight.$$.json
+    die "Preflight failed. Nothing has been changed."
+fi
+rm -f /tmp/tl-deploy-preflight.$$.json
+ok "Preflight passed"
+
+if [[ "${PREFLIGHT_ONLY}" -eq 1 ]]; then
+    ok "Preflight-only run complete."
+    exit 0
+fi
+
+# ---------------------------------------------------------------------------
+# 2. Backup
+# ---------------------------------------------------------------------------
+if [[ "${SKIP_BACKUP}" -eq 1 ]]; then
+    warn "Skipping the pre-deploy backup (--skip-backup). The restore option for this deploy does not exist."
+else
+    info "2/9 Encrypted backup before migration"
+    "${SCRIPT_DIR}/backup.sh" --json > /tmp/tl-deploy-backup.$$.json \
+        || die "The pre-deploy backup failed. Deploying without a recoverable backup is the one risk this script will not take."
+    ok "Backup verified: $(php -r '$d=json_decode((string)file_get_contents($argv[1]),true); echo $d["archive"] ?? "unknown";' /tmp/tl-deploy-backup.$$.json)"
+    rm -f /tmp/tl-deploy-backup.$$.json
+fi
+
+# ---------------------------------------------------------------------------
+# 3. Migration audit
+# ---------------------------------------------------------------------------
+info "3/9 Migration safety audit"
+AUDIT_ARGS=(--json)
+[[ "${ALLOW_DESTRUCTIVE}" -eq 1 ]] && AUDIT_ARGS+=(--allow-destructive)
+
+if ! php "${SCRIPT_DIR}/migration-audit.php" "${AUDIT_ARGS[@]}" > /tmp/tl-deploy-audit.$$.json; then
+    cat /tmp/tl-deploy-audit.$$.json >&2 || true
+    rm -f /tmp/tl-deploy-audit.$$.json
+    die "Pending migrations contain destructive operations. Review them, then re-run with --allow-destructive if that is intended."
+fi
+rm -f /tmp/tl-deploy-audit.$$.json
+ok "Migration audit passed"
+
+# ---------------------------------------------------------------------------
+# 4. Tests (optional but on by default)
+# ---------------------------------------------------------------------------
+if [[ "${SKIP_TESTS}" -eq 0 ]]; then
+    info "4/9 PHP test suite"
+    ( cd -- "${ROOT}" && php artisan test ) || die "The test suite failed. A release that does not pass its own suite is not a release."
+    ok "Test suite passed"
+else
+    warn "Skipping the test suite (--skip-tests)."
+fi
+
+# ---------------------------------------------------------------------------
+# 5. Maintenance mode
+# ---------------------------------------------------------------------------
+if [[ "${MAINTENANCE}" == "on" ]]; then
+    info "5/9 Enabling maintenance mode"
+    artisan "${ROOT}" down --retry=30 --refresh=15 >/dev/null
+    ok "Maintenance mode on (503 with Retry-After; queued jobs keep running)"
+else
+    info "5/9 Continuing without maintenance mode"
+fi
+
+# ---------------------------------------------------------------------------
+# 6. Migrate + cache
+# ---------------------------------------------------------------------------
+info "6/9 Migrating and warming caches"
+artisan "${ROOT}" migrate --force || {
+    [[ "${MAINTENANCE}" == "on" ]] && artisan "${ROOT}" up >/dev/null 2>&1 || true
+    die "Migration failed. The application is left in maintenance mode; follow docs/ops/OPS-RUNBOOK.md before retrying."
+}
+
+artisan "${ROOT}" config:cache >/dev/null
+artisan "${ROOT}" route:cache >/dev/null
+artisan "${ROOT}" view:cache >/dev/null
+artisan "${ROOT}" event:cache >/dev/null
+ok "Caches warmed"
+
+# ---------------------------------------------------------------------------
+# 7. Restart workers
+# ---------------------------------------------------------------------------
+info "7/9 Restarting queue workers"
+artisan "${ROOT}" queue:restart >/dev/null || warn "queue:restart failed; workers may still hold the old code."
+
+if artisan "${ROOT}" list --raw 2>/dev/null | awk '{print $1}' | grep -qx 'horizon:terminate'; then
+    artisan "${ROOT}" horizon:terminate >/dev/null || warn "horizon:terminate failed."
+    ok "Horizon termination signalled; supervisors will respawn with the new code"
+else
+    ok "queue:restart signalled"
+fi
+
+# ---------------------------------------------------------------------------
+# 8. Smoke test
+# ---------------------------------------------------------------------------
+if [[ "${SKIP_SMOKE}" -eq 0 ]]; then
+    info "8/9 HTTP smoke test"
+    SMOKE_ARGS=()
+    [[ -n "${BASE_URL}" ]] && SMOKE_ARGS+=(--base-url "${BASE_URL}")
+
+    if ! "${SCRIPT_DIR}/smoke-test.sh" "${SMOKE_ARGS[@]}"; then
+        die "Smoke test failed after deployment. Run scripts/ops/rollback.sh to return to the previous release; the database is not rolled back automatically."
+    fi
+    ok "Smoke test passed"
+else
+    warn "Skipping the smoke test (--skip-smoke)."
+fi
+
+# ---------------------------------------------------------------------------
+# 9. Back out of maintenance mode
+# ---------------------------------------------------------------------------
+if [[ "${MAINTENANCE}" == "on" ]]; then
+    info "9/9 Disabling maintenance mode"
+    artisan "${ROOT}" up >/dev/null
+    ok "Application is serving traffic again"
+else
+    info "9/9 Nothing to bring back up"
+fi
+
+ok "Deploy complete: $(git -C "${ROOT}" rev-parse --short HEAD 2>/dev/null || echo unknown)"
+exit 0
diff --git a/scripts/ops/healthcheck.sh b/scripts/ops/healthcheck.sh
new file mode 100755
index 0000000..bea193f
--- /dev/null
+++ b/scripts/ops/healthcheck.sh
@@ -0,0 +1,89 @@
+#!/usr/bin/env bash
+# =============================================================================
+# healthcheck.sh — one command an external monitor, cron or on-call can run.
+#
+#   scripts/ops/healthcheck.sh                 # human-readable summary
+#   scripts/ops/healthcheck.sh --json          # machine-readable
+#   scripts/ops/healthcheck.sh --http URL      # also probe a live endpoint
+#
+# It wraps `php artisan ops:health`, which already answers: are the database,
+# cache, queue and Redis reachable; is the scheduler still ticking; is the
+# newest verified backup fresh; is the disk filling up; are failed jobs piling
+# up. The exit code is the alerting signal:
+#
+#   0 OK · 1 DEGRADED · 2 CRITICAL
+#
+# WHY THE EXIT CODE MATTERS MORE THAN THE TEXT
+#   Every monitoring system that exists can alert on a non-zero exit code, and
+#   almost none of them reliably parse a human summary. Keeping the mapping in
+#   one place means the runbook, the cron entry and the alert all agree.
+# =============================================================================
+set -Eeuo pipefail
+IFS=$'\n\t'
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=lib/common.sh
+. "${SCRIPT_DIR}/lib/common.sh"
+
+JSON=0
+HTTP_URL=""
+
+usage() {
+    cat <<'USAGE'
+Usage: scripts/ops/healthcheck.sh [options]
+
+  --json        Machine-readable output
+  --http URL    Also require this URL's /up/ready to answer 200
+  -h, --help    This text
+
+Exit codes: 0 OK, 1 DEGRADED, 2 CRITICAL
+USAGE
+}
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --json)    JSON=1; shift ;;
+        --http)    HTTP_URL="${2:?}"; shift 2 ;;
+        -h|--help) usage; exit 0 ;;
+        *)         die "Unknown option: $1" ;;
+    esac
+done
+
+ROOT="$(repo_root "${SCRIPT_DIR}")"
+require_repo_root "${ROOT}" >/dev/null
+require_php
+
+ARGS=(--json)
+[[ "${JSON}" -eq 1 ]] || ARGS=()
+
+set +e
+OUTPUT="$(artisan "${ROOT}" ops:health "${ARGS[@]}" 2>&1)"
+STATUS_CODE=$?
+set -e
+
+if [[ "${JSON}" -eq 1 ]]; then
+    printf '%s\n' "${OUTPUT}"
+else
+    printf '%s\n' "${OUTPUT}"
+fi
+
+# Optional HTTP layer: an application that is "healthy" internally but not
+# answering HTTP is not healthy. This is checked after the internal probes so a
+# hung web tier does not hide a database outage.
+if [[ -n "${HTTP_URL}" ]]; then
+    require_command curl
+    code="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 10 "${HTTP_URL%/}/up/ready" || echo 000)"
+
+    if [[ "${code}" == "200" ]]; then
+        ok "/up/ready -> 200"
+    else
+        warn "/up/ready -> ${code}"
+        [[ "${STATUS_CODE}" -lt 2 ]] && STATUS_CODE=2
+    fi
+fi
+
+case "${STATUS_CODE}" in
+    0) exit 0 ;;
+    1) exit 1 ;;
+    *) exit 2 ;;
+esac
diff --git a/scripts/ops/lib/common.sh b/scripts/ops/lib/common.sh
new file mode 100755
index 0000000..ec9fad0
--- /dev/null
+++ b/scripts/ops/lib/common.sh
@@ -0,0 +1,192 @@
+#!/usr/bin/env bash
+# =============================================================================
+# Shared helpers for the platform operations scripts.
+#
+# SOURCED, NEVER EXECUTED. Every script under scripts/ops/ starts with:
+#
+#   set -Eeuo pipefail
+#   SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+#   # shellcheck source=lib/common.sh
+#   . "${SCRIPT_DIR}/lib/common.sh"
+#
+# WHAT THIS FILE GUARANTEES
+#   1. A secret is never printed, logged, or passed on a command line.
+#      `redact` exists so a caller that must show an error can do it safely.
+#   2. A failure stops the script. `set -e` alone is not enough once anything
+#      runs inside `if` or a pipeline, so `die` is explicit and the trap
+#      reports the exact line.
+#   3. Running the same script twice is not destructive by accident: anything
+#      that writes requires an explicit flag or a confirmation environment
+#      variable, never just "the operator ran it".
+#
+# DELIBERATELY NOT HERE
+#   No secret loading into the environment beyond what Laravel already does,
+#   no `eval`, no nested string command construction. Table and database names
+#   come from operator input; they are validated, then passed as argv
+#   elements.
+# =============================================================================
+
+# ---------------------------------------------------------------------------
+# Output
+# ---------------------------------------------------------------------------
+if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
+    C_RESET=$'\033[0m'; C_RED=$'\033[31m'; C_GREEN=$'\033[32m'
+    C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'; C_DIM=$'\033[2m'
+else
+    C_RESET=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_DIM=""
+fi
+
+log()   { printf '%s[%s]%s %s\n' "${C_DIM}" "$(date -u +%H:%M:%SZ)" "${C_RESET}" "$*"; }
+info()  { printf '%s==>%s %s\n' "${C_BLUE}" "${C_RESET}" "$*"; }
+ok()    { printf '%s ok %s %s\n' "${C_GREEN}" "${C_RESET}" "$*"; }
+warn()  { printf '%sWARN%s %s\n' "${C_YELLOW}" "${C_RESET}" "$*" >&2; }
+die()   { printf '%sFAIL%s %s\n' "${C_RED}" "${C_RESET}" "$*" >&2; exit 1; }
+# A refusal is not a failure: nothing was attempted, nothing is broken.
+# Keeping the codes distinct lets a scheduler alert on 1 (real breakage) without
+# paging for 2 (a guard doing its job).
+refuse() { printf '%sREFUSED%s %s\n' "${C_YELLOW}" "${C_RESET}" "$*" >&2; exit 2; }
+
+# Anything that might echo a value from the environment goes through this.
+# It deliberately keeps the *shape* of a value ("<set, 48 chars>") and drops
+# the value, because the shape is what an operator actually needs to debug.
+redact() {
+    local value="${1:-}"
+    if [[ -z "${value}" ]]; then
+        printf '(unset)'
+    else
+        printf '(set, %d chars)' "${#value}"
+    fi
+}
+
+# ---------------------------------------------------------------------------
+# Failure reporting
+# ---------------------------------------------------------------------------
+_on_error() {
+    local exit_code=$? line=${1:-?} command=${2:-?}
+    printf '%sFAIL%s %s:%s exited %d while running: %s\n' \
+        "${C_RED}" "${C_RESET}" "$(basename "${BASH_SOURCE[1]:-$0}")" "${line}" "${exit_code}" "${command}" >&2
+    exit "${exit_code}"
+}
+trap '_on_error "${LINENO}" "${BASH_COMMAND}"' ERR
+
+# ---------------------------------------------------------------------------
+# Preconditions
+# ---------------------------------------------------------------------------
+require_command() {
+    local command_name
+    for command_name in "$@"; do
+        command -v "${command_name}" >/dev/null 2>&1 \
+            || die "Required command not found on PATH: ${command_name}"
+    done
+}
+
+# Resolve the repository root from the script location, not from $PWD, so the
+# scripts behave the same from cron, from CI and from a developer shell.
+repo_root() {
+    local script_dir="${1:?repo_root needs the calling script directory}"
+    ( cd -- "${script_dir}/../.." && pwd )
+}
+
+require_repo_root() {
+    local root="${1:?}"
+    [[ -f "${root}/artisan" ]] || die "This does not look like the application root (no artisan): ${root}"
+    [[ -f "${root}/composer.json" ]] || die "This does not look like the application root (no composer.json): ${root}"
+    printf '%s' "${root}"
+}
+
+# Wrapper around artisan that always runs from the repository root and never
+# needs a shell string.
+artisan() {
+    local root="${1:?}"
+    shift
+    ( cd -- "${root}" && php artisan "$@" )
+}
+
+# ---------------------------------------------------------------------------
+# Environment inspection WITHOUT printing values
+# ---------------------------------------------------------------------------
+# Reads APP_ENV from .env without exporting anything. Used to decide whether a
+# command is safe to run, never to display.
+app_env() {
+    local root="${1:?}"
+    if [[ -n "${APP_ENV:-}" ]]; then
+        printf '%s' "${APP_ENV}"
+        return
+    fi
+    if [[ -f "${root}/.env" ]]; then
+        # -m1 and no export: this is a read, not a load.
+        sed -n 's/^APP_ENV=[[:space:]]*//p' "${root}/.env" | head -n1 | tr -d '"'\'''
+        return
+    fi
+    printf 'production'
+}
+
+# config_value <dotted.key> <default>
+#   Resolve a configuration value the way the scripts need it: from the
+#   environment first, then the caller's default. It deliberately does NOT boot
+#   Laravel — these scripts run during recovery, which is exactly when the
+#   application may not be able to start. `backup.path` therefore reads
+#   BACKUP_PATH, `backup.staging_path` reads BACKUP_STAGING_PATH, and so on.
+config_value() {
+    local key="${1:?config key required}"
+    local fallback="${2:-}"
+    local envname="${key^^}"
+    envname="${envname//./_}"
+
+    local value="${!envname:-}"
+
+    if [[ -n "${value}" ]]; then
+        printf '%s' "${value}"
+        return 0
+    fi
+
+    printf '%s' "${fallback}"
+}
+
+is_production() {
+    [[ "${1:-}" == "production" || "${1:-}" == "prod" ]]
+}
+
+# ---------------------------------------------------------------------------
+# Confirmations
+# ---------------------------------------------------------------------------
+# The confirmation is an environment variable containing the exact name of the
+# thing being changed. A bare `--yes` is too easy to leave in a shell history
+# and too easy to add to a Makefile; naming the target forces the operator to
+# read what they are about to overwrite.
+require_confirmation() {
+    local expected="${1:?}"
+    local prompt="${2:-This is destructive.}"
+
+    if [[ "${CONFIRM:-}" == "${expected}" ]]; then
+        return 0
+    fi
+
+    printf '%s\n' "${prompt}" >&2
+    printf 'Re-run with: CONFIRM=%s %s\n' "${expected}" "$(basename "$0")" >&2
+    exit 2
+}
+
+# ---------------------------------------------------------------------------
+# Misc
+# ---------------------------------------------------------------------------
+# Free-form argv validation for identifiers that reach a database client.
+# Rejects anything that is not [A-Za-z0-9_]; a database name is not a place for
+# creativity, and every client here accepts `--database=$(...)` style input.
+assert_identifier() {
+    local value="${1:?}" label="${2:-identifier}"
+    [[ "${value}" =~ ^[A-Za-z0-9_]+$ ]] \
+        || die "${label} must match [A-Za-z0-9_]+, refused: $(printf '%s' "${value}" | tr -cd '[:alnum:]_')"
+}
+
+# A single place for "is php available and does it have the extension we need".
+require_php() {
+    require_command php
+    php -r 'exit(PHP_VERSION_ID >= 80400 ? 0 : 1);' \
+        || die "PHP 8.4 or newer is required by this application (composer.json requires ^8.4)."
+}
+
+print_help_header() {
+    printf '%s\n' "$1"
+    printf '%s\n' "${C_DIM}$(printf '%.0s-' $(seq 1 ${#1}))${C_RESET}"
+}
diff --git a/scripts/ops/migration-audit.php b/scripts/ops/migration-audit.php
new file mode 100755
index 0000000..b837209
--- /dev/null
+++ b/scripts/ops/migration-audit.php
@@ -0,0 +1,248 @@
+<?php
+
+declare(strict_types=1);
+
+/**
+ * Migration safety audit — runs BEFORE `php artisan migrate --force`.
+ *
+ * WHY
+ * ---
+ * A lottery ledger migration is not a schema change like any other. `DROP
+ * COLUMN balance_after`, `RENAME COLUMN` or `DROP TABLE bets` are perfectly
+ * ordinary to write and cannot be undone by redeploying the previous commit:
+ * the code comes back, the data does not. Production migrations are routinely
+ * run by a deploy script with nobody reading them.
+ *
+ * This script reads the migration FILES that are pending on this database and
+ * reports the destructive statements it finds, so that decision is made
+ * deliberately (`--allow-destructive`) instead of implicitly by a deploy.
+ *
+ * WHAT IT IS NOT
+ * --------------
+ * It is not a schema differ and it does not predict data loss with certainty:
+ * `dropColumn` on a column that is empty loses nothing, and a `delete()` in a
+ * data migration can lose everything without matching any pattern here. It is
+ * a speed bump for the obvious cases, and it errs toward naming the file so a
+ * human can read it.
+ *
+ * USAGE
+ *   php scripts/ops/migration-audit.php [--json] [--allow-destructive]
+ *
+ * EXIT CODES
+ *   0 nothing destructive pending (or --allow-destructive)
+ *   1 destructive operations pending
+ *   2 refused / could not determine state
+ */
+
+use Illuminate\Contracts\Console\Kernel;
+use Illuminate\Database\Migrations\Migrator;
+use Illuminate\Foundation\Application;
+
+$root = dirname(__DIR__, 2);
+
+$json = in_array('--json', $argv, true);
+$allowDestructive = in_array('--allow-destructive', $argv, true);
+
+/**
+ * Statement patterns that can destroy data. Ordered by how bad they are, so
+ * the report reads worst-first.
+ *
+ * @var array<string, string>
+ */
+$patterns = [
+    'dropTable' => '/->\s*dropTable\s*\(/i',
+    'dropColumn' => '/->\s*dropColumn\s*\(/i',
+    'dropIfExists' => '/->\s*dropIfExists\s*\(/i',
+    'renameColumn' => '/->\s*renameColumn\s*\(/i',
+    'renameTable' => '/->\s*rename\s*\(/i',
+    'truncate' => '/->\s*truncate\s*\(/i',
+    // A raw ALTER is not automatically destructive: `ALTER TABLE ... ADD
+    // CONSTRAINT` is routine. The statement's own verb decides.
+    'rawDropOrDelete' => '/DB::(?:statement|unprepared)\s*\(\s*[\'"][^\'"]*?\b(?:drop|truncate|delete)\b/i',
+    'dataDelete' => '/DB::table\([^)]*\)->\s*delete\s*\(/i',
+    'rawAlter' => '/->\s*(?:dropPrimary|dropUnique|dropIndex|dropForeign|dropMorphs)\s*\(/i',
+];
+
+try {
+    require $root.'/vendor/autoload.php';
+
+    /** @var Application $app */
+    $app = require $root.'/bootstrap/app.php';
+    $app->make(Kernel::class)->bootstrap();
+} catch (Throwable $error) {
+    $message = 'Unable to bootstrap the application to read migration state: '.$error->getMessage();
+
+    $json
+        ? print (json_encode(['status' => 'REFUSED', 'reason' => $message], JSON_PRETTY_PRINT).PHP_EOL)
+        : fwrite(STDERR, $message.PHP_EOL);
+
+    exit(2);
+}
+
+try {
+    /** @var Migrator $migrator */
+    $migrator = $app->make('migrator');
+
+    if (! $migrator->repositoryExists()) {
+        // A brand new database has no migrations table; every migration is
+        // pending and none of them can be destructive to data that does not
+        // exist yet.
+        $output = ['status' => 'OK', 'pending' => 0, 'destructive' => [], 'note' => 'No migrations table; fresh database.'];
+
+        $json
+            ? print (json_encode($output, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES).PHP_EOL)
+            : print 'No migrations table yet: a fresh database has nothing to destroy.'.PHP_EOL;
+
+        exit(0);
+    }
+
+    // `Migrator::pendingMigrations()` is protected, so the same computation is
+    // done explicitly: every migration file that is not in the `ran` list.
+    // Doing it here also means a migration whose name merely *looks* applied is
+    // reported, instead of silently skipped by the framework's own filter.
+    $files = $migrator->getMigrationFiles([database_path('migrations')]);
+    $ran = $migrator->getRepository()->getRan();
+
+    $pending = [];
+
+    foreach ($files as $name => $path) {
+        if (! in_array($name, $ran, true)) {
+            $pending[] = $path;
+        }
+    }
+} catch (Throwable $error) {
+    $message = 'Unable to determine pending migrations: '.$error->getMessage();
+
+    $json
+        ? print (json_encode(['status' => 'REFUSED', 'reason' => $message], JSON_PRETTY_PRINT).PHP_EOL)
+        : fwrite(STDERR, $message.PHP_EOL);
+
+    exit(2);
+}
+
+/**
+ * Return the body of a single method, located by brace matching.
+ *
+ * WHY THIS EXISTS. Migrations routinely DROP things in `down()` — that is what
+ * a rollback is. Scanning the whole file flags every one of them and produces a
+ * report that blocks every deploy, which is the same as having no gate at all.
+ * `migrate` runs `up()` and nothing else, so `up()` is what must be audited.
+ *
+ * Returns null when the method is not found, and the caller falls back to the
+ * whole file and says so: an unreadable migration must fail loudly, never
+ * quietly pass.
+ */
+function methodBody(string $source, string $method): ?string
+{
+    if (preg_match('/function\s+'.preg_quote($method, '/').'\s*\([^)]*\)\s*(?::\s*[\w\\|?]+\s*)?\{/', $source, $match, PREG_OFFSET_CAPTURE) !== 1) {
+        return null;
+    }
+
+    $start = $match[0][1] + strlen($match[0][0]);
+    $depth = 1;
+    $length = strlen($source);
+
+    for ($index = $start; $index < $length; $index++) {
+        $character = $source[$index];
+
+        // Skip over string literals so a brace inside a SQL statement does not
+        // shift the nesting count.
+        if ($character === "'" || $character === '"') {
+            $quote = $character;
+
+            for ($index++; $index < $length; $index++) {
+                if ($source[$index] === '\\') {
+                    $index++;
+
+                    continue;
+                }
+
+                if ($source[$index] === $quote) {
+                    break;
+                }
+            }
+
+            continue;
+        }
+
+        if ($character === '{') {
+            $depth++;
+        } elseif ($character === '}') {
+            $depth--;
+
+            if ($depth === 0) {
+                return substr($source, $start, $index - $start);
+            }
+        }
+    }
+
+    return null;
+}
+
+$findings = [];
+$unscoped = [];
+
+foreach ($pending as $migrationPath) {
+    $source = @file_get_contents($migrationPath);
+
+    if ($source === false) {
+        continue;
+    }
+
+    $body = methodBody($source, 'up');
+
+    if ($body === null) {
+        // No `up()` found. Scan everything and mark the finding as unscoped so a
+        // human knows the report is approximate rather than definitive.
+        $body = $source;
+        $unscoped[] = basename($migrationPath);
+    }
+
+    foreach ($patterns as $label => $pattern) {
+        if (preg_match($pattern, $body) === 1) {
+            $findings[] = [
+                'migration' => basename($migrationPath),
+                'operation' => $label,
+                'scope' => $body === $source ? 'whole-file' : 'up()',
+            ];
+        }
+    }
+}
+
+$status = $findings === [] ? 'OK' : ($allowDestructive ? 'ALLOWED' : 'DESTRUCTIVE_PENDING');
+
+$output = [
+    'status' => $status,
+    'pending_count' => count($pending),
+    'scanned' => 'up() only; down() is a rollback path and is never run by `migrate`',
+    'unscoped_migrations' => $unscoped,
+    'destructive_count' => count($findings),
+    'destructive' => $findings,
+    'remediation' => $findings === []
+        ? null
+        : 'Take a verified backup (scripts/ops/backup.sh), read each migration listed above, then re-run the deploy with --allow-destructive if the loss is intended.',
+];
+
+if ($json) {
+    echo json_encode($output, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES).PHP_EOL;
+} else {
+    printf("Pending migrations: %d\n", $output['pending_count']);
+
+    if ($findings === []) {
+        echo "No destructive operations found in pending migrations.\n";
+    } else {
+        echo "Destructive operations in pending migrations:\n";
+
+        foreach ($findings as $finding) {
+            printf("  - %-64s %s\n", $finding['migration'], $finding['operation']);
+        }
+
+        echo "\n".$output['remediation']."\n";
+    }
+}
+
+if ($findings !== [] && ! $allowDestructive) {
+    exit(1);
+}
+
+exit(0);
diff --git a/scripts/ops/preflight.sh b/scripts/ops/preflight.sh
new file mode 100755
index 0000000..cac9f0e
--- /dev/null
+++ b/scripts/ops/preflight.sh
@@ -0,0 +1,171 @@
+#!/usr/bin/env bash
+# =============================================================================
+# preflight.sh — host-level gate for a release that has not been booted yet.
+#
+#   scripts/ops/preflight.sh                 # config + connectivity
+#   scripts/ops/preflight.sh --offline        # config only (no database probes)
+#   scripts/ops/preflight.sh --json           # for CI
+#
+# RELATIONSHIP TO `php artisan ops:preflight`
+# -------------------------------------------
+# The artisan command is the authority on application configuration and runs
+# inside the framework. This shell wrapper adds the HOST facts the framework
+# cannot see and that break deploys in practice:
+#
+#   * PHP and Node produce the versions composer.json / package.json require
+#     (this repository requires PHP ^8.4 and Node 24 — a host with 8.3 or
+#     Node 20 fails at `composer install` and `npm ci`, after the release has
+#     already been cut);
+#   * the required client binaries exist (mysqldump/pg_dump for backups);
+#   * .env is not world-readable;
+#   * the runtime directories are writable by the user that will serve traffic;
+#   * the build manifest exists, because a release without it serves unstyled
+#     pages.
+#
+# EXIT CODES: 0 ready · 1 not ready · 2 refused
+# =============================================================================
+set -Eeuo pipefail
+IFS=$'\n\t'
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=lib/common.sh
+. "${SCRIPT_DIR}/lib/common.sh"
+
+OFFLINE=0
+JSON=0
+
+usage() {
+    cat <<'USAGE'
+Usage: scripts/ops/preflight.sh [options]
+
+  --offline   Skip database/cache/Redis connectivity probes
+  --json      Machine-readable output
+  -h, --help  This text
+USAGE
+}
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --offline) OFFLINE=1; shift ;;
+        --json)    JSON=1; shift ;;
+        -h|--help) usage; exit 0 ;;
+        *)         die "Unknown option: $1" ;;
+    esac
+done
+
+ROOT="$(repo_root "${SCRIPT_DIR}")"
+require_repo_root "${ROOT}" >/dev/null
+
+FAILURES=0
+
+fail() { warn "$1"; FAILURES=$((FAILURES + 1)); }
+
+# ---------------------------------------------------------------------------
+# Runtime versions
+# ---------------------------------------------------------------------------
+if command -v php >/dev/null 2>&1; then
+    PHP_VERSION="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')"
+    php -r 'exit(PHP_VERSION_ID >= 80400 ? 0 : 1);' \
+        && ok "PHP ${PHP_VERSION} satisfies composer.json (^8.4)" \
+        || fail "PHP ${PHP_VERSION} does not satisfy composer.json (^8.4). Install PHP 8.4 before releasing; the dependency lock file will refuse to install otherwise."
+else
+    fail "php is not on PATH."
+fi
+
+# Node is only needed to BUILD, not to serve. Report it as required only when
+# node_modules is absent, i.e. when this host is expected to build assets.
+if command -v node >/dev/null 2>&1; then
+    NODE_VERSION="$(node -p 'process.versions.node')"
+    NODE_MAJOR="${NODE_VERSION%%.*}"
+
+    if [[ "${NODE_MAJOR}" -eq 24 ]]; then
+        ok "Node ${NODE_VERSION} satisfies package.json (>=24 <25)"
+    else
+        fail "Node ${NODE_VERSION} does not satisfy package.json (>=24 <25); .npmrc sets engine-strict=true, so npm ci will refuse to run."
+    fi
+else
+    warn "node is not on PATH. Fine for a host that only runs the prebuilt artifacts; fatal for a host that builds them."
+fi
+
+# ---------------------------------------------------------------------------
+# Required binaries
+# ---------------------------------------------------------------------------
+for binary in mysqldump mysql; do
+    if command -v "${binary}" >/dev/null 2>&1; then
+        ok "${binary} is available"
+    else
+        fail "${binary} is not on PATH. Backups (scripts/ops/backup.sh) cannot run without the database client."
+    fi
+done
+
+for binary in curl gzip sha256sum; do
+    command -v "${binary}" >/dev/null 2>&1 && ok "${binary} is available" || fail "${binary} is not on PATH."
+done
+
+# ---------------------------------------------------------------------------
+# Filesystem
+# ---------------------------------------------------------------------------
+ENV_PATH="${ROOT}/.env"
+
+if [[ -f "${ENV_PATH}" ]]; then
+    PERMS="$(stat -c '%a' "${ENV_PATH}" 2>/dev/null || echo unknown)"
+
+    if [[ "${PERMS}" =~ ^[0-7]?[0-7][0-4][0-4]$ ]]; then
+        ok ".env mode ${PERMS} is not world-readable"
+    else
+        fail ".env mode ${PERMS} is too permissive. Use 0640."
+    fi
+else
+    warn "No .env file. Expected when the environment is injected by the orchestrator; fatal for a bare-metal host."
+fi
+
+for directory in storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache; do
+    if [[ -d "${ROOT}/${directory}" && -w "${ROOT}/${directory}" ]]; then
+        ok "${directory} is writable"
+    else
+        fail "${directory} is missing or not writable by $(id -un)."
+    fi
+done
+
+if [[ -f "${ROOT}/public/build/manifest.json" ]]; then
+    ok "public/build/manifest.json is present"
+else
+    fail "public/build/manifest.json is missing. Build assets during the release (npm run build), never ad hoc on the host."
+fi
+
+# ---------------------------------------------------------------------------
+# Application configuration (delegated)
+# ---------------------------------------------------------------------------
+ARGS=(--json)
+[[ "${OFFLINE}" -eq 1 ]] && ARGS+=(--offline)
+
+APP_OUTPUT="$(mktemp)"
+trap 'rm -f "${APP_OUTPUT}"' EXIT
+
+if artisan "${ROOT}" ops:preflight "${ARGS[@]}" > "${APP_OUTPUT}"; then
+    ok "Application preflight passed"
+else
+    fail "Application preflight failed:"
+    php -r '
+        $report = json_decode((string) file_get_contents($argv[1]), true) ?: [];
+        foreach ((array) ($report["checks"] ?? []) as $check) {
+            if (($check["status"] ?? "") === "FAIL") {
+                fwrite(STDERR, "    - ".$check["id"].": ".$check["detail"].PHP_EOL);
+            }
+        }
+    ' "${APP_OUTPUT}"
+fi
+
+if [[ "${JSON}" -eq 1 ]]; then
+    printf '{"status":"%s","failures":%d,"application:%s"}\n' \
+        "$([[ "${FAILURES}" -eq 0 ]] && echo PASS || echo FAIL)" \
+        "${FAILURES}" \
+        "$(cat "${APP_OUTPUT}")"
+fi
+
+if [[ "${FAILURES}" -gt 0 ]]; then
+    die "${FAILURES} host preflight check(s) failed."
+fi
+
+ok "Host preflight passed."
+exit 0
