+<?php
+
+declare(strict_types=1);
+
+namespace App\Support\Backup;
+
+use RuntimeException;
+
+/**
+ * Authenticated encryption for database backups.
+ *
+ * WHAT WAS WRONG BEFORE
+ * ---------------------
+ * The lane this class replaces used `openssl_encrypt('aes-256-cbc', ...)` with
+ * a random IV and no authentication tag. Two independent problems:
+ *
+ *   1. CBC without a MAC is malleable. An attacker with write access to the
+ *      backup bucket — precisely the attacker a WORM bucket is meant to
+ *      survive — can flip bits in the ciphertext of a `ledger_transactions`
+ *      INSERT and change an amount without any key. Nothing downstream would
+ *      notice: the archive decrypts cleanly, the restore imports, and the
+ *      reconciliation report then disagrees with the ledger it was restored
+ *      from.
+ *
+ *   2. The key defaulted to a literal string committed to git, so
+ *      "encryption" was a base64 step.
+ *
+ * WHAT THIS DOES INSTEAD
+ * ----------------------
+ *   * Strings use AES-256-GCM with a 96-bit nonce and a 128-bit tag. Decrypt
+ *     fails closed on a tampered payload.
+ *   * Files use AES-256-CTR with per-chunk derived nonces and an
+ *     encrypt-then-MAC HMAC-SHA256 over the header and the whole ciphertext,
+ *     so a gigabyte-scale dump is authenticated without being held in memory.
+ *   * There is no default key. A missing key is a hard error, not a fallback.
+ *
+ * The file format is documented in the class constants below and in
+ * `docs/ops/OPS-RUNBOOK.md` (backup section), because an operator recovering
+ * an archive at 3am needs the format written down somewhere that is not PHP.
+ */
+final class BackupCipher
+{
+    /** String envelope magic. */
+    public const STRING_MAGIC = 'TLBK';
+
+    /** File envelope magic. */
+    public const FILE_MAGIC = 'TLBKFILE';
+
+    /**
+     * Bump when the format changes. Decrypt refuses formats it does not know
+     * rather than guessing, because guessing is how a corrupted archive gets
+     * imported as a valid one.
+     */
+    public const FORMAT_VERSION = 2;
+
+    /** AES-GCM nonce length, bytes. */
+    private const GCM_NONCE_BYTES = 12;
+
+    /** AES-GCM tag length, bytes. */
+    private const GCM_TAG_BYTES = 16;
+
+    /** Per-file salt length, bytes. */
+    private const SALT_BYTES = 16;
+
+    /** Chunk size for file operations, bytes. */
+    private const CHUNK_BYTES = 1048576;
+
+    /** Minimum accepted key length. Production preflight enforces 32. */
+    public const MINIMUM_KEY_LENGTH = 16;
+
+    private string $masterKey;
+
+    /**
+     * @param  string|null  $key  Explicit key (tests, drills). When null the
+     *                            configured key or key file is used.
+     */
+    public function __construct(?string $key = null, private readonly bool $allowLegacyCbcDecrypt = false)
+    {
+        $this->masterKey = self::assertUsableKey($key ?? self::configuredKey() ?? '');
+    }
+
+    /**
+     * Resolve the key from configuration, preferring the file form.
+     *
+     * A `*_FILE` setting wins over the inline variable for the same reason
+     * Docker secrets win: an operator who dumps the process environment should
+     * not get the backup key with it.
+     */
+    public static function configuredKey(): ?string
+    {
+        $file = self::configString('backup.key_file');
+
+        if ($file !== null && $file !== '') {
+            if (! is_file($file) || ! is_readable($file)) {
+                throw new RuntimeException(
+                    'BACKUP_ENCRYPTION_KEY_FILE is set but the file is not readable. Refusing to continue.'
+                );
+            }
+
+            $contents = trim((string) file_get_contents($file));
+
+            if ($contents === '') {
+                throw new RuntimeException('BACKUP_ENCRYPTION_KEY_FILE is empty. Refusing to continue.');
+            }
+
+            return $contents;
+        }
+
+        $inline = self::configString('backup.key');
+
+        return ($inline === null || $inline === '') ? null : $inline;
+    }
+
+    /**
+     * True when a key is configured at all. Used by preflight, which must be
+     * able to report "missing" without throwing.
+     */
+    public static function hasConfiguredKey(): bool
+    {
+        try {
+            $key = self::configuredKey();
+        } catch (RuntimeException) {
+            return false;
+        }
+
+        return $key !== null && strlen($key) >= self::MINIMUM_KEY_LENGTH;
+    }
+
+    /**
+     * Values that must never be accepted as a backup key.
+     *
+     * The first entry is the literal that shipped in this repository. It is
+     * listed so an operator migrating an old deployment gets a clear message
+     * instead of a silent "everything still works", which would be true and
+     * useless.
+     *
+     * @var list<string>
+     */
+    private const FORBIDDEN_KEYS = [
+        'HardenedBackupKey2026MasterSecret!',
+        'changeme',
+        'change-me',
+        'secret',
+        'password',
+        'backup',
+        'test',
+        'example',
+    ];
+
+    private static function assertUsableKey(string $key): string
+    {
+        $trimmed = trim($key);
+
+        if ($trimmed === '') {
+            throw new RuntimeException(
+                'No backup encryption key is configured. Set BACKUP_ENCRYPTION_KEY or '
+                .'BACKUP_ENCRYPTION_KEY_FILE. Backups are never written unencrypted.'
+            );
+        }
+
+        if (strlen($trimmed) < self::MINIMUM_KEY_LENGTH) {
+            throw new RuntimeException(sprintf(
+                'The backup encryption key is too short (%d characters, minimum %d).',
+                strlen($trimmed),
+                self::MINIMUM_KEY_LENGTH,
+            ));
+        }
+
+        $lowercaseKey = strtolower($trimmed);
+        $forbidden = array_map('strtolower', self::FORBIDDEN_KEYS);
+
+        if (in_array($lowercaseKey, $forbidden, true)) {
+            throw new RuntimeException(
+                'The backup encryption key is a known placeholder value. Generate a real secret '
+                .'(for example: openssl rand -base64 48) before taking a backup.'
+            );
+        }
+
+        return $trimmed;
+    }
+
+    private static function configString(string $key): ?string
+    {
+        if (! function_exists('config')) {
+            return null;
+        }
+
+        $value = config($key);
+
+        return is_string($value) ? $value : null;
+    }
+
+    /**
+     * Derive a purpose-bound subkey so the encryption key and the MAC key are
+     * never the same bytes (a classic encrypt-then-MAC mistake).
+     */
+    private function subkey(string $purpose, string $salt): string
+    {
+        return hash_hkdf('sha256', $this->masterKey, 32, 'tl-backup:'.$purpose, $salt);
+    }
+
+    /**
+     * Encrypt a string payload with AES-256-GCM.
+     *
+     * Envelope: MAGIC(4) | VERSION(1) | NONCE(12) | TAG(16) | CIPHERTEXT(n)
+     */
+    public function encryptString(string $plaintext): string
+    {
+        $nonce = random_bytes(self::GCM_NONCE_BYTES);
+        $tag = '';
+
+        $ciphertext = openssl_encrypt(
+            $plaintext,
+            'aes-256-gcm',
+            $this->subkey('gcm', ''),
+            OPENSSL_RAW_DATA,
+            $nonce,
+            $tag,
+            self::STRING_MAGIC,
+            self::GCM_TAG_BYTES,
+        );
+
+        if ($ciphertext === false || strlen($tag) !== self::GCM_TAG_BYTES) {
+            throw new RuntimeException('Backup encryption failed: the OpenSSL cipher refused the payload.');
+        }
+
+        return self::STRING_MAGIC.chr(self::FORMAT_VERSION).$nonce.$tag.$ciphertext;
+    }
+
+    public function decryptString(string $envelope): string
+    {
+        if ($this->allowLegacyCbcDecrypt && ! str_starts_with($envelope, self::STRING_MAGIC)) {
+            return $this->decryptLegacyCbc($envelope);
+        }
+
+        $headerLength = strlen(self::STRING_MAGIC) + 1 + self::GCM_NONCE_BYTES + self::GCM_TAG_BYTES;
+
+        if (strlen($envelope) <= $headerLength) {
+            throw new RuntimeException('Backup payload is truncated: shorter than its own header.');
+        }
+
+        if (! str_starts_with($envelope, self::STRING_MAGIC)) {
+            throw new RuntimeException('Backup payload is not in the expected TL backup format.');
+        }
+
+        $offset = strlen(self::STRING_MAGIC);
+        $version = ord($envelope[$offset]);
+
+        if ($version !== self::FORMAT_VERSION) {
+            throw new RuntimeException(sprintf(
+                'Backup payload format version %d is not supported (this build reads version %d).',
+                $version,
+                self::FORMAT_VERSION,
+            ));
+        }
+
+        $offset++;
+
+        $nonce = substr($envelope, $offset, self::GCM_NONCE_BYTES);
+        $offset += self::GCM_NONCE_BYTES;
+
+        $tag = substr($envelope, $offset, self::GCM_TAG_BYTES);
+        $offset += self::GCM_TAG_BYTES;
+
+        $ciphertext = substr($envelope, $offset);
+
+        $plaintext = openssl_decrypt(
+            $ciphertext,
+            'aes-256-gcm',
+            $this->subkey('gcm', ''),
+            OPENSSL_RAW_DATA,
+            $nonce,
+            $tag,
+            self::STRING_MAGIC,
+        );
+
+        if ($plaintext === false) {
+            throw new RuntimeException(
+                'Backup payload failed authentication: it was tampered with, truncated, or encrypted '
+                .'with a different key.'
+            );
+        }
+
+        return $plaintext;
+    }
+
+    /**
+     * Encrypt a file in place-safe fashion: plaintext file in, envelope out.
+     *
+     * File envelope: MAGIC(8) | VERSION(1) | SALT(16) | MAC(32) | CHUNKS...
+     *
+     * The MAC is written into the header region *after* the body is complete,
+     * so the file is only valid once fully written. A partially written
+     * archive therefore fails verification instead of decrypting to a truncated
+     * SQL file, which would import "successfully" and leave a database that
+     * looks complete but is missing its last tables.
+     *
+     * @return array{sha256: string, bytes: int, ciphertext_bytes: int}
+     */
+    public function encryptFile(string $sourcePath, string $destinationPath): array
+    {
+        $source = $this->openForRead($sourcePath);
+        $destination = $this->openForWrite($destinationPath);
+
+        try {
+            $salt = random_bytes(self::SALT_BYTES);
+            $encKey = $this->subkey('file-enc', $salt);
+            $macKey = $this->subkey('file-mac', $salt);
+            $ivKey = $this->subkey('file-iv', $salt);
+
+            $header = self::FILE_MAGIC.chr(self::FORMAT_VERSION).$salt.str_repeat("\0", 32);
+
+            if (fwrite($destination, $header) !== strlen($header)) {
+                throw new RuntimeException('Unable to write the backup envelope header.');
+            }
+
+            $mac = hash_init('sha256', HASH_HMAC, $macKey);
+            hash_update($mac, self::FILE_MAGIC.chr(self::FORMAT_VERSION).$salt);
+
+            $counter = 0;
+            $plaintextBytes = 0;
+            $ciphertextBytes = 0;
+
+            while (! feof($source)) {
+                $chunk = fread($source, self::CHUNK_BYTES);
+
+                if ($chunk === false) {
+                    throw new RuntimeException('Failed reading the database dump.');
+                }
+
+                if ($chunk === '') {
+                    break;
+                }
+
+                $chunkCiphertext = $this->cryptChunk($chunk, $encKey, $ivKey, $counter, encrypting: true);
+                $counter++;
+
+                $written = fwrite($destination, $chunkCiphertext);
+
+                if ($written !== strlen($chunkCiphertext)) {
+                    throw new RuntimeException('Short write while encrypting the backup archive.');
+                }
+
+                hash_update($mac, $chunkCiphertext);
+                $plaintextBytes += strlen($chunk);
+                $ciphertextBytes += strlen($chunkCiphertext);
+            }
+
+            $macBytes = hash_final($mac, true);
+
+            // Overwrite the reserved MAC slot; the body stays where it is.
+            if (fseek($destination, strlen(self::FILE_MAGIC) + 1 + self::SALT_BYTES) !== 0) {
+                throw new RuntimeException('Unable to seek to the backup envelope MAC slot.');
+            }
+
+            if (fwrite($destination, $macBytes) !== 32) {
+                throw new RuntimeException('Unable to write the backup envelope MAC.');
+            }
+
+            fflush($destination);
+            fclose($destination);
+
+            $sha256 = hash_file('sha256', $destinationPath);
+
+            return [
+                'sha256' => $sha256 === false ? '' : $sha256,
+                'bytes' => $plaintextBytes,
+                'ciphertext_bytes' => $ciphertextBytes + strlen(self::FILE_MAGIC) + 1 + self::SALT_BYTES + 32,
+            ];
+        } catch (\Throwable $error) {
+            // Never leave a half-written archive behind: a truncated archive in
+            // a backup directory is worse than a missing one, because the
+            // retention pruner counts it as a good copy.
+            if (is_resource($destination)) {
+                fclose($destination);
+            }
+
+            if (is_file($destinationPath)) {
+                @unlink($destinationPath);
+            }
+
+            throw $error;
+        } finally {
+            if (is_resource($source)) {
+                fclose($source);
+            }
+        }
+    }
+
+    /**
+     * Verify and decrypt a file envelope.
+     *
+     * The MAC is checked over the whole ciphertext BEFORE any plaintext is
+     * exposed to the caller, so `verifyFile()` and `decryptFile()` share one
+     * implementation and a restore can never import unauthenticated bytes.
+     *
+     * @param  string|null  $expectedSha256  when provided, the envelope's own
+     *                                       SHA-256 must match (detects a
+     *                                       swapped-but-valid archive)
+     */
+    public function decryptFile(string $sourcePath, string $destinationPath, ?string $expectedSha256 = null): array
+    {
+        if ($expectedSha256 !== null) {
+            $actual = hash_file('sha256', $sourcePath);
+
+            if ($actual === false || ! hash_equals(strtolower($expectedSha256), strtolower($actual))) {
+                throw new RuntimeException(
+                    'Backup archive checksum mismatch: the file on disk is not the file that was recorded '
+                    .'when the archive was produced.'
+                );
+            }
+        }
+
+        $source = $this->openForRead($sourcePath);
+        $destination = $this->openForWrite($destinationPath);
+
+        try {
+            $prefixLength = strlen(self::FILE_MAGIC) + 1 + self::SALT_BYTES;
+            $prefix = fread($source, $prefixLength);
+
+            if ($prefix === false || strlen($prefix) !== $prefixLength) {
+                throw new RuntimeException('Backup archive is truncated: it has no complete header.');
+            }
+
+            if (! str_starts_with($prefix, self::FILE_MAGIC)) {
+                throw new RuntimeException(
+                    'Backup archive is not in the TL backup file format. Legacy CBC archives must be '
+                    .'converted before they can be restored by this build.'
+                );
+            }
+
+            $version = ord($prefix[strlen(self::FILE_MAGIC)]);
+
+            if ($version !== self::FORMAT_VERSION) {
+                throw new RuntimeException(sprintf(
+                    'Backup archive format version %d is not supported by this build (reads version %d).',
+                    $version,
+                    self::FORMAT_VERSION,
+                ));
+            }
+
+            $salt = substr($prefix, strlen(self::FILE_MAGIC) + 1, self::SALT_BYTES);
+            $encKey = $this->subkey('file-enc', $salt);
+            $macKey = $this->subkey('file-mac', $salt);
+            $ivKey = $this->subkey('file-iv', $salt);
+
+            $macBytes = fread($source, 32);
+
+            if ($macBytes === false || strlen($macBytes) !== 32) {
+                throw new RuntimeException('Backup archive header is incomplete: no authentication tag.');
+            }
+
+            $mac = hash_init('sha256', HASH_HMAC, $macKey);
+            hash_update($mac, self::FILE_MAGIC.chr(self::FORMAT_VERSION).$salt);
+
+            $counter = 0;
+            $plaintextBytes = 0;
+
+            while (! feof($source)) {
+                $chunk = fread($source, self::CHUNK_BYTES);
+
+                if ($chunk === false) {
+                    throw new RuntimeException('Failed reading the backup archive.');
+                }
+
+                if ($chunk === '') {
+                    break;
+                }
+
+                hash_update($mac, $chunk);
+
+                $plaintext = $this->cryptChunk($chunk, $encKey, $ivKey, $counter, encrypting: false);
+                $counter++;
+
+                if (fwrite($destination, $plaintext) !== strlen($plaintext)) {
+                    throw new RuntimeException('Short write while decrypting the backup archive.');
+                }
+
+                $plaintextBytes += strlen($plaintext);
+            }
+
+            if (! hash_equals($macBytes, hash_final($mac, true))) {
+                throw new RuntimeException(
+                    'Backup archive failed authentication: wrong key, or the archive was modified after '
+                    .'it was written. Refusing to emit plaintext.'
+                );
+            }
+
+            fflush($destination);
+            fclose($destination);
+
+            return ['bytes' => $plaintextBytes, 'chunks' => $counter];
+        } catch (\Throwable $error) {
+            if (is_resource($destination)) {
+                fclose($destination);
+            }
+
+            if (is_file($destinationPath)) {
+                @unlink($destinationPath);
+            }
+
+            throw $error;
+        } finally {
+            if (is_resource($source)) {
+                fclose($source);
+            }
+        }
+    }
+
+    /**
+     * Read an envelope's header without decrypting anything.
+     *
+     * @return array{magic: string, version: int, plaintext_ready: bool}
+     */
+    public function inspectFile(string $path): array
+    {
+        $handle = $this->openForRead($path);
+
+        try {
+            $prefix = fread($handle, strlen(self::FILE_MAGIC) + 1);
+
+            if ($prefix === false || strlen($prefix) < strlen(self::FILE_MAGIC)) {
+                throw new RuntimeException('Backup archive is too small to be a TL backup envelope.');
+            }
+
+            return [
+                'magic' => substr($prefix, 0, strlen(self::FILE_MAGIC)),
+                'version' => strlen($prefix) > strlen(self::FILE_MAGIC) ? ord($prefix[strlen(self::FILE_MAGIC)]) : 0,
+                'plaintext_ready' => str_starts_with($prefix, self::FILE_MAGIC),
+            ];
+        } finally {
+            fclose($handle);
+        }
+    }
+
+    /**
+     * AES-256-CTR over one chunk with a chunk-unique derived IV.
+     *
+     * CTR is a stream cipher, so encrypting the same key with a repeated IV is
+     * a catastrophic keystream reuse. Deriving the IV from the chunk counter
+     * with the MAC key (which is itself salt-bound) guarantees uniqueness
+     * across chunks, across archives and across keys.
+     */
+    private function cryptChunk(string $chunk, string $encKey, string $ivKey, int $counter, bool $encrypting): string
+    {
+        $iv = substr(hash_hmac('sha256', 'chunk:'.$counter, $ivKey, true), 0, 16);
+
+        $output = $encrypting
+            ? openssl_encrypt($chunk, 'aes-256-ctr', $encKey, OPENSSL_RAW_DATA, $iv)
+            : openssl_decrypt($chunk, 'aes-256-ctr', $encKey, OPENSSL_RAW_DATA, $iv);
+
+        if ($output === false) {
+            throw new RuntimeException('Chunk cipher operation failed.');
+        }
+
+        return $output;
+    }
+
+    /**
+     * Decrypt the legacy AES-256-CBC payloads produced before this build.
+     *
+     * Off by default. It exists so a restore drill can migrate an archive
+     * taken by the old code without re-running the old code, NOT so the old
+     * format can stay in use — it is unauthenticated and therefore cannot be
+     * verified, only decrypted.
+     */
+    private function decryptLegacyCbc(string $base64Payload): string
+    {
+        $raw = base64_decode($base64Payload, true);
+
+        if ($raw === false || strlen($raw) <= 16) {
+            throw new RuntimeException('Legacy backup payload is not valid base64 or is truncated.');
+        }
+
+        $iv = substr($raw, 0, 16);
+        $ciphertext = substr($raw, 16);
+
+        $plaintext = openssl_decrypt(
+            $ciphertext,
+            'aes-256-cbc',
+            hash('sha256', $this->masterKey, true),
+            OPENSSL_RAW_DATA,
+            $iv,
+        );
+
+        if ($plaintext === false) {
+            throw new RuntimeException('Legacy backup decryption failed (wrong key or corrupted payload).');
+        }
+
+        return $plaintext;
+    }
+
+    /**
+     * @return resource
+     */
+    private function openForRead(string $path)
+    {
+        if (! is_file($path) || ! is_readable($path)) {
+            throw new RuntimeException('Backup source file is not readable: '.basename($path));
+        }
+
+        $handle = fopen($path, 'rb');
+
+        if ($handle === false) {
+            throw new RuntimeException('Unable to open backup source file: '.basename($path));
+        }
+
+        return $handle;
+    }
+
+    /**
+     * @return resource
+     */
+    private function openForWrite(string $path)
+    {
+        $directory = dirname($path);
+
+        if (! is_dir($directory) && ! @mkdir($directory, 0770, true) && ! is_dir($directory)) {
+            throw new RuntimeException('Unable to create the backup output directory.');
+        }
+
+        $handle = fopen($path, 'wb');
+
+        if ($handle === false) {
+            throw new RuntimeException('Unable to open the backup output file for writing.');
+        }
+
+        // Ciphertext at rest is owner/group readable only. A backup directory is
+        // routinely mounted into sidecars and debug containers.
+        @chmod($path, 0640);
+
+        return $handle;
+    }
+}
diff --git a/app/Support/Ops/ProductionPreflight.php b/app/Support/Ops/ProductionPreflight.php
new file mode 100644
index 0000000..d9ebf54
--- /dev/null
+++ b/app/Support/Ops/ProductionPreflight.php
@@ -0,0 +1,573 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Support\Ops;
+
+use App\Providers\ProductionSafetyServiceProvider;
+use App\Support\Backup\BackupCipher;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Redis;
+use Illuminate\Support\Str;
+use Throwable;
+
+/**
+ * Deployment preflight: the checks that must pass before a release is allowed
+ * to take traffic.
+ *
+ * RELATIONSHIP TO ProductionSafetyServiceProvider
+ * -----------------------------------------------
+ * That provider already refuses to BOOT production with fixture result lanes,
+ * debug mode, insecure session cookies, a per-node cache, a synchronous queue
+ * or a live payout switch without an approval threshold. It is the right place
+ * for "the application must not run like this" and this class does not
+ * duplicate it — it calls `violations()` and adds the checks that need an
+ * environment the boot path cannot assume: connectivity, writability, build
+ * artifacts, key material shape, and backup readiness.
+ *
+ * THE RULE: NO VALUES IN THE OUTPUT
+ * ---------------------------------
+ * Every check reports a status and a *description of the shape* of what it
+ * found ("present", "96 characters", "https", "base64: 32 bytes"), never the
+ * value. A preflight is run in CI transcripts, in deploy logs, and pasted into
+ * incident tickets; it must be safe in all three. `maskValue()` exists so a
+ * check cannot accidentally include a secret by interpolating one.
+ *
+ * Statuses:
+ *   PASS  the requirement is satisfied
+ *   WARN  acceptable but worth an operator's attention
+ *   FAIL  the release must not proceed
+ *   SKIP  not applicable in this environment or the probe was not attempted
+ */
+final class ProductionPreflight
+{
+    /** @var list<array{id: string, status: string, detail: string, severity: string}> */
+    private array $results = [];
+
+    public function __construct(
+        private readonly bool $production,
+        private readonly bool $withConnectivity = true,
+    ) {}
+
+    /**
+     * @return array{
+     *     status: string,
+     *     environment: string,
+     *     checks: list<array{id: string, status: string, detail: string, severity: string}>,
+     *     summary: array{pass: int, warn: int, fail: int, skip: int}
+     * }
+     */
+    public function run(): array
+    {
+        $this->results = [];
+
+        $this->checkAppEnvironment();
+        $this->checkApplicationKey();
+        $this->checkSessionAndCookies();
+        $this->checkSafetyProviderContract();
+        $this->checkBackupLane();
+        $this->checkHealthToken();
+        $this->checkBuildArtifacts();
+        $this->checkWritablePaths();
+        $this->checkEnvFilePermissions();
+        $this->checkQueueTimeouts();
+        $this->checkRedisPassword();
+        $this->checkLogPrivacy();
+
+        if ($this->withConnectivity) {
+            $this->checkDatabaseConnectivity();
+            $this->checkCacheAndRedisConnectivity();
+        } else {
+            $this->record('database.connectivity', 'SKIP', 'Connectivity probes were not requested (--offline).', 'advisory');
+            $this->record('cache.connectivity', 'SKIP', 'Connectivity probes were not requested (--offline).', 'advisory');
+        }
+
+        $summary = ['pass' => 0, 'warn' => 0, 'fail' => 0, 'skip' => 0];
+
+        foreach ($this->results as $result) {
+            $summary[strtolower($result['status'])]++;
+        }
+
+        return [
+            'status' => $summary['fail'] > 0 ? 'FAIL' : ($summary['warn'] > 0 ? 'WARN' : 'PASS'),
+            'environment' => (string) config('app.env'),
+            'checks' => $this->results,
+            'summary' => $summary,
+        ];
+    }
+
+    private function record(string $id, string $status, string $detail, string $severity = 'blocking'): void
+    {
+        $this->results[] = [
+            'id' => $id,
+            'status' => $status,
+            'detail' => $detail,
+            'severity' => $severity,
+        ];
+    }
+
+    /** A failing advisory check does not block and does not escalate WARN to FAIL. */
+    private function recordAdvisory(string $id, string $status, string $detail): void
+    {
+        $this->record($id, $status, $detail, 'advisory');
+    }
+
+    private function checkAppEnvironment(): void
+    {
+        $env = (string) config('app.env');
+        $debug = (bool) config('app.debug');
+        $url = (string) config('app.url');
+
+        if ($this->production && ! in_array($env, ['production', 'prod'], true)) {
+            $this->record('app.environment', 'FAIL', sprintf('APP_ENV is "%s" but this preflight expects production.', $this->maskValue($env)));
+        } else {
+            $this->record('app.environment', 'PASS', sprintf('APP_ENV is "%s".', $this->maskValue($env)));
+        }
+
+        if ($this->production && $debug) {
+            $this->record('app.debug', 'FAIL', 'APP_DEBUG is enabled; stack traces would be served publicly.');
+        } else {
+            $this->record('app.debug', 'PASS', 'APP_DEBUG is disabled.');
+        }
+
+        if ($this->production) {
+            if (! str_starts_with($url, 'https://')) {
+                $this->record('app.url', 'FAIL', 'APP_URL is not https://; session cookies and payment callbacks would travel in clear text.');
+            } elseif (str_contains($url, 'localhost') || str_contains($url, '127.0.0.1') || str_contains($url, 'example')) {
+                $this->record('app.url', 'FAIL', 'APP_URL still points at a placeholder host.');
+            } else {
+                $this->recordAdvisory('app.url', 'PASS', 'APP_URL is a public https:// origin.');
+            }
+        } else {
+            $this->recordAdvisory('app.url', 'SKIP', 'APP_URL https:// enforcement applies to production only.');
+        }
+    }
+
+    private function checkApplicationKey(): void
+    {
+        $key = (string) config('app.key');
+
+        if ($key === '') {
+            $this->record('app.key', 'FAIL', 'APP_KEY is empty; encrypted sessions, cookies and payloads cannot be produced.');
+
+            return;
+        }
+
+        $decoded = Str::startsWith($key, 'base64:') ? base64_decode(substr($key, 7), true) : $key;
+
+        if ($decoded === false || strlen((string) $decoded) !== 32) {
+            $this->record('app.key', 'FAIL', 'APP_KEY is present but is not a 32-byte key (base64: or raw).');
+
+            return;
+        }
+
+        $this->record('app.key', 'PASS', 'APP_KEY is a 32-byte key.');
+    }
+
+    private function checkSessionAndCookies(): void
+    {
+        if (! $this->production) {
+            $this->recordAdvisory('session.cookie', 'SKIP', 'Cookie hardening checks apply to production only.');
+
+            return;
+        }
+
+        $secure = (bool) config('session.secure');
+        $encrypted = (bool) config('session.encrypt');
+        $sameSite = strtolower((string) config('session.same_site'));
+
+        if ($secure && $encrypted && in_array($sameSite, ['lax', 'strict'], true)) {
+            $this->record('session.cookie', 'PASS', 'Session cookies are secure, encrypted and SameSite-restricted.');
+        } else {
+            $this->record('session.cookie', 'FAIL', sprintf(
+                'Session cookies are secure=%s encrypt=%s same_site=%s; all three must be hardened in production.',
+                $secure ? 'true' : 'false',
+                $encrypted ? 'true' : 'false',
+                $sameSite === '' ? 'unset' : $sameSite,
+            ));
+        }
+    }
+
+    /**
+     * Delegates to the provider's contract rather than restating it, so a rule
+     * added there is enforced here on the next release without a second edit.
+     */
+    private function checkSafetyProviderContract(): void
+    {
+        try {
+            $violations = ProductionSafetyServiceProvider::violations();
+        } catch (Throwable $error) {
+            $this->record('safety.contract', 'WARN', 'The production safety contract could not be evaluated: '.$error->getMessage());
+
+            return;
+        }
+
+        if ($violations === []) {
+            $this->record('safety.contract', 'PASS', 'Every ProductionSafetyServiceProvider rule is satisfied.');
+
+            return;
+        }
+
+        foreach ($violations as $index => $violation) {
+            $this->record('safety.contract.'.($index + 1), $this->production ? 'FAIL' : 'WARN', $violation);
+        }
+    }
+
+    private function checkBackupLane(): void
+    {
+        $configured = BackupCipher::hasConfiguredKey();
+
+        if (! $configured) {
+            $this->record(
+                'backup.key',
+                $this->production ? 'FAIL' : 'WARN',
+                'No usable backup encryption key: set BACKUP_ENCRYPTION_KEY (>= 32 characters) or BACKUP_ENCRYPTION_KEY_FILE.',
+            );
+        } else {
+            $length = strlen((string) BackupCipher::configuredKey());
+
+            if ($this->production && $length < 32) {
+                $this->record('backup.key', 'FAIL', sprintf('The backup key is %d characters; production requires at least 32.', $length));
+            } else {
+                $this->recordAdvisory('backup.key', 'PASS', sprintf('Backup key present (%d characters, value not printed).', $length));
+            }
+        }
+
+        $path = (string) config('backup.path', storage_path('app/backups'));
+        $publicRoot = (string) public_path();
+
+        if (Str::startsWith(realpath($path) ?: $path, $publicRoot)) {
+            $this->record('backup.path', 'FAIL', 'BACKUP_PATH is inside the web root; a backup archive must never be web-reachable.');
+        } elseif (is_dir($path) && ! is_writable($path)) {
+            $this->record('backup.path', 'FAIL', 'The backup directory exists but is not writable by the runtime user.');
+        } else {
+            $this->recordAdvisory('backup.path', 'PASS', 'Backup directory is outside the web root and writable (or creatable).');
+        }
+
+        $binary = config('backup.dump.mysql.binary', 'mysqldump');
+        $driver = (string) config('database.default');
+        $driverName = (string) config('database.connections.'.$driver.'.driver');
+        $binaryName = $driverName === 'pgsql'
+            ? (string) config('backup.dump.pgsql.binary', 'pg_dump')
+            : (is_string($binary) ? $binary : 'mysqldump');
+
+        $found = false;
+
+        foreach (explode(PATH_SEPARATOR, (string) getenv('PATH')) as $directory) {
+            if ($directory !== '' && is_executable(rtrim($directory, '/').'/'.$binaryName)) {
+                $found = true;
+
+                break;
+            }
+        }
+
+        $found
+            ? $this->recordAdvisory('backup.binary', 'PASS', sprintf('The %s client is on PATH.', $binaryName))
+            : $this->record('backup.binary', $this->production ? 'FAIL' : 'WARN', sprintf(
+                'The %s client is not on PATH; this host cannot take a database backup.',
+                $binaryName,
+            ));
+    }
+
+    private function checkHealthToken(): void
+    {
+        $token = config('app.health_detail_token');
+
+        if (! is_string($token) || strlen($token) < 32) {
+            $this->recordAdvisory(
+                'health.token',
+                'WARN',
+                'HEALTH_DETAIL_TOKEN is unset or shorter than 32 characters; /up/health will only return the public summary.'
+                    .' That is a safe default, but it also means nobody can see the detailed report during an incident.'
+            );
+
+            return;
+        }
+
+        $this->recordAdvisory('health.token', 'PASS', 'A detailed health token is configured (value not printed).');
+    }
+
+    private function checkBuildArtifacts(): void
+    {
+        $manifest = public_path('build/manifest.json');
+
+        if (! is_file($manifest)) {
+            $this->record(
+                'build.manifest',
+                $this->production ? 'FAIL' : 'WARN',
+                'public/build/manifest.json is missing; every page would fail to resolve its assets. '
+                .'Run `npm run build` as part of the release, never on the production host ad hoc.'
+            );
+
+            return;
+        }
+
+        $decoded = json_decode((string) file_get_contents($manifest), true);
+
+        if (! is_array($decoded) || $decoded === []) {
+            $this->record('build.manifest', 'FAIL', 'public/build/manifest.json is empty or is not a JSON object.');
+
+            return;
+        }
+
+        $missing = 0;
+
+        foreach ($decoded as $entry) {
+            if (is_array($entry) && isset($entry['file']) && ! is_file(public_path('build/'.$entry['file']))) {
+                $missing++;
+            }
+        }
+
+        $missing === 0
+            ? $this->record('build.manifest', 'PASS', sprintf('%d manifest entries, every referenced file exists.', count($decoded)))
+            : $this->record('build.manifest', 'FAIL', sprintf('%d manifest entries point at files that do not exist.', $missing));
+    }
+
+    private function checkWritablePaths(): void
+    {
+        $paths = [
+            'storage/framework/cache/data' => storage_path('framework/cache/data'),
+            'storage/framework/sessions' => storage_path('framework/sessions'),
+            'storage/framework/views' => storage_path('framework/views'),
+            'storage/logs' => storage_path('logs'),
+            'bootstrap/cache' => base_path('bootstrap/cache'),
+        ];
+
+        $unwritable = [];
+
+        foreach ($paths as $label => $path) {
+            if (! is_dir($path) || ! is_writable($path)) {
+                $unwritable[] = $label;
+            }
+        }
+
+        $unwritable === []
+            ? $this->record('filesystem.writable', 'PASS', 'Every Laravel runtime directory is present and writable.')
+            : $this->record('filesystem.writable', 'FAIL', 'These runtime directories are missing or read-only: '.implode(', ', $unwritable).'.');
+    }
+
+    /**
+     * A world-readable .env is a credential disclosure even when every other
+     * check passes.
+     */
+    private function checkEnvFilePermissions(): void
+    {
+        $envPath = base_path('.env');
+
+        if (! is_file($envPath)) {
+            $this->recordAdvisory('env.permissions', 'SKIP', 'No .env file in this deployment (environment is injected by the orchestrator).');
+
+            return;
+        }
+
+        $permissions = fileperms($envPath) & 0777;
+
+        // "others" must have no read bit. Group read is acceptable: the group is
+        // normally the application group.
+        if (($permissions & 0004) !== 0) {
+            $this->record('env.permissions', $this->production ? 'FAIL' : 'WARN', sprintf(
+                'The .env file is world-readable (mode %s). Set 0640.',
+                decoct($permissions),
+            ));
+
+            return;
+        }
+
+        $this->recordAdvisory('env.permissions', 'PASS', sprintf('.env mode is %s.', decoct($permissions)));
+    }
+
+    /**
+     * The classic Laravel production bug: a job's timeout is longer than the
+     * queue's retry_after, so a slow-but-alive worker's job is handed to a
+     * second worker and runs twice. For a payout job that is a double payout.
+     */
+    private function checkQueueTimeouts(): void
+    {
+        $connection = (string) config('queue.default');
+
+        if ($connection === 'sync') {
+            // Blocking in production, advisory everywhere else: the sync driver
+            // is the correct default for a laptop and for the test suite, but a
+            // production request must never perform a payout inline. Failing a
+            // local preflight for a legitimate local configuration teaches
+            // operators to ignore the gate.
+            $this->record(
+                'queue.timeouts',
+                $this->production ? 'FAIL' : 'WARN',
+                'QUEUE_CONNECTION is sync; jobs run inside the HTTP request with no retries, no backoff and no visibility.'
+                .($this->production ? '' : ' This is acceptable outside production; it is not acceptable in it.')
+            );
+
+            return;
+        }
+
+        $retryAfter = config('queue.connections.'.$connection.'.retry_after');
+        $horizonTimeouts = [];
+
+        foreach ((array) config('horizon.environments', []) as $environment) {
+            foreach ((array) $environment as $supervisor) {
+                if (is_array($supervisor) && isset($supervisor['timeout'])) {
+                    $horizonTimeouts[] = (int) $supervisor['timeout'];
+                }
+            }
+        }
+
+        if (! is_numeric($retryAfter)) {
+            $this->recordAdvisory('queue.timeouts', 'SKIP', 'The active queue connection does not declare retry_after (event-driven or sync driver).');
+
+            return;
+        }
+
+        $retryAfter = (int) $retryAfter;
+        $maxTimeout = $horizonTimeouts === [] ? 0 : max($horizonTimeouts);
+
+        if ($maxTimeout > 0 && $retryAfter <= $maxTimeout) {
+            $this->record('queue.timeouts', 'FAIL', sprintf(
+                'queue.retry_after (%d s) must exceed the longest Horizon worker timeout (%d s), otherwise a '
+                .'still-running job is released and executed twice.',
+                $retryAfter,
+                $maxTimeout,
+            ));
+
+            return;
+        }
+
+        $this->recordAdvisory('queue.timeouts', 'PASS', sprintf('retry_after is %d s and the longest worker timeout is %d s.', $retryAfter, $maxTimeout));
+    }
+
+    private function checkRedisPassword(): void
+    {
+        $connection = (string) config('queue.default');
+        $usesRedis = $connection === 'redis'
+            || (string) config('cache.default') === 'redis'
+            || (string) config('session.driver') === 'redis';
+
+        if (! $usesRedis) {
+            $this->recordAdvisory('redis.password', 'SKIP', 'Redis is not used for queue, cache or sessions.');
+
+            return;
+        }
+
+        $password = config('database.redis.default.password');
+
+        if (! is_string($password) || $password === '') {
+            $this->record(
+                'redis.password',
+                $this->production ? 'FAIL' : 'WARN',
+                'Redis has no password while carrying sessions, cache and queues. Anyone who reaches port 6379 '
+                .'can read sessions and inject jobs.'
+            );
+
+            return;
+        }
+
+        $this->recordAdvisory('redis.password', 'PASS', 'Redis credentials are configured (value not printed).');
+    }
+
+    private function checkLogPrivacy(): void
+    {
+        $channel = (string) config('logging.default');
+        $redaction = (bool) config('logging.redaction.enabled', true);
+
+        if ($this->production && in_array($channel, ['single', 'daily'], true)) {
+            $this->recordAdvisory('log.privacy', 'WARN', sprintf(
+                'LOG_CHANNEL is "%s"; container deployments should log to stderr so the orchestrator owns rotation and retention.',
+                $channel
+            ));
+        } else {
+            $this->recordAdvisory('log.privacy', 'PASS', sprintf('LOG_CHANNEL is "%s".', $channel));
+        }
+
+        $redaction
+            ? $this->recordAdvisory('log.redaction', 'PASS', 'Secret redaction is enabled for every log channel.')
+            : $this->record('log.redaction', $this->production ? 'FAIL' : 'WARN', 'LOG_REDACT_SENSITIVE is false; secrets could reach the log sink.');
+    }
+
+    private function checkDatabaseConnectivity(): void
+    {
+        $start = microtime(true);
+
+        try {
+            DB::connection()->select('SELECT 1');
+        } catch (Throwable $error) {
+            $this->record('database.connectivity', 'FAIL', 'The database is unreachable: '.$this->sanitize($error->getMessage()));
+
+            return;
+        }
+
+        $latency = round((microtime(true) - $start) * 1000, 1);
+
+        $latency > 1000
+            ? $this->recordAdvisory('database.connectivity', 'WARN', sprintf('The database answered in %s ms.', $latency))
+            : $this->record('database.connectivity', 'PASS', sprintf('The database answered in %s ms.', $latency));
+
+        try {
+            $driver = (string) DB::connection()->getDriverName();
+            $pending = DB::connection()->getSchemaBuilder()->hasTable('migrations')
+                ? DB::table('migrations')->count()
+                : -1;
+
+            $this->recordAdvisory('database.schema', 'PASS', sprintf(
+                'Driver "%s" with %s applied migrations.',
+                $driver,
+                $pending < 0 ? 'no migrations table' : (string) $pending,
+            ));
+        } catch (Throwable $error) {
+            $this->recordAdvisory('database.schema', 'WARN', 'Migration state could not be read: '.$this->sanitize($error->getMessage()));
+        }
+    }
+
+    private function checkCacheAndRedisConnectivity(): void
+    {
+        try {
+            $key = 'ops:preflight:'.bin2hex(random_bytes(6));
+            cache()->put($key, 'ok', 10);
+
+            if (cache()->get($key) !== 'ok') {
+                $this->record('cache.connectivity', 'FAIL', 'The cache store accepts a write but does not return it; caching and locks cannot be trusted.');
+
+                return;
+            }
+
+            cache()->forget($key);
+            $this->record('cache.connectivity', 'PASS', sprintf('Cache store "%s" round-trips a value.', (string) config('cache.default')));
+        } catch (Throwable $error) {
+            $this->record('cache.connectivity', 'FAIL', 'The cache store is unreachable: '.$this->sanitize($error->getMessage()));
+
+            return;
+        }
+
+        try {
+            $pong = Redis::connection()->ping();
+            $this->recordAdvisory('redis.connectivity', 'PASS', 'Redis answered PING with '.$this->maskValue((string) (is_object($pong) ? 'PONG' : $pong)).'.');
+        } catch (Throwable $error) {
+            $usesRedis = (string) config('cache.default') === 'redis' || (string) config('queue.default') === 'redis';
+
+            $this->record(
+                'redis.connectivity',
+                $usesRedis ? 'FAIL' : 'WARN',
+                'Redis is not reachable: '.$this->sanitize($error->getMessage()),
+            );
+        }
+    }
+
+    /**
+     * Defensive: nothing a check interpolates should look like a credential.
+     * Connection errors are the usual culprit (they can carry a DSN).
+     */
+    private function sanitize(string $message): string
+    {
+        $scrubbed = preg_replace(
+            ['/(password|pwd|passwd)\s*=\s*[^\s;,]+/i', '/(:\/\/[^:\s]+:)[^@\s]+@/', '/(--password=)\S+/'],
+            ['$1=[REDACTED]', '$1[REDACTED]@', '$1[REDACTED]'],
+            $message,
+        );
+
+        return Str::limit(trim((string) $scrubbed), 240);
+    }
+
+    private function maskValue(string $value): string
+    {
+        return $value === '' ? '(empty)' : $value;
+    }
+}
