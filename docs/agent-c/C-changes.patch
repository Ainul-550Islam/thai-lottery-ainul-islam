+<?php
+
+declare(strict_types=1);
+
+namespace App\Console\Commands\Infrastructure;
+
+use App\Services\Infrastructure\ImmutableBackupService;
+use Illuminate\Console\Command;
+use RuntimeException;
+
+/**
+ * Decrypts and decompresses an archive to a plaintext SQL file, so a restore
+ * can be performed by the database client directly.
+ *
+ * WHY THIS IS A SEPARATE COMMAND FROM backup:verify
+ * `backup:verify` must NOT leave plaintext on disk — it is what a cron monitor
+ * runs every hour, and a host that accumulates unencrypted dumps of the
+ * financial ledger in /tmp is a worse problem than the one backups solve. This
+ * command exists for the restore path only, where the plaintext is the point,
+ * and it therefore:
+ *
+ *   * authenticates the archive BEFORE emitting a single byte (the cipher
+ *     streams to a temporary file and only renames it after the MAC verifies);
+ *   * writes with mode 0600;
+ *   * refuses to write inside the repository or the web root;
+ *   * tells the caller (scripts/ops/restore.sh) to shred the file when done.
+ */
+class ExtractBackupCommand extends Command
+{
+    protected $signature = 'backup:extract
+        {archive : Path to the .sql.gz.enc archive}
+        {--output= : Where to write the plaintext SQL (required)}
+        {--force : Overwrite an existing output file}
+        {--json : Machine-readable result}';
+
+    protected $description = 'Authenticate, decrypt and decompress a backup archive to a plaintext SQL file for restore.';
+
+    public function handle(ImmutableBackupService $backups): int
+    {
+        $json = (bool) $this->option('json');
+        $archive = (string) $this->argument('archive');
+        $output = (string) ($this->option('output') ?: '');
+
+        $fail = function (string $message) use ($json): int {
+            $json
+                ? $this->line((string) json_encode(['status' => 'FAILED', 'reason' => $message]))
+                : $this->components->error($message);
+
+            return self::FAILURE;
+        };
+
+        if ($output === '') {
+            return $fail('--output is required; this command will not guess where to leave a plaintext dump.');
+        }
+
+        if (! is_file($archive)) {
+            return $fail('Archive not found: '.basename($archive));
+        }
+
+        if (is_file($output) && ! $this->option('force')) {
+            return $fail('Refusing to overwrite an existing file: '.basename($output).' (pass --force)');
+        }
+
+        $realOutput = $this->canonicalise($output);
+        $publicRoot = (string) realpath(public_path());
+
+        if ($publicRoot !== '' && str_starts_with($realOutput, $publicRoot)) {
+            return $fail('Refusing to write plaintext into the web root.');
+        }
+
+        $temporaryGz = $output.'.gz.partial';
+
+        try {
+            $backups->decryptFile($archive, $temporaryGz);
+        } catch (RuntimeException $error) {
+            @unlink($temporaryGz);
+
+            return $fail('Archive failed authentication and was not extracted: '.$error->getMessage());
+        }
+
+        try {
+            $source = gzopen($temporaryGz, 'rb');
+
+            if ($source === false) {
+                throw new RuntimeException('The decrypted stream is not gzip data.');
+            }
+
+            $destination = fopen($output.'.partial', 'wb');
+
+            if ($destination === false) {
+                gzclose($source);
+
+                throw new RuntimeException('Unable to write the plaintext dump.');
+            }
+
+            @chmod($output.'.partial', 0600);
+
+            while (! gzeof($source)) {
+                $chunk = gzread($source, 262144);
+
+                if ($chunk === false) {
+                    break;
+                }
+
+                fwrite($destination, $chunk);
+            }
+
+            gzclose($source);
+            fclose($destination);
+
+            if (! @rename($output.'.partial', $output)) {
+                throw new RuntimeException('Unable to finalise the plaintext dump.');
+            }
+
+            @chmod($output, 0600);
+        } catch (RuntimeException $error) {
+            @unlink($temporaryGz);
+            @unlink($output.'.partial');
+
+            return $fail($error->getMessage());
+        } finally {
+            if (is_file($temporaryGz)) {
+                @unlink($temporaryGz);
+            }
+        }
+
+        $bytes = (int) filesize($output);
+
+        $json
+            ? $this->line((string) json_encode(['status' => 'EXTRACTED', 'output' => $output, 'bytes' => $bytes]))
+            : $this->components->info(sprintf('Extracted %s bytes to a plaintext dump (mode 0600).', number_format($bytes)));
+
+        return self::SUCCESS;
+    }
+
+    private function canonicalise(string $path): string
+    {
+        $directory = realpath(dirname($path));
+
+        return $directory === false ? $path : $directory.'/'.basename($path);
+    }
+}
diff --git a/app/Console/Commands/Infrastructure/RestoreDatabaseCommand.php b/app/Console/Commands/Infrastructure/RestoreDatabaseCommand.php
new file mode 100644
index 0000000..1b10bbb
--- /dev/null
+++ b/app/Console/Commands/Infrastructure/RestoreDatabaseCommand.php
@@ -0,0 +1,122 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Console\Commands\Infrastructure;
+
+use App\Services\Infrastructure\DatabaseDumpService;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\DB;
+use RuntimeException;
+use Throwable;
+
+/**
+ * Imports a plaintext SQL dump into a named database.
+ *
+ * This command is the mechanism; `scripts/ops/restore.sh` is the policy. The
+ * split is deliberate: the shell script owns the confirmations an operator has
+ * to type, and this command owns the parts that must not be expressible in
+ * shell (identifier validation, DROP/CREATE sequencing, refusing the live
+ * connection).
+ *
+ * The `--recreate` path is the one to be careful with: it DROPs the named
+ * database before creating it. It therefore refuses outright when the name
+ * matches the connection the application is configured to use, regardless of
+ * any other flag — dropping the database you are currently connected to in
+ * order to restore into it is never the right move, even during an incident.
+ */
+class RestoreDatabaseCommand extends Command
+{
+    protected $signature = 'db:restore-file
+        {file : Plaintext SQL dump}
+        {--database= : Target database (required)}
+        {--connection= : Laravel connection supplying host, port and credentials}
+        {--recreate : DROP and CREATE the target before importing}
+        {--allow-live-target : Permit the application\'s own database as the target}
+        {--json : Machine-readable result}';
+
+    protected $description = 'Import a plaintext SQL dump into an explicit, validated target database.';
+
+    public function handle(): int
+    {
+        $json = (bool) $this->option('json');
+        $file = (string) $this->argument('file');
+        $database = (string) ($this->option('database') ?: '');
+        $connectionName = $this->option('connection');
+        $connectionName = is_string($connectionName) && $connectionName !== '' ? $connectionName : null;
+
+        $fail = function (string $message) use ($json): int {
+            $json
+                ? $this->line((string) json_encode(['status' => 'FAILED', 'reason' => $message]))
+                : $this->components->error($message);
+
+            return self::FAILURE;
+        };
+
+        if ($database === '') {
+            return $fail('--database is required; this command never guesses a restore target.');
+        }
+
+        // A database name reaches a DROP/CREATE statement; it is validated
+        // before it is interpolated anywhere.
+        if (preg_match('/^[A-Za-z0-9_]+$/', $database) !== 1) {
+            return $fail('The database name must match [A-Za-z0-9_]+.');
+        }
+
+        if (! is_file($file) || filesize($file) === 0) {
+            return $fail('The dump file is missing or empty: '.basename($file));
+        }
+
+        $resolvedConnection = $connectionName ?? (string) config('database.default');
+        $configuredDatabase = (string) config('database.connections.'.$resolvedConnection.'.database');
+
+        if ($database === $configuredDatabase && ! $this->option('allow-live-target')) {
+            return $fail(sprintf(
+                'Refusing to restore into "%s": that is the database this application is configured to use.',
+                $database,
+            ));
+        }
+
+        if ($this->option('recreate') && $database === $configuredDatabase) {
+            return $fail('Refusing to DROP the application\'s own database. Restore into a scratch database and swap.');
+        }
+
+        try {
+            if ($this->option('recreate')) {
+                $this->components->task('Dropping and creating '.$database, function () use ($database): void {
+                    // Statement text cannot be parameterised for DDL; the name
+                    // has already been validated as [A-Za-z0-9_]+ and is quoted.
+                    $driver = (string) DB::connection()->getDriverName();
+
+                    if ($driver === 'pgsql') {
+                        DB::statement(sprintf('DROP DATABASE IF EXISTS "%s" WITH (FORCE)', $database));
+                        DB::statement(sprintf('CREATE DATABASE "%s"', $database));
+                    } else {
+                        DB::statement(sprintf('DROP DATABASE IF EXISTS `%s`', $database));
+                        DB::statement(sprintf('CREATE DATABASE `%s` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci', $database));
+                    }
+                });
+            }
+
+            $result = $this->components->task(
+                'Importing '.basename($file).' into '.$database,
+                fn (): array => DatabaseDumpService::fromConfig()->restore($file, $database, $resolvedConnection, true)
+            );
+
+            $json
+                ? $this->line((string) json_encode([
+                    'status' => 'RESTORED',
+                    'database' => $database,
+                    'driver' => $result['driver'] ?? 'unknown',
+                    'bytes' => $result['bytes'] ?? 0,
+                ]))
+                : $this->components->info('Restored into '.$database.'.');
+        } catch (RuntimeException $error) {
+            return $fail($error->getMessage());
+        } catch (Throwable $error) {
+            return $fail('Unexpected restore failure: '.$error->getMessage());
+        }
+
+        return self::SUCCESS;
+    }
+}
diff --git a/app/Console/Commands/Infrastructure/VerifyBackupCommand.php b/app/Console/Commands/Infrastructure/VerifyBackupCommand.php
new file mode 100644
index 0000000..40c59a0
--- /dev/null
+++ b/app/Console/Commands/Infrastructure/VerifyBackupCommand.php
@@ -0,0 +1,264 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Console\Commands\Infrastructure;
+
+use App\Services\Infrastructure\DatabaseDumpService;
+use App\Services\Infrastructure\ImmutableBackupService;
+use Illuminate\Console\Command;
+use RuntimeException;
+use Throwable;
+
+/**
+ * Verifies an encrypted backup archive without restoring it.
+ *
+ * This exists because a backup that has never been read back is a hypothesis.
+ * The check is layered, and each layer catches a different failure:
+ *
+ *   1. the `.sha256` sidecar (or `--checksum`) must match the file on disk
+ *      -> catches truncation, a partial copy, or a swapped file;
+ *   2. the HMAC inside the envelope must verify under the current key
+ *      -> catches tampering and a wrong key;
+ *   3. the decompressed stream must begin like a dump and end with the
+ *      client's completion marker
+ *      -> catches a dump that was cut short before encryption started.
+ *
+ * `--deep` additionally restores into a scratch database and compares table
+ * counts, which is what a restore drill actually needs. Because that step
+ * writes to a database, it refuses to target the configured live database.
+ */
+class VerifyBackupCommand extends Command
+{
+    protected $signature = 'backup:verify
+        {archive : Path to the .sql.gz.enc archive}
+        {--checksum= : Expected SHA-256 (defaults to the .sha256 sidecar)}
+        {--deep : Also restore into a scratch database and compare table counts}
+        {--scratch-database= : Database to restore into when --deep is used}
+        {--json : Machine-readable result}';
+
+    protected $description = 'Verify that an encrypted backup archive authenticates, decrypts, and contains a complete dump.';
+
+    public function handle(): int
+    {
+        $json = (bool) $this->option('json');
+        $archive = (string) $this->argument('archive');
+
+        $result = [
+            'archive' => basename($archive),
+            'checks' => [],
+            'status' => 'FAILED',
+        ];
+
+        $fail = function (string $check, string $reason) use (&$result, $json): int {
+            $result['checks'][] = ['check' => $check, 'status' => 'FAILED', 'detail' => $reason];
+
+            return $this->finish($result, $json);
+        };
+
+        if (! is_file($archive)) {
+            return $fail('archive_present', 'Archive not found: '.basename($archive));
+        }
+
+        // See ExecuteEncryptedBackupCommand: a key problem surfaces in the
+        // service constructor, which must be reported as a check failure
+        // rather than escaping as an unhandled exception.
+        try {
+            $backups = $this->laravel->make(ImmutableBackupService::class);
+        } catch (Throwable $error) {
+            return $fail('configuration', $error->getMessage());
+        }
+
+        // 1. Checksum ------------------------------------------------------
+        $expected = $this->option('checksum');
+
+        if (! is_string($expected) || $expected === '') {
+            $sidecar = $archive.'.sha256';
+
+            if (is_file($sidecar)) {
+                $expected = trim((string) strtok((string) file_get_contents($sidecar), ' '));
+            }
+        }
+
+        if (! is_string($expected) || $expected === '') {
+            $result['checks'][] = [
+                'check' => 'checksum',
+                'status' => 'WARN',
+                'detail' => 'No .sha256 sidecar and no --checksum; the archive cannot be matched to a manifest.',
+            ];
+        } else {
+            $actual = hash_file('sha256', $archive);
+
+            if ($actual === false || ! hash_equals(strtolower($expected), strtolower($actual))) {
+                return $fail('checksum', 'SHA-256 does not match the recorded value.');
+            }
+
+            $result['checks'][] = ['check' => 'checksum', 'status' => 'PASS', 'detail' => 'SHA-256 matches.'];
+        }
+
+        // 2. Envelope authenticity ----------------------------------------
+        try {
+            $header = $backups->inspectFile($archive);
+
+            if (! $header['plaintext_ready']) {
+                return $fail('envelope', 'Not a TL backup envelope (legacy or foreign file).');
+            }
+
+            $result['checks'][] = [
+                'check' => 'envelope',
+                'status' => 'PASS',
+                'detail' => 'Format version '.$header['version'].'.',
+            ];
+        } catch (RuntimeException $error) {
+            return $fail('envelope', $error->getMessage());
+        }
+
+        $scratch = tempnam(sys_get_temp_dir(), 'tlbackupverify');
+
+        if ($scratch === false) {
+            return $fail('scratch', 'Unable to allocate a temporary file for verification.');
+        }
+
+        try {
+            $decrypted = tempnam(sys_get_temp_dir(), 'tldump');
+
+            if ($decrypted === false) {
+                return $fail('scratch', 'Unable to allocate a temporary file for decryption.');
+            }
+
+            try {
+                $backups->decryptFile($archive, $decrypted);
+                $result['checks'][] = [
+                    'check' => 'authentication',
+                    'status' => 'PASS',
+                    'detail' => 'HMAC verified; plaintext emitted.',
+                ];
+            } catch (RuntimeException $error) {
+                return $fail('authentication', $error->getMessage());
+            }
+
+            // 3. Dump completeness -----------------------------------------
+            $plain = tempnam(sys_get_temp_dir(), 'tlsql');
+
+            if ($plain === false) {
+                return $fail('scratch', 'Unable to allocate a temporary file for decompression.');
+            }
+
+            try {
+                $source = gzopen($decrypted, 'rb');
+
+                if ($source === false) {
+                    return $fail('decompression', 'The decrypted stream is not gzip data.');
+                }
+
+                $destination = fopen($plain, 'wb');
+
+                if ($destination === false) {
+                    gzclose($source);
+
+                    return $fail('decompression', 'Unable to write the decompressed dump.');
+                }
+
+                while (! gzeof($source)) {
+                    $chunk = gzread($source, 262144);
+
+                    if ($chunk === false) {
+                        break;
+                    }
+
+                    fwrite($destination, $chunk);
+                }
+
+                gzclose($source);
+                fclose($destination);
+
+                $bytes = (int) filesize($plain);
+
+                if ($bytes === 0) {
+                    return $fail('decompression', 'The archive decompresses to an empty file.');
+                }
+
+                $driver = str_contains((string) file_get_contents($plain, false, null, 0, 2048), 'PostgreSQL database dump')
+                    ? 'pgsql'
+                    : 'mysql';
+
+                try {
+                    DatabaseDumpService::fromConfig()->assertComplete($plain, $driver);
+                } catch (RuntimeException $error) {
+                    return $fail('completeness', $error->getMessage());
+                }
+
+                $tables = DatabaseDumpService::fromConfig()->countTables($plain, $driver);
+
+                $result['checks'][] = [
+                    'check' => 'completeness',
+                    'status' => 'PASS',
+                    'detail' => sprintf('%d bytes decompressed, %d CREATE TABLE statements, completion marker present.', $bytes, $tables),
+                ];
+                $result['dump_bytes'] = $bytes;
+                $result['tables'] = $tables;
+
+                if ($this->option('deep')) {
+                    $scratchDatabase = (string) ($this->option('scratch-database') ?: '');
+
+                    if ($scratchDatabase === '') {
+                        return $fail('deep_restore', '--deep requires --scratch-database.');
+                    }
+
+                    try {
+                        DatabaseDumpService::fromConfig()->restore($plain, $scratchDatabase);
+
+                        $result['checks'][] = [
+                            'check' => 'deep_restore',
+                            'status' => 'PASS',
+                            'detail' => 'Restored into scratch database '.$scratchDatabase.'.',
+                        ];
+                    } catch (RuntimeException $error) {
+                        return $fail('deep_restore', $error->getMessage());
+                    }
+                }
+            } finally {
+                if (is_file($plain)) {
+                    @unlink($plain);
+                }
+
+                if (is_file($decrypted)) {
+                    @unlink($decrypted);
+                }
+            }
+        } catch (Throwable $error) {
+            return $fail('verification', 'Unexpected failure: '.$error->getMessage());
+        } finally {
+            if (is_file($scratch)) {
+                @unlink($scratch);
+            }
+        }
+
+        $result['status'] = 'VERIFIED';
+
+        return $this->finish($result, $json);
+    }
+
+    /**
+     * @param  array<string, mixed>  $result
+     */
+    private function finish(array $result, bool $json): int
+    {
+        if ($json) {
+            $this->line((string) json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
+        } else {
+            foreach ((array) $result['checks'] as $check) {
+                $this->components->twoColumnDetail(
+                    (string) $check['check'],
+                    sprintf('[%s] %s', (string) $check['status'], (string) $check['detail'])
+                );
+            }
+
+            $result['status'] === 'VERIFIED'
+                ? $this->components->info('Archive verified.')
+                : $this->components->error('Archive verification FAILED.');
+        }
+
+        return $result['status'] === 'VERIFIED' ? self::SUCCESS : self::FAILURE;
+    }
+}
diff --git a/app/Console/Commands/Ops/HealthCommand.php b/app/Console/Commands/Ops/HealthCommand.php
new file mode 100644
index 0000000..79bd9bf
--- /dev/null
+++ b/app/Console/Commands/Ops/HealthCommand.php
@@ -0,0 +1,260 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Console\Commands\Ops;
+
+use App\Services\Observability\SystemHealthService;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Redis;
+use Throwable;
+
+/**
+ * `ops:health` — the probe an external monitor runs, and the one an operator
+ * runs during an incident.
+ *
+ * WHY IT EXISTS WHEN /up/ready ALREADY DOES
+ * -----------------------------------------
+ * /up/ready answers "should traffic be sent here?" with three booleans. That is
+ * the right answer for a load balancer and the wrong answer for a human, and it
+ * cannot see the two operational facts that actually cause lottery incidents:
+ *
+ *   * the scheduler stopped firing (nothing is scheduled, so no job fails, so
+ *     every probe stays green while results never settle);
+ *   * the last verified backup is old (the database is healthy right up to the
+ *     moment it is not).
+ *
+ * So this command adds a scheduler heartbeat, backup age, disk headroom and
+ * failed-job pressure to the same dependency checks, and it is deliberately
+ * usable over SSH without an HTTP request.
+ *
+ * Exit codes: 0 OK, 1 DEGRADED, 2 CRITICAL.
+ */
+class HealthCommand extends Command
+{
+    protected $signature = 'ops:health
+        {--json : Machine-readable output}
+        {--max-backup-age-hours=26 : Age after which the newest verified backup is stale}
+        {--max-heartbeat-minutes=10 : Age after which the scheduler heartbeat is stale}';
+
+    protected $description = 'Report dependency, queue, scheduler-heartbeat, backup-age and disk health with monitoring-friendly exit codes.';
+
+    public function handle(SystemHealthService $health): int
+    {
+        $json = (bool) $this->option('json');
+        $checks = [];
+        $critical = false;
+        $degraded = false;
+
+        // ── Dependencies (shared with /up/ready, so the two cannot disagree) ──
+        $readiness = $health->checkReadiness();
+
+        $checks[] = $this->check('database', (bool) $readiness['database'], (bool) $readiness['database'] ? 'reachable' : 'unreachable');
+        $checks[] = $this->check('cache', (bool) $readiness['cache'], (bool) $readiness['cache'] ? 'reachable' : 'unreachable');
+        $checks[] = $this->check('queue_connection', (bool) $readiness['queue'], (bool) $readiness['queue'] ? 'reachable' : 'unreachable');
+
+        foreach ($checks as $entry) {
+            $critical = $critical || $entry['status'] === 'CRITICAL';
+        }
+
+        // ── Redis, when it is load-bearing ────────────────────────────────────
+        try {
+            Redis::connection()->ping();
+            $checks[] = $this->check('redis', true, 'PONG');
+        } catch (Throwable $error) {
+            // Note the session driver: an app that stores sessions in Redis is
+            // just as broken without it as one that queues there, and the
+            // preflight already classifies it that way.
+            $usesRedis = (string) config('cache.default') === 'redis'
+                || (string) config('queue.default') === 'redis'
+                || (string) config('session.driver') === 'redis';
+
+            if ($usesRedis) {
+                $checks[] = ['name' => 'redis', 'status' => 'CRITICAL', 'detail' => 'not reachable'];
+                $critical = true;
+            } else {
+                // Reporting a dependency the application does not use as
+                // DEGRADED makes every local run and every CI run "unhealthy",
+                // which is how a real outage gets ignored. NOT_CONFIGURED is
+                // visible, accurate, and does not fail the aggregate.
+                $checks[] = [
+                    'name' => 'redis',
+                    'status' => 'NOT_CONFIGURED',
+                    'detail' => 'not reachable, but queue, cache and sessions do not use Redis',
+                ];
+            }
+        }
+
+        // ── Failed jobs ───────────────────────────────────────────────────────
+        try {
+            $failed = (int) DB::table('failed_jobs')->count();
+            $threshold = (int) config('ops.thresholds.failed_jobs_degraded', 10);
+
+            $checks[] = $failed > $threshold
+                ? ['name' => 'failed_jobs', 'status' => 'DEGRADED', 'detail' => $failed.' failed jobs']
+                : $this->check('failed_jobs', true, $failed.' failed jobs');
+
+            $degraded = $degraded || $failed > $threshold;
+        } catch (Throwable) {
+            $checks[] = $this->check('failed_jobs', true, 'not applicable (no failed_jobs table)');
+        }
+
+        // ── Scheduler heartbeat ───────────────────────────────────────────────
+        $heartbeat = $this->schedulerHeartbeatAgeMinutes();
+        $maxHeartbeat = (int) $this->option('max-heartbeat-minutes');
+
+        if ($heartbeat === null) {
+            // A missing heartbeat on a fresh deployment is expected; a missing
+            // heartbeat on a live one means the scheduler never started. Only
+            // the second is a health signal, so the severity follows APP_ENV.
+            $production = in_array((string) config('app.env'), ['production', 'prod'], true);
+
+            $checks[] = [
+                'name' => 'scheduler_heartbeat',
+                'status' => $production ? 'DEGRADED' : 'NOT_CONFIGURED',
+                'detail' => $production
+                    ? 'never recorded — the scheduler is not running'
+                    : 'never recorded (expected outside production; run `php artisan schedule:work`)',
+            ];
+
+            $degraded = $degraded || $production;
+        } elseif ($heartbeat > $maxHeartbeat) {
+            $checks[] = [
+                'name' => 'scheduler_heartbeat',
+                'status' => 'CRITICAL',
+                'detail' => sprintf('%d minutes stale (limit %d)', $heartbeat, $maxHeartbeat),
+            ];
+            $critical = true;
+        } else {
+            $checks[] = $this->check('scheduler_heartbeat', true, $heartbeat.' minutes ago');
+        }
+
+        // ── Backup age ────────────────────────────────────────────────────────
+        $backup = $this->newestBackup();
+        $maxAge = (int) $this->option('max-backup-age-hours');
+
+        if ($backup === null) {
+            $checks[] = ['name' => 'backup_age', 'status' => 'DEGRADED', 'detail' => 'no verified archive found'];
+            $degraded = true;
+        } elseif ($backup['age_hours'] > $maxAge) {
+            $checks[] = [
+                'name' => 'backup_age',
+                'status' => 'DEGRADED',
+                'detail' => sprintf('newest archive is %d hours old (limit %d)', $backup['age_hours'], $maxAge),
+            ];
+            $degraded = true;
+        } else {
+            $checks[] = $this->check('backup_age', true, sprintf('%d hours old, SHA-256 recorded', $backup['age_hours']));
+        }
+
+        // ── Disk headroom ─────────────────────────────────────────────────────
+        $free = @disk_free_space(storage_path());
+        $total = @disk_total_space(storage_path());
+
+        if (is_float($free) && is_float($total) && $total > 0) {
+            $percentFree = ($free / $total) * 100;
+
+            if ($percentFree < 5.0) {
+                $checks[] = ['name' => 'disk_space', 'status' => 'CRITICAL', 'detail' => sprintf('%.1f%% free', $percentFree)];
+                $critical = true;
+            } elseif ($percentFree < 15.0) {
+                $checks[] = ['name' => 'disk_space', 'status' => 'DEGRADED', 'detail' => sprintf('%.1f%% free', $percentFree)];
+                $degraded = true;
+            } else {
+                $checks[] = $this->check('disk_space', true, sprintf('%.1f%% free', $percentFree));
+            }
+        } else {
+            $checks[] = ['name' => 'disk_space', 'status' => 'DEGRADED', 'detail' => 'could not be read'];
+            $degraded = true;
+        }
+
+        $status = $critical ? 'CRITICAL' : ($degraded ? 'DEGRADED' : 'OK');
+
+        if ($json) {
+            $this->line((string) json_encode([
+                'status' => $status,
+                'checks' => $checks,
+                'backup' => $backup,
+                'timestamp' => gmdate('c'),
+            ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
+        } else {
+            $this->newLine();
+
+            foreach ($checks as $entry) {
+                $badge = match ($entry['status']) {
+                    'OK' => '<fg=green>OK  </>',
+                    'DEGRADED' => '<fg=yellow>WARN</>',
+                    'NOT_CONFIGURED' => '<fg=gray>n/a </>',
+                    default => '<fg=red>CRIT</>',
+                };
+
+                $this->line(sprintf('  %s  %-22s %s', $badge, $entry['name'], $entry['detail']));
+            }
+
+            $this->newLine();
+            $status === 'OK'
+                ? $this->components->info('Overall: OK')
+                : $this->components->warn('Overall: '.$status);
+        }
+
+        return $critical ? 2 : ($degraded ? 1 : 0);
+    }
+
+    /**
+     * @return array{name: string, status: string, detail: string}
+     */
+    private function check(string $name, bool $ok, string $detail): array
+    {
+        return ['name' => $name, 'status' => $ok ? 'OK' : 'CRITICAL', 'detail' => $detail];
+    }
+
+    private function schedulerHeartbeatAgeMinutes(): ?int
+    {
+        $path = storage_path('framework/schedule-heartbeat');
+
+        if (! is_file($path)) {
+            return null;
+        }
+
+        $recorded = (int) trim((string) file_get_contents($path));
+
+        if ($recorded <= 0) {
+            return null;
+        }
+
+        return (int) floor((time() - $recorded) / 60);
+    }
+
+    /**
+     * @return array{archive: string, created_at: string, age_hours: int, sha256: string}|null
+     */
+    private function newestBackup(): ?array
+    {
+        $directory = (string) config('backup.path', storage_path('app/backups'));
+        $pointer = rtrim($directory, '/').'/latest.json';
+
+        if (! is_file($pointer)) {
+            return null;
+        }
+
+        $decoded = json_decode((string) file_get_contents($pointer), true);
+
+        if (! is_array($decoded) || ($decoded['verified'] ?? false) !== true) {
+            return null;
+        }
+
+        $createdAt = strtotime((string) ($decoded['created_at'] ?? ''));
+
+        if ($createdAt === false) {
+            return null;
+        }
+
+        return [
+            'archive' => (string) ($decoded['archive'] ?? 'unknown'),
+            'created_at' => (string) $decoded['created_at'],
+            'age_hours' => (int) floor((time() - $createdAt) / 3600),
+            'sha256' => (string) ($decoded['sha256'] ?? ''),
+        ];
+    }
+}
diff --git a/app/Console/Commands/Ops/HeartbeatCommand.php b/app/Console/Commands/Ops/HeartbeatCommand.php
new file mode 100644
index 0000000..1e233dc
--- /dev/null
+++ b/app/Console/Commands/Ops/HeartbeatCommand.php
@@ -0,0 +1,85 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Console\Commands\Ops;
+
+use Illuminate\Console\Command;
+
+/**
+ * `ops:heartbeat` — writes a timestamp the `ops:health` probe can read.
+ *
+ * THE FAILURE MODE THIS ADDRESSES
+ * -------------------------------
+ * `schedule:work` and `schedule:run` are silent when they stop. If cron is
+ * removed, the container is rescheduled without the scheduler, or
+ * `schedule:work` dies, nothing fails: there is no error, no failed job and no
+ * log line, because no job ever started. Every HTTP health probe keeps
+ * answering 200 while draw settlement, prize expiry, reconciliation and
+ * payouts quietly stop happening.
+ *
+ * A scheduled heartbeat turns "the scheduler is running" into a fact with a
+ * timestamp on it, so the absence becomes measurable rather than assumed.
+ *
+ * The file is written with a plain timestamp (not JSON) because it is read by
+ * monitoring shells as well as by PHP, and it must cost nothing to parse when
+ * the host is already in trouble.
+ */
+class HeartbeatCommand extends Command
+{
+    protected $signature = 'ops:heartbeat
+        {--show : Print the current heartbeat age instead of writing one}';
+
+    protected $description = 'Record (or report) the scheduler heartbeat used by ops:health.';
+
+    public function handle(): int
+    {
+        $path = storage_path('framework/schedule-heartbeat');
+        $directory = dirname($path);
+
+        if ($this->option('show')) {
+            if (! is_file($path)) {
+                $this->components->warn('No scheduler heartbeat has ever been recorded.');
+
+                return self::FAILURE;
+            }
+
+            $recorded = (int) trim((string) file_get_contents($path));
+            $age = max(0, time() - $recorded);
+
+            $this->line(sprintf(
+                'Heartbeat %s (%d seconds ago, %s).',
+                gmdate('c', $recorded),
+                $age,
+                $age > 600 ? 'STALE' : 'fresh'
+            ));
+
+            return $age > 600 ? self::FAILURE : self::SUCCESS;
+        }
+
+        if (! is_dir($directory) && ! @mkdir($directory, 0770, true) && ! is_dir($directory)) {
+            $this->components->error('Unable to create storage/framework for the heartbeat file.');
+
+            return self::FAILURE;
+        }
+
+        // Write atomically: a monitor must never read a half-written file and
+        // conclude the scheduler has stopped.
+        $temporary = $path.'.tmp';
+
+        if (@file_put_contents($temporary, (string) time()) === false || ! @rename($temporary, $path)) {
+            @unlink($temporary);
+            $this->components->error('Unable to write the scheduler heartbeat file.');
+
+            return self::FAILURE;
+        }
+
+        @chmod($path, 0660);
+
+        if ($this->output->isVerbose()) {
+            $this->components->info('Scheduler heartbeat recorded at '.gmdate('c').'.');
+        }
+
+        return self::SUCCESS;
+    }
+}
diff --git a/app/Console/Commands/Ops/PreflightCommand.php b/app/Console/Commands/Ops/PreflightCommand.php
new file mode 100644
index 0000000..ce28dc5
--- /dev/null
+++ b/app/Console/Commands/Ops/PreflightCommand.php
@@ -0,0 +1,115 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Console\Commands\Ops;
+
+use App\Support\Ops\ProductionPreflight;
+use Illuminate\Console\Command;
+
+/**
+ * `ops:preflight` — the gate a release passes through before it takes traffic.
+ *
+ * Exit codes are the contract, because everything else that uses this command
+ * is a script:
+ *   0  no blocking failure
+ *   1  at least one blocking failure
+ *   2  warnings only (and `--strict` was passed)
+ *
+ * The output never contains a secret value; see ProductionPreflight.
+ */
+class PreflightCommand extends Command
+{
+    protected $signature = 'ops:preflight
+        {--json : Emit machine-readable JSON (for deploy scripts and CI)}
+        {--offline : Skip database, cache and Redis probes}
+        {--strict : Treat warnings as failures}
+        {--environment= : Assert a specific APP_ENV before running the checks}';
+
+    protected $description = 'Validate production configuration, backup readiness, build artifacts and connectivity without revealing secret values.';
+
+    public function handle(): int
+    {
+        $json = (bool) $this->option('json');
+        $asserted = $this->option('environment');
+
+        if (is_string($asserted) && $asserted !== '' && $asserted !== (string) config('app.env')) {
+            $payload = [
+                'status' => 'FAIL',
+                'environment' => (string) config('app.env'),
+                'checks' => [[
+                    'id' => 'app.environment',
+                    'status' => 'FAIL',
+                    'detail' => sprintf('Refusing to continue: APP_ENV is "%s" but "%s" was required.', (string) config('app.env'), $asserted),
+                    'severity' => 'blocking',
+                ]],
+                'summary' => ['pass' => 0, 'warn' => 0, 'fail' => 1, 'skip' => 0],
+            ];
+
+            $json ? $this->line((string) json_encode($payload, JSON_PRETTY_PRINT)) : $this->components->error($payload['checks'][0]['detail']);
+
+            return self::FAILURE;
+        }
+
+        $production = in_array((string) config('app.env'), ['production', 'prod'], true);
+
+        $report = (new ProductionPreflight($production, ! $this->option('offline')))->run();
+
+        if ($json) {
+            $this->line((string) json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
+        } else {
+            $this->newLine();
+            $this->line(sprintf('  <fg=cyan>Deployment preflight</> — environment <comment>%s</comment>', $report['environment']));
+            $this->newLine();
+
+            foreach ($report['checks'] as $check) {
+                $badge = match ($check['status']) {
+                    'PASS' => '<fg=green>PASS</>',
+                    'WARN' => '<fg=yellow>WARN</>',
+                    'FAIL' => '<fg=red>FAIL</>',
+                    default => '<fg=gray>SKIP</>',
+                };
+
+                $this->line(sprintf('  %s  %-32s %s', $badge, $check['id'], $check['detail']));
+            }
+
+            $this->newLine();
+            $this->line(sprintf(
+                '  %d pass, %d warn, %d fail, %d skipped',
+                $report['summary']['pass'],
+                $report['summary']['warn'],
+                $report['summary']['fail'],
+                $report['summary']['skip'],
+            ));
+        }
+        $blocking = 0;
+
+        foreach ($report['checks'] as $check) {
+            if ($check['status'] === 'FAIL' && $check['severity'] === 'blocking') {
+                $blocking++;
+            }
+        }
+
+        if ($blocking > 0) {
+            if (! $json) {
+                $this->components->error(sprintf('Preflight FAILED: %d blocking problem(s). This release must not proceed.', $blocking));
+            }
+
+            return self::FAILURE;
+        }
+
+        if ($this->option('strict') && $report['summary']['warn'] > 0) {
+            if (! $json) {
+                $this->components->warn('Preflight produced warnings and --strict was passed.');
+            }
+
+            return 2;
+        }
+
+        if (! $json) {
+            $this->components->info('Preflight passed.');
+        }
+
+        return self::SUCCESS;
+    }
+}
