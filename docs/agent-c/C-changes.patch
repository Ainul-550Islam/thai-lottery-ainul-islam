new file mode 100755
index 0000000..b0be171
--- /dev/null
+++ b/scripts/ops/restore.sh
@@ -0,0 +1,170 @@
+#!/usr/bin/env bash
+# =============================================================================
+# restore.sh — restore an encrypted archive into a NAMED database.
+#
+#   # the safe shape: restore into a scratch database, verify, then swap
+#   scripts/ops/restore.sh backup_lottery_ledger_....sql.gz.enc \
+#       --database tl_restore_drill --recreate
+#
+#   # the dangerous shape: restore over the live database
+#   CONFIRM=tl_live scripts/ops/restore.sh archive.enc \
+#       --database tl_live --allow-live --i-understand-this-overwrites-data
+#
+# WHY THIS SCRIPT IS SO FUSSY
+#   A restore is the only operation in this repository that destroys data by
+#   design. Everything here is arranged so that the destructive path requires
+#   four independent deliberate acts:
+#
+#     1. name the exact target database (there is no "current database" default);
+#     2. pass --allow-live if the target is the database the application uses;
+#     3. pass --i-understand-this-overwrites-data;
+#     4. export CONFIRM=<database name> so the confirmation is specific and
+#        appears in the shell history with the target attached.
+#
+#   And one thing that is not negotiable: the archive is authenticated and
+#   extracted into a private temporary file BEFORE the database client is
+#   invoked. A truncated or tampered archive is refused, not imported
+#   half-way.
+#
+# EXIT CODES
+#   0 restored · 1 failure · 2 refused (preconditions unmet)
+# =============================================================================
+set -Eeuo pipefail
+IFS=$'\n\t'
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=lib/common.sh
+. "${SCRIPT_DIR}/lib/common.sh"
+
+ARCHIVE=""
+DATABASE=""
+RECREATE=0
+ALLOW_LIVE=0
+UNDERSTAND=0
+SKIP_VERIFY=0
+KEEP_PLAINTEXT=0
+CONNECTION=""
+
+usage() {
+    cat <<'USAGE'
+Usage: scripts/ops/restore.sh ARCHIVE --database NAME [options]
+
+  ARCHIVE                                Path to the .sql.gz.enc archive
+  --database NAME                        Target database (required, explicit)
+  --connection NAME                      Laravel connection to read host/port/user from
+  --recreate                             DROP and CREATE the target first
+  --allow-live                           Permit restoring over the app's own database
+  --i-understand-this-overwrites-data    Second explicit acknowledgement
+  --skip-verify                          Skip the pre-restore verification pass
+  --keep-plaintext                       Do not shred the temporary SQL file
+  -h, --help                             This text
+
+Environment:
+  CONFIRM=<database name>                Required for every restore
+USAGE
+}
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --database)                          DATABASE="${2:?}"; shift 2 ;;
+        --connection)                        CONNECTION="${2:?}"; shift 2 ;;
+        --recreate)                          RECREATE=1; shift ;;
+        --allow-live)                        ALLOW_LIVE=1; shift ;;
+        --i-understand-this-overwrites-data) UNDERSTAND=1; shift ;;
+        --skip-verify)                       SKIP_VERIFY=1; shift ;;
+        --keep-plaintext)                    KEEP_PLAINTEXT=1; shift ;;
+        -h|--help)                           usage; exit 0 ;;
+        -*)                                  die "Unknown option: $1" ;;
+        *)                                   ARCHIVE="$1"; shift ;;
+    esac
+done
+
+ROOT="$(repo_root "${SCRIPT_DIR}")"
+require_repo_root "${ROOT}" >/dev/null
+require_php
+
+[[ -n "${ARCHIVE}" ]] || refuse "An archive path is required (try --help)."
+[[ -f "${ARCHIVE}" ]] || refuse "Archive not found: ${ARCHIVE}"
+[[ -n "${DATABASE}" ]] || refuse "--database is required. There is deliberately no default target."
+assert_identifier "${DATABASE}" "database name"
+
+# ---------------------------------------------------------------------------
+# Confirmation gate
+# ---------------------------------------------------------------------------
+require_confirmation "${DATABASE}" \
+    "This will write into the database '${DATABASE}'. Every existing row in it is at risk."
+
+# ---------------------------------------------------------------------------
+# Production guard
+# ---------------------------------------------------------------------------
+APP_ENV_VALUE="$(app_env "${ROOT}")"
+CONFIGURED_DB="$(php -r '
+    $root = $argv[1];
+    require $root."/vendor/autoload.php";
+    $app = require $root."/bootstrap/app.php";
+    $app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
+    echo (string) config("database.connections.".($argv[2] ?: config("database.default")).".database");
+' "${ROOT}" "${CONNECTION}" 2>/dev/null || true)"
+
+if [[ -n "${CONFIGURED_DB}" && "${DATABASE}" == "${CONFIGURED_DB}" && "${ALLOW_LIVE}" -eq 0 ]]; then
+    refuse "Refusing to restore into '${DATABASE}': it is the database this application is configured to use. Restore into a scratch database and swap; pass --allow-live if you really mean it."
+fi
+
+if is_production "${APP_ENV_VALUE}" && [[ "${ALLOW_LIVE}" -eq 1 ]]; then
+    if [[ "${UNDERSTAND}" -eq 0 ]]; then
+        refuse "This host is production and the target is the live database. Pass --i-understand-this-overwrites-data as well."
+    fi
+    warn "Restoring into the LIVE database on a production host. Stop the queue workers first (scripts/ops/deploy.sh handles this)."
+fi
+
+if [[ "${RECREATE}" -eq 1 && "${ALLOW_LIVE}" -eq 1 && "${APP_ENV_VALUE}" == "production" ]]; then
+    refuse "--recreate on the live production database would destroy it before the first byte is imported. Use a scratch database."
+fi
+
+# ---------------------------------------------------------------------------
+# Verify before touching a database
+# ---------------------------------------------------------------------------
+if [[ "${SKIP_VERIFY}" -eq 0 ]]; then
+    info "Verifying the archive before restore"
+    artisan "${ROOT}" backup:verify "${ARCHIVE}" --json >/dev/null \
+        || die "Archive failed verification. A restore from an unverified archive is a guess, not a recovery."
+    ok "Archive authenticated"
+fi
+
+PLAINTEXT="$(mktemp "${TMPDIR:-/tmp}/tl-restore-XXXXXXXX.sql")"
+chmod 600 "${PLAINTEXT}"
+
+cleanup() {
+    if [[ "${KEEP_PLAINTEXT}" -eq 0 && -f "${PLAINTEXT}" ]]; then
+        # shred if available, otherwise overwrite then unlink. A plaintext
+        # ledger dump left in /tmp is exactly the artifact an attacker wants.
+        if command -v shred >/dev/null 2>&1; then
+            shred -u "${PLAINTEXT}" 2>/dev/null || rm -f "${PLAINTEXT}"
+        else
+            dd if=/dev/urandom of="${PLAINTEXT}" bs=4096 count=1 conv=notrunc 2>/dev/null || true
+            rm -f "${PLAINTEXT}"
+        fi
+    fi
+}
+trap cleanup EXIT
+
+info "Extracting (authenticated) archive"
+artisan "${ROOT}" backup:extract "${ARCHIVE}" --output="${PLAINTEXT}" --force >/dev/null
+ok "Extracted to a private temporary file"
+
+# ---------------------------------------------------------------------------
+# Restore
+# ---------------------------------------------------------------------------
+info "Restoring into database '${DATABASE}'"
+RESTORE_ARGS=(--database="${DATABASE}")
+[[ -n "${CONNECTION}" ]] && RESTORE_ARGS+=(--connection="${CONNECTION}")
+[[ "${RECREATE}" -eq 1 ]] && RESTORE_ARGS+=(--recreate)
+[[ "${ALLOW_LIVE}" -eq 1 ]] && RESTORE_ARGS+=(--allow-live-target)
+
+if ! artisan "${ROOT}" db:restore-file "${PLAINTEXT}" "${RESTORE_ARGS[@]}"; then
+    die "Restore failed. The database may be partially imported — do not start the application until it is reconciled."
+fi
+
+ok "Restore completed into '${DATABASE}'"
+info "Next: run migrations for this release (php artisan migrate --force) and verify with scripts/ops/healthcheck.sh"
+exit 0
diff --git a/scripts/ops/rollback.sh b/scripts/ops/rollback.sh
new file mode 100755
index 0000000..1aa8075
--- /dev/null
+++ b/scripts/ops/rollback.sh
@@ -0,0 +1,242 @@
+#!/usr/bin/env bash
+# =============================================================================
+# rollback.sh — return the APPLICATION to the previous release.
+#
+#   scripts/ops/rollback.sh --list                 # what releases exist
+#   scripts/ops/rollback.sh --dry-run              # show what would happen
+#   scripts/ops/rollback.sh --yes                  # switch to the previous release
+#   scripts/ops/rollback.sh --yes --to <release>   # switch to a named release
+#
+# WHAT IT RECOVERS, AND WHAT IT DOES NOT
+#   It recovers code: the `current` symlink moves back, caches are rebuilt and
+#   workers are restarted. That is safe, fast and reversible.
+#
+#   It does NOT restore the database. A migration has already run; pointing old
+#   code at a migrated schema is usually fine and sometimes not, but restoring a
+#   backup silently would discard every bet placed since it was taken. The data
+#   decision is printed as an explicit next step with the exact command, and it
+#   is a human's call — see docs/ops/OPS-RUNBOOK.md.
+#
+# EXPECTED LAYOUT (release-directory deploys)
+#   /srv/thai-lottery/releases/20261024T021500Z/
+#   /srv/thai-lottery/releases/20261023T021500Z/
+#   /srv/thai-lottery/current -> releases/20261024T021500Z
+#
+# EXIT CODES: 0 rolled back · 1 failed · 2 refused
+# =============================================================================
+set -Eeuo pipefail
+IFS=$'\n\t'
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=lib/common.sh
+. "${SCRIPT_DIR}/lib/common.sh"
+
+RELEASES_DIR="${RELEASES_DIR:-}"
+TARGET_RELEASE=""
+LIST=0
+DRY_RUN=0
+YES=0
+
+usage() {
+    cat <<'USAGE'
+Usage: scripts/ops/rollback.sh [options]
+
+  --releases-dir DIR   Release root (default: $RELEASES_DIR or ../releases of the app)
+  --list               List releases, newest first, and mark the current one
+  --to RELEASE         Switch to this release instead of the previous one
+  --dry-run            Show the plan only
+  --yes                Required to change the symlink
+  -h, --help           This text
+
+Environment:
+  RELEASES_DIR         Default release root
+  SMOKE_BASE_URL       Used by the post-rollback smoke test
+USAGE
+}
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --releases-dir) RELEASES_DIR="${2:?}"; shift 2 ;;
+        --to)           TARGET_RELEASE="${2:?}"; shift 2 ;;
+        --list)         LIST=1; shift ;;
+        --dry-run)      DRY_RUN=1; shift ;;
+        --yes)          YES=1; shift ;;
+        -h|--help)      usage; exit 0 ;;
+        *)              die "Unknown option: $1" ;;
+    esac
+done
+
+ROOT="$(repo_root "${SCRIPT_DIR}")"
+require_repo_root "${ROOT}" >/dev/null
+require_php
+require_command git
+
+# Resolve the release root: explicit flag, environment, or the sibling
+# `releases` directory of a standard release-directory layout.
+if [[ -z "${RELEASES_DIR}" ]]; then
+    if [[ -d "${ROOT}/../releases" ]]; then
+        RELEASES_DIR="$(cd -- "${ROOT}/../releases" && pwd)"
+    else
+        RELEASES_DIR="${ROOT}"
+    fi
+fi
+
+if [[ ! -d "${RELEASES_DIR}" ]]; then
+    die "Release directory does not exist: ${RELEASES_DIR}"
+fi
+
+# A directory only counts as a release if it actually contains an application.
+# Without this filter, invoking the script in a plain checkout walks the app's
+# own subdirectories (vendor, storage, app, …) and offers `vendor` as a rollback
+# target — which is worse than refusing, because it looks like a plan.
+mapfile -t RELEASES < <(
+    find "${RELEASES_DIR}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null \
+        | while IFS= read -r candidate; do
+            # `if` rather than `&&` so a non-matching candidate does not make the
+            # loop exit non-zero under `set -e`.
+            if [[ -f "${RELEASES_DIR}/${candidate}/artisan" ]]; then
+                printf '%s\n' "${candidate}"
+            fi
+        done \
+        | sort -r
+)
+
+if [[ "${#RELEASES[@]}" -eq 0 ]]; then
+    if [[ "${LIST}" -eq 1 ]]; then
+        printf '  (none) %s is not a release-directory layout: no sibling directory contains artisan.\n' "${RELEASES_DIR}"
+        exit 0
+    fi
+
+    die "No releases found in ${RELEASES_DIR} (a release is a directory containing artisan). This host does not look like it uses release-directory deploys; roll back with your deployment tooling and follow docs/ops/OPS-RUNBOOK.md."
+fi
+
+# The `current` symlink normally sits beside `releases/`, but some layouts keep
+# it inside the release root. Resolve both, and fall back to the script's own
+# directory only as a last resort.
+resolve_current() {
+    local candidate
+
+    for candidate in "${RELEASES_DIR}/current" "${RELEASES_DIR}/../current" "${ROOT}"; do
+        if [[ -e "${candidate}" ]]; then
+            basename "$(readlink -f "${candidate}")"
+            return 0
+        fi
+    done
+
+    printf 'unknown'
+}
+
+CURRENT="$(resolve_current)"
+
+if [[ "${LIST}" -eq 1 ]]; then
+    info "Releases in ${RELEASES_DIR} (newest first):"
+    for release in "${RELEASES[@]}"; do
+        if [[ "${release}" == "${CURRENT}" ]]; then
+            printf '  * %s  (current)\n' "${release}"
+        else
+            printf '    %s\n' "${release}"
+        fi
+    done
+    exit 0
+fi
+
+if [[ -n "${TARGET_RELEASE}" ]]; then
+    PREVIOUS="${TARGET_RELEASE}"
+else
+    PREVIOUS=""
+    for release in "${RELEASES[@]}"; do
+        if [[ "${release}" != "${CURRENT}" ]]; then
+            PREVIOUS="${release}"
+            break
+        fi
+    done
+fi
+
+if [[ -z "${PREVIOUS}" ]]; then
+    die "There is no previous release to roll back to (current: ${CURRENT:-none})."
+fi
+
+if [[ ! -d "${RELEASES_DIR}/${PREVIOUS}" ]]; then
+    die "Release does not exist: ${PREVIOUS}"
+fi
+
+if [[ ! -f "${RELEASES_DIR}/${PREVIOUS}/artisan" ]]; then
+    die "${RELEASES_DIR}/${PREVIOUS} is not an application release (no artisan file). Refusing to point the deployment at it."
+fi
+
+if [[ "${PREVIOUS}" == "${CURRENT}" ]]; then
+    die "The current release is already ${CURRENT}; choose a different release with --to <release>."
+fi
+
+info "Current release: ${CURRENT:-unknown}"
+info "Target release:  ${PREVIOUS}"
+
+if [[ -d "${RELEASES_DIR}/${PREVIOUS}/.git" ]] || git -C "${RELEASES_DIR}/${PREVIOUS}" rev-parse --git-dir >/dev/null 2>&1; then
+    info "Target commit:  $(git -C "${RELEASES_DIR}/${PREVIOUS}" rev-parse --short HEAD 2>/dev/null || echo unknown)"
+fi
+
+if [[ "${DRY_RUN}" -eq 1 ]]; then
+    cat <<PLAN
+Plan (dry run):
+  1. point ${RELEASES_DIR}/current at ${PREVIOUS}
+  2. php artisan optimize:clear && config:cache && route:cache && view:cache
+  3. php artisan queue:restart (+ horizon:terminate)
+  4. scripts/ops/smoke-test.sh
+  5. print the database decision (nothing is restored automatically)
+
+Note: migrations are NOT reverted. If the failed release ran a destructive
+migration, restoring the pre-release backup is a separate, manual decision:
+  CONFIRM=<db> scripts/ops/restore.sh <archive> --database <db> --allow-live \\
+      --i-understand-this-overwrites-data
+PLAN
+    exit 0
+fi
+
+if [[ "${YES}" -eq 0 ]]; then
+    die "Refusing to switch releases without --yes."
+fi
+
+if is_production "$(app_env "${ROOT}")"; then
+    require_confirmation "${PREVIOUS}" "Rolling production back to ${PREVIOUS}."
+fi
+
+info "Switching current -> ${PREVIOUS}"
+ln -sfn "${RELEASES_DIR}/${PREVIOUS}" "${RELEASES_DIR}/current.tmp"
+mv -Tf "${RELEASES_DIR}/current.tmp" "${RELEASES_DIR}/current"
+ok "Symlink switched"
+
+NEW_ROOT="${RELEASES_DIR}/${PREVIOUS}"
+
+if [[ -f "${NEW_ROOT}/artisan" ]]; then
+    artisan "${NEW_ROOT}" optimize:clear >/dev/null || warn "optimize:clear reported a problem."
+    artisan "${NEW_ROOT}" config:cache >/dev/null || warn "config:cache failed."
+    artisan "${NEW_ROOT}" route:cache >/dev/null || warn "route:cache failed."
+    artisan "${NEW_ROOT}" view:cache >/dev/null || warn "view:cache failed."
+    artisan "${NEW_ROOT}" queue:restart >/dev/null || warn "queue:restart failed."
+    ok "Caches rebuilt and workers signalled"
+fi
+
+if [[ -x "${NEW_ROOT}/scripts/ops/smoke-test.sh" ]]; then
+    if ! "${NEW_ROOT}/scripts/ops/smoke-test.sh"; then
+        warn "Smoke test still failing after the rollback. The problem is probably not the release."
+    fi
+fi
+
+cat <<'NEXT'
+
+Rollback of the application is complete.
+
+Next steps (manual, and deliberately not automated):
+  1. Confirm the release is serving: scripts/ops/smoke-test.sh
+  2. Decide about the database. Migrations from the failed release are still
+     applied. If that release dropped or renamed anything, restore the backup
+     taken by scripts/ops/deploy.sh (it is verified, encrypted, and its SHA-256
+     is in the matching .manifest.json):
+       scripts/ops/verify-backup.sh --deep --scratch-database tl_restore_drill
+       CONFIRM=<db> scripts/ops/restore.sh <archive> --database <db> --allow-live \
+           --i-understand-this-overwrites-data
+  3. Record what happened, which release was bad, and which migration is
+     implicated in docs/ops/INCIDENTS.md.
+NEXT
+
+exit 0
diff --git a/scripts/ops/smoke-test.sh b/scripts/ops/smoke-test.sh
new file mode 100755
index 0000000..9b13a53
--- /dev/null
+++ b/scripts/ops/smoke-test.sh
@@ -0,0 +1,180 @@
+#!/usr/bin/env bash
+# =============================================================================
+# smoke-test.sh — the checks that decide whether a deployment is serving.
+#
+#   scripts/ops/smoke-test.sh                          # http://127.0.0.1:8000
+#   scripts/ops/smoke-test.sh --base-url https://…     # a real deployment
+#   scripts/ops/smoke-test.sh --json                   # for CI
+#
+# WHAT IT CHECKS, AND WHY EACH ONE
+#   1. /up/live                 the process answers at all
+#   2. /up/ready                database, cache and queue are reachable — this is
+#                               the endpoint whose 503 means "do not route here"
+#   3. /robots.txt              static serving works and the search directives
+#                               shipped (a broken nginx root is invisible until
+#                               someone notices every page is unstyled)
+#   4. manifest asset           EVERY file the Vite manifest references is
+#                               fetchable. A manifest that exists while its
+#                               hashed assets 404 is the single most common
+#                               "deployed but looks broken" failure
+#   5. public pages             a 200 from the real application, not just the
+#                               probe endpoints
+#
+# It is deliberately read-only: no POST, no login, no writes to production data.
+# A smoke test that mutates state cannot be run against production, and the
+# deploy needs to run it against production.
+#
+# EXIT CODES: 0 all checks passed · 1 at least one failed
+# =============================================================================
+set -Eeuo pipefail
+IFS=$'\n\t'
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=lib/common.sh
+. "${SCRIPT_DIR}/lib/common.sh"
+
+BASE_URL="${SMOKE_BASE_URL:-http://127.0.0.1:8000}"
+TIMEOUT=10
+RETRIES=3
+JSON=0
+
+usage() {
+    cat <<'USAGE'
+Usage: scripts/ops/smoke-test.sh [options]
+
+  --base-url URL   Deployment to test (default: $SMOKE_BASE_URL or 127.0.0.1:8000)
+  --timeout N      Per-request timeout in seconds (default 10)
+  --retries N      Attempts per check before failing (default 3)
+  --json           Machine-readable results
+  -h, --help       This text
+USAGE
+}
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --base-url) BASE_URL="${2:?}"; shift 2 ;;
+        --timeout)  TIMEOUT="${2:?}"; shift 2 ;;
+        --retries)  RETRIES="${2:?}"; shift 2 ;;
+        --json)     JSON=1; shift ;;
+        -h|--help)  usage; exit 0 ;;
+        *)          die "Unknown option: $1" ;;
+    esac
+done
+
+ROOT="$(repo_root "${SCRIPT_DIR}")"
+BASE_URL="${BASE_URL%/}"
+require_command curl
+
+PASSED=0
+FAILED=0
+RESULTS="[]"
+
+record() {
+    local name="$1" status="$2" detail="$3"
+
+    RESULTS="$(php -r '
+        $results = json_decode((string)($argv[1] ?? "[]"), true) ?: [];
+        $results[] = ["check" => $argv[2], "status" => $argv[3], "detail" => $argv[4]];
+        echo json_encode($results);
+    ' "${RESULTS}" "${name}" "${status}" "${detail}")"
+}
+
+# probe NAME PATH EXPECTED_STATUS_REGEX [extra curl args...]
+probe() {
+    local name="$1" path="$2" expected="$3"
+    shift 3
+
+    local attempt=1 code="000"
+
+    while [[ "${attempt}" -le "${RETRIES}" ]]; do
+        code="$(curl --silent --output /dev/null --write-out '%{http_code}' \
+            --max-time "${TIMEOUT}" --location --max-redirs 3 \
+            "${BASE_URL}${path}" "$@" 2>/dev/null || echo "000")"
+
+        if [[ "${code}" =~ ^(${expected})$ ]]; then
+            ok "${name} (${path}) -> ${code}"
+            PASSED=$((PASSED + 1))
+            record "${name}" "PASS" "HTTP ${code}"
+
+            return 0
+        fi
+
+        sleep 1
+        attempt=$((attempt + 1))
+    done
+
+    warn "${name} (${path}) -> ${code} (expected ${expected})"
+    FAILED=$((FAILED + 1))
+    record "${name}" "FAIL" "HTTP ${code}"
+
+    return 1
+}
+
+info "Smoke test against ${BASE_URL}"
+
+# 1-2. Probe endpoints. /up/ready is allowed to be 503 only if it says so — a
+# 503 is a legitimate answer from a starting deployment, so it fails here and
+# the deploy script decides what to do.
+probe "liveness" "/up/live" "200" || true
+probe "readiness" "/up/ready" "200" || true
+
+# 3. Static serving.
+probe "robots" "/robots.txt" "200" || true
+
+# 4. Every asset the manifest references must be fetchable.
+MANIFEST="${ROOT}/public/build/manifest.json"
+
+if [[ -f "${MANIFEST}" ]]; then
+    ASSETS="$(php -r '
+        $manifest = json_decode((string) file_get_contents($argv[1]), true) ?: [];
+        $files = [];
+        foreach ($manifest as $entry) {
+            if (is_array($entry) && isset($entry["file"])) { $files[] = $entry["file"]; }
+            foreach ((array) ($entry["css"] ?? []) as $css) { $files[] = $css; }
+        }
+        foreach (array_unique($files) as $file) { echo $file, PHP_EOL; }
+    ' "${MANIFEST}")"
+
+    MISSING=0
+
+    while IFS= read -r asset; do
+        [[ -z "${asset}" ]] && continue
+
+        code="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time "${TIMEOUT}" "${BASE_URL}/build/${asset}" || echo 000)"
+
+        if [[ "${code}" != "200" ]]; then
+            warn "manifest asset not served: /build/${asset} -> ${code}"
+            MISSING=$((MISSING + 1))
+        fi
+    done <<< "${ASSETS}"
+
+    if [[ "${MISSING}" -eq 0 ]]; then
+        ok "every manifest asset is served"
+        PASSED=$((PASSED + 1))
+        record "build_assets" "PASS" "all manifest files fetched"
+    else
+        FAILED=$((FAILED + 1))
+        record "build_assets" "FAIL" "${MISSING} manifest asset(s) not served"
+    fi
+else
+    warn "public/build/manifest.json is absent on this host; skipping asset checks."
+    $([ "${JSON}" -eq 1 ] || true)
+    record "build_assets" "SKIP" "no manifest on this host"
+fi
+
+# 5. Real pages.
+probe "home" "/" "200|302" || true
+probe "results" "/results" "200|301|302" || true
+probe "api_health" "/api/health" "200" || true
+
+if [[ "${JSON}" -eq 1 ]]; then
+    printf '{"base_url":"%s","passed":%d,"failed":%d,"results":%s}\n' \
+        "${BASE_URL}" "${PASSED}" "${FAILED}" "${RESULTS}"
+fi
+
+if [[ "${FAILED}" -gt 0 ]]; then
+    die "${FAILED} smoke check(s) failed against ${BASE_URL}"
+fi
+
+ok "All smoke checks passed (${PASSED})"
+exit 0
diff --git a/scripts/ops/verify-backup.sh b/scripts/ops/verify-backup.sh
new file mode 100755
index 0000000..4387583
--- /dev/null
+++ b/scripts/ops/verify-backup.sh
@@ -0,0 +1,133 @@
+#!/usr/bin/env bash
+# =============================================================================
+# verify-backup.sh — prove an archive is readable before you need it to be.
+#
+#   scripts/ops/verify-backup.sh                       # newest archive
+#   scripts/ops/verify-backup.sh path/to/archive.enc   # a specific archive
+#   scripts/ops/verify-backup.sh --all                 # every archive on disk
+#   scripts/ops/verify-backup.sh --deep --scratch-database tl_restore_drill
+#
+# This is the script a nightly monitor should run. It never writes plaintext to
+# a durable location and never touches the live database: --deep restores into
+# a scratch database whose name the caller must supply.
+#
+# EXIT CODES
+#   0 every checked archive verified · 1 at least one failed · 2 refused
+# =============================================================================
+set -Eeuo pipefail
+IFS=$'\n\t'
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=lib/common.sh
+. "${SCRIPT_DIR}/lib/common.sh"
+
+DEEP=0
+SCRATCH_DB=""
+CHECK_ALL=0
+TARGET=""
+JSON=0
+
+usage() {
+    cat <<'USAGE'
+Usage: scripts/ops/verify-backup.sh [ARCHIVE] [options]
+
+  ARCHIVE                  Archive to verify (default: newest in the backup dir)
+  --all                    Verify every archive in the backup directory
+  --deep                   Also restore into --scratch-database and compare
+  --scratch-database NAME  Target for --deep (must not be the live database)
+  --json                   Machine-readable output
+  -h, --help               This text
+USAGE
+}
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --all)              CHECK_ALL=1; shift ;;
+        --deep)             DEEP=1; shift ;;
+        --scratch-database) SCRATCH_DB="${2:?}"; shift 2 ;;
+        --json)             JSON=1; shift ;;
+        -h|--help)          usage; exit 0 ;;
+        -*)                 die "Unknown option: $1" ;;
+        *)                  TARGET="$1"; shift ;;
+    esac
+done
+
+ROOT="$(repo_root "${SCRIPT_DIR}")"
+require_repo_root "${ROOT}" >/dev/null
+require_php
+
+BACKUP_DIR="${BACKUP_PATH:-${ROOT}/storage/app/backups}"
+
+if [[ "${DEEP}" -eq 1 && -z "${SCRATCH_DB}" ]]; then
+    die "--deep requires --scratch-database NAME. Refusing to restore into an unnamed target."
+fi
+
+if [[ "${DEEP}" -eq 1 ]]; then
+    assert_identifier "${SCRATCH_DB}" "scratch database"
+fi
+
+collect_archives() {
+    if [[ -n "${TARGET}" ]]; then
+        printf '%s' "${TARGET}"
+        return
+    fi
+
+    if [[ "${CHECK_ALL}" -eq 1 ]]; then
+        find "${BACKUP_DIR}" -maxdepth 1 -name 'backup_lottery_ledger_*.sql.gz.enc' -type f | sort
+        return
+    fi
+
+    # Newest only: this is the one a monitor cares about.
+    find "${BACKUP_DIR}" -maxdepth 1 -name 'backup_lottery_ledger_*.sql.gz.enc' -type f -printf '%T@ %p\n' 2>/dev/null \
+        | sort -rn | head -n1 | cut -d' ' -f2-
+}
+
+ARCHIVES="$(collect_archives)"
+
+if [[ -z "${ARCHIVES}" ]]; then
+    die "No archives found in ${BACKUP_DIR}. If this host is supposed to have backups, that is the incident."
+fi
+
+FAILED=0
+CHECKED=0
+SUMMARY="[]"
+
+while IFS= read -r archive; do
+    [[ -z "${archive}" ]] && continue
+    [[ -f "${archive}" ]] || die "Archive not found: ${archive}"
+
+    CHECKED=$((CHECKED + 1))
+
+    ARGS=("${archive}" --json)
+    [[ "${DEEP}" -eq 1 ]] && ARGS+=(--deep "--scratch-database=${SCRATCH_DB}")
+
+    if OUTPUT="$(artisan "${ROOT}" backup:verify "${ARGS[@]}" 2>&1)"; then
+        ok "$(basename "${archive}")"
+    else
+        warn "verification FAILED: $(basename "${archive}")"
+        printf '%s\n' "${OUTPUT}" >&2
+        FAILED=$((FAILED + 1))
+    fi
+
+    SUMMARY="$(php -r '
+        $summary = json_decode((string)($argv[1] ?? "[]"), true) ?: [];
+        $result  = json_decode((string)($argv[2] ?? "{}"), true) ?: [];
+        $summary[] = [
+            "archive" => basename((string)($argv[3] ?? "")),
+            "status"  => $result["status"] ?? "FAILED",
+            "checks"  => $result["checks"] ?? [],
+        ];
+        echo json_encode($summary);
+    ' "${SUMMARY}" "${OUTPUT}" "${archive}")"
+done <<< "${ARCHIVES}"
+
+if [[ "${JSON}" -eq 1 ]]; then
+    printf '{"checked":%d,"failed":%d,"results":%s}\n' "${CHECKED}" "${FAILED}" "${SUMMARY}"
+fi
+
+if [[ "${FAILED}" -gt 0 ]]; then
+    die "${FAILED} of ${CHECKED} archive(s) failed verification."
+fi
+
+ok "${CHECKED} archive(s) verified."
+exit 0
diff --git a/tests/Feature/Ops/ProductionPreflightTest.php b/tests/Feature/Ops/ProductionPreflightTest.php
new file mode 100644
index 0000000..fe80a79
--- /dev/null
+++ b/tests/Feature/Ops/ProductionPreflightTest.php
@@ -0,0 +1,190 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Tests\Feature\Ops;
+
+use App\Support\Ops\ProductionPreflight;
+use Illuminate\Contracts\Console\Kernel;
+use Illuminate\Foundation\Application;
+use Illuminate\Foundation\Testing\TestCase as BaseTestCase;
+
+/**
+ * The preflight is the gate a release passes through, so what it *reports* is a
+ * safety property of the deployment process.
+ *
+ * Two classes of bug are pinned here:
+ *   1. the checks do not fire when they should (a broken release is allowed);
+ *   2. the report leaks the values it is inspecting (a preflight transcript in a
+ *      ticket becomes a credential disclosure).
+ *
+ * This suite deliberately extends the framework's TestCase instead of
+ * Tests\TestCase: the shared base class migrates the database on every boot,
+ * and the preflight is a pure configuration gate — every case here passes
+ * `withConnectivity: false`, so no schema is involved. Booting without the
+ * schema keeps this gate testable while the database/migrations lane is
+ * repaired elsewhere (see HANDOFF-C.md), instead of hiding a working safety
+ * check behind an unrelated fixture failure.
+ */
+final class ProductionPreflightTest extends BaseTestCase
+{
+    public function createApplication(): Application
+    {
+        $app = require Application::inferBasePath().'/bootstrap/app.php';
+        $app->make(Kernel::class)->bootstrap();
+
+        return $app;
+    }
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        // The preflight inspects compiled assets; nothing here renders a view.
+        $this->withoutVite();
+    }
+
+    private const SECRET_KEY = 'a-production-backup-key-of-sufficient-length';
+
+    public function test_a_production_release_with_debug_enabled_is_blocked(): void
+    {
+        $this->app['config']->set('app.env', 'production');
+        $this->app['config']->set('app.debug', true);
+
+        $report = (new ProductionPreflight(production: true, withConnectivity: false))->run();
+
+        $this->assertSame('FAIL', $report['status']);
+
+        $failing = array_column(
+            array_filter($report['checks'], static fn (array $check): bool => $check['status'] === 'FAIL'),
+            'id'
+        );
+
+        $this->assertContains('app.debug', $failing);
+    }
+
+    public function test_a_production_release_without_a_backup_key_is_blocked(): void
+    {
+        $this->app['config']->set('app.env', 'production');
+        $this->app['config']->set('backup.key', null);
+        $this->app['config']->set('backup.key_file', null);
+
+        $report = (new ProductionPreflight(production: true, withConnectivity: false))->run();
+
+        $backup = collect($report['checks'])->firstWhere('id', 'backup.key');
+
+        $this->assertNotNull($backup);
+        $this->assertSame('FAIL', $backup['status'], 'a production release must not proceed without a backup key');
+    }
+
+    public function test_a_production_release_with_a_short_backup_key_is_blocked(): void
+    {
+        $this->app['config']->set('app.env', 'production');
+        $this->app['config']->set('backup.key', 'only-16-chars-ok');
+        $this->app['config']->set('backup.key_file', null);
+
+        $report = (new ProductionPreflight(production: true, withConnectivity: false))->run();
+
+        $backup = collect($report['checks'])->firstWhere('id', 'backup.key');
+
+        $this->assertSame('FAIL', $backup['status']);
+        $this->assertStringContainsString('at least 32', (string) $backup['detail']);
+    }
+
+    public function test_the_report_never_contains_a_secret_value(): void
+    {
+        $this->app['config']->set('app.env', 'production');
+        $this->app['config']->set('app.debug', false);
+        $this->app['config']->set('backup.key', self::SECRET_KEY);
+        $this->app['config']->set('backup.key_file', null);
+        $this->app['config']->set('app.health_detail_token', str_repeat('h', 40));
+        $this->app['config']->set('app.key', 'base64:'.base64_encode(str_repeat('k', 32)));
+        $this->app['config']->set('database.redis.default.password', 'redis-super-secret');
+
+        $report = (new ProductionPreflight(production: true, withConnectivity: false))->run();
+        $serialised = (string) json_encode($report);
+
+        foreach ([self::SECRET_KEY, 'redis-super-secret', str_repeat('h', 40), str_repeat('k', 32), (string) config('app.key')] as $secret) {
+            $this->assertStringNotContainsString($secret, $serialised, 'the preflight report leaked a secret value');
+        }
+
+        // It must still be useful: the shape (length) is reported.
+        $backup = collect($report['checks'])->firstWhere('id', 'backup.key');
+        $this->assertStringContainsString((string) strlen(self::SECRET_KEY), (string) $backup['detail']);
+    }
+
+    public function test_missing_build_artifacts_fail_a_production_release(): void
+    {
+        $this->app['config']->set('app.env', 'production');
+
+        $manifest = public_path('build/manifest.json');
+        $existed = is_file($manifest);
+        $contents = $existed ? (string) file_get_contents($manifest) : null;
+
+        if ($existed) {
+            @unlink($manifest);
+        }
+
+        try {
+            $report = (new ProductionPreflight(production: true, withConnectivity: false))->run();
+            $build = collect($report['checks'])->firstWhere('id', 'build.manifest');
+
+            $this->assertNotNull($build);
+            $this->assertSame('FAIL', $build['status']);
+        } finally {
+            if ($existed && $contents !== null) {
+                @mkdir(dirname($manifest), 0775, true);
+                file_put_contents($manifest, $contents);
+            }
+        }
+    }
+
+    public function test_queue_retry_after_must_exceed_the_longest_worker_timeout(): void
+    {
+        // The classic double-execution bug: retry_after below the worker timeout
+        // means a slow-but-alive job is handed to a second worker.
+        $this->app['config']->set('queue.default', 'redis');
+        $this->app['config']->set('queue.connections.redis.retry_after', 60);
+        $this->app['config']->set('horizon.environments.production.supervisor-1', [
+            'connection' => 'redis',
+            'queue' => ['default'],
+            'timeout' => 300,
+        ]);
+
+        $report = (new ProductionPreflight(production: true, withConnectivity: false))->run();
+        $timeouts = collect($report['checks'])->firstWhere('id', 'queue.timeouts');
+
+        $this->assertSame('FAIL', $timeouts['status']);
+        $this->assertStringContainsString('executed twice', (string) $timeouts['detail']);
+    }
+
+    public function test_a_sync_queue_blocks_production_but_only_warns_elsewhere(): void
+    {
+        // A production request must never run a payout inline. Outside
+        // production the sync driver is the correct default, and failing the
+        // gate there teaches operators to ignore it.
+        $this->app['config']->set('queue.default', 'sync');
+
+        $this->app['config']->set('app.env', 'production');
+        $production = collect((new ProductionPreflight(production: true, withConnectivity: false))->run()['checks'])
+            ->firstWhere('id', 'queue.timeouts');
+        $this->assertSame('FAIL', $production['status']);
+
+        $this->app['config']->set('app.env', 'local');
+        $local = collect((new ProductionPreflight(production: false, withConnectivity: false))->run()['checks'])
+            ->firstWhere('id', 'queue.timeouts');
+        $this->assertSame('WARN', $local['status']);
+    }
+
+    public function test_a_non_production_environment_warns_instead_of_blocking(): void
+    {
+        $this->app['config']->set('app.env', 'local');
+        $this->app['config']->set('backup.key', null);
+        $this->app['config']->set('backup.key_file', null);
+
+        $report = (new ProductionPreflight(production: false, withConnectivity: false))->run();
+        $backup = collect($report['checks'])->firstWhere('id', 'backup.key');
+
+        $this->assertSame('WARN', $backup['status']);
+    }
+}
diff --git a/tests/Unit/Infrastructure/BackupCipherTest.php b/tests/Unit/Infrastructure/BackupCipherTest.php
new file mode 100644
index 0000000..8d639f8
--- /dev/null
+++ b/tests/Unit/Infrastructure/BackupCipherTest.php
@@ -0,0 +1,233 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Tests\Unit\Infrastructure;
+
+use App\Support\Backup\BackupCipher;
+use PHPUnit\Framework\TestCase;
+use RuntimeException;
+
+/**
+ * The backup cipher is the only thing standing between a stolen archive and the
+ * financial ledger, so its failure modes are tested rather than assumed.
+ *
+ * Each test below corresponds to a way the encryption could be decorative:
+ * it round-trips but does not detect tampering, it accepts a committed default
+ * key, or it writes a plaintext file when decryption fails half-way.
+ */
+final class BackupCipherTest extends TestCase
+{
+    private const KEY = 'correct horse battery staple 32 chars';
+
+    private string $workspace;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->workspace = sys_get_temp_dir().'/tl-cipher-'.bin2hex(random_bytes(6));
+        mkdir($this->workspace, 0700, true);
+    }
+
+    protected function tearDown(): void
+    {
+        foreach (glob($this->workspace.'/*') ?: [] as $file) {
+            @unlink($file);
+        }
+
+        @rmdir($this->workspace);
+
+        parent::tearDown();
+    }
+
+    public function test_string_payloads_round_trip(): void
+    {
+        $cipher = new BackupCipher(self::KEY);
+        $plaintext = "-- ledger snapshot\nINSERT INTO ledger_transactions VALUES ('tx-1', 'POSTED');";
+
+        $envelope = $cipher->encryptString($plaintext);
+
+        $this->assertStringStartsWith(BackupCipher::STRING_MAGIC, $envelope);
+        $this->assertStringNotContainsString('ledger_transactions', $envelope, 'the payload must not appear in the clear');
+        $this->assertSame($plaintext, $cipher->decryptString($envelope));
+    }
+
+    public function test_two_encryptions_of_the_same_plaintext_differ(): void
+    {
+        $cipher = new BackupCipher(self::KEY);
+
+        // A deterministic ciphertext would let an observer confirm a guess.
+        $this->assertNotSame(
+            $cipher->encryptString('same input'),
+            $cipher->encryptString('same input'),
+        );
+    }
+
+    public function test_a_tampered_string_payload_is_rejected(): void
+    {
+        $cipher = new BackupCipher(self::KEY);
+        $envelope = $cipher->encryptString('amount=1000');
+
+        // Flip the last byte: this is what "change one digit in the archive"
+        // looks like to a GCM tag.
+        $envelope[strlen($envelope) - 1] = chr(ord($envelope[strlen($envelope) - 1]) ^ 0x01);
+
+        $this->expectException(RuntimeException::class);
+        $this->expectExceptionMessage('failed authentication');
+
+        $cipher->decryptString($envelope);
+    }
+
+    public function test_a_payload_encrypted_with_another_key_is_rejected(): void
+    {
+        $envelope = (new BackupCipher(self::KEY))->encryptString('ledger');
+
+        $this->expectException(RuntimeException::class);
+
+        (new BackupCipher('a completely different 32 char key!'))->decryptString($envelope);
+    }
+
+    public function test_a_missing_key_is_a_hard_failure(): void
+    {
+        $this->expectException(RuntimeException::class);
+        $this->expectExceptionMessage('No backup encryption key');
+
+        new BackupCipher('');
+    }
+
+    public function test_a_short_key_is_refused(): void
+    {
+        $this->expectException(RuntimeException::class);
+        $this->expectExceptionMessage('too short');
+
+        new BackupCipher('short');
+    }
+
+    public function test_the_committed_placeholder_key_that_shipped_in_this_repository_is_refused(): void
+    {
+        // This literal used to be the fallback default in ImmutableBackupService.
+        // Every archive ever produced with it is readable by anyone who has the
+        // repository, so it must never be accepted again.
+        $this->expectException(RuntimeException::class);
+        $this->expectExceptionMessage('placeholder');
+
+        new BackupCipher('HardenedBackupKey2026MasterSecret!');
+    }
+
+    public function test_file_archives_round_trip_beyond_one_chunk(): void
+    {
+        $cipher = new BackupCipher(self::KEY);
+
+        // 2.5 MiB spans three 1 MiB chunks, which is where a broken per-chunk
+        // nonce or a missed final-chunk flush would show up.
+        $payload = random_bytes(2621440);
+        $source = $this->workspace.'/dump.sql';
+        $archive = $this->workspace.'/dump.sql.enc';
+        $restored = $this->workspace.'/restored.sql';
+
+        file_put_contents($source, $payload);
+
+        $result = $cipher->encryptFile($source, $archive);
+
+        $this->assertFileExists($archive);
+        $this->assertGreaterThan(strlen($payload), $result['ciphertext_bytes'], 'the envelope carries a header and a MAC');
+        $this->assertSame(hash_file('sha256', $archive), $result['sha256']);
+
+        $cipher->decryptFile($archive, $restored);
+
+        $this->assertSame(hash('sha256', $payload), hash_file('sha256', $restored));
+    }
+
+    public function test_a_tampered_file_archive_emits_no_plaintext(): void
+    {
+        $cipher = new BackupCipher(self::KEY);
+
+        $source = $this->workspace.'/dump.sql';
+        $archive = $this->workspace.'/dump.sql.enc';
+        $restored = $this->workspace.'/restored.sql';
+
+        file_put_contents($source, str_repeat('INSERT INTO ledger_transactions VALUES (1);'.PHP_EOL, 500));
+        $cipher->encryptFile($source, $archive);
+
+        // Corrupt a byte in the ciphertext body (past the 8+1+16+32 header).
+        $handle = fopen($archive, 'r+b');
+        fseek($handle, 200);
+        fwrite($handle, "\xFF");
+        fclose($handle);
+
+        try {
+            $cipher->decryptFile($archive, $restored);
+            $this->fail('A tampered archive decrypted successfully.');
+        } catch (RuntimeException $error) {
+            $this->assertStringContainsString('failed authentication', $error->getMessage());
+        }
+
+        // The critical property: no partial plaintext is left behind for a
+        // restore script to import.
+        $this->assertFileDoesNotExist($restored);
+    }
+
+    public function test_a_truncated_file_archive_is_rejected(): void
+    {
+        $cipher = new BackupCipher(self::KEY);
+
+        $source = $this->workspace.'/dump.sql';
+        $archive = $this->workspace.'/dump.sql.enc';
+        $restored = $this->workspace.'/restored.sql';
+
+        file_put_contents($source, str_repeat('x', 65536));
+        $cipher->encryptFile($source, $archive);
+
+        // A copy interrupted by a full disk looks exactly like this.
+        $size = (int) filesize($archive);
+        $handle = fopen($archive, 'r+b');
+        ftruncate($handle, (int) ($size / 2));
+        fclose($handle);
+
+        $this->expectException(RuntimeException::class);
+
+        $cipher->decryptFile($archive, $restored);
+    }
+
+    public function test_a_swapped_but_valid_archive_is_caught_by_the_recorded_checksum(): void
+    {
+        $cipher = new BackupCipher(self::KEY);
+
+        $first = $this->workspace.'/first.sql';
+        $second = $this->workspace.'/second.sql';
+        $firstArchive = $this->workspace.'/first.enc';
+        $secondArchive = $this->workspace.'/second.enc';
+        $restored = $this->workspace.'/restored.sql';
+
+        file_put_contents($first, 'first dump');
+        file_put_contents($second, 'second dump');
+
+        $firstResult = $cipher->encryptFile($first, $firstArchive);
+        $cipher->encryptFile($second, $secondArchive);
+
+        // Both archives are authentic; only the manifest ties them to a point in
+        // time. Restoring yesterday's ledger because it happens to be the file
+        // on disk is a real recovery failure mode.
+        $this->expectException(RuntimeException::class);
+        $this->expectExceptionMessage('checksum mismatch');
+
+        $cipher->decryptFile($secondArchive, $restored, $firstResult['sha256']);
+    }
+
+    public function test_inspect_reports_the_envelope_without_decrypting(): void
+    {
+        $cipher = new BackupCipher(self::KEY);
+        $source = $this->workspace.'/dump.sql';
+        $archive = $this->workspace.'/dump.sql.enc';
+
+        file_put_contents($source, 'dump');
+        $cipher->encryptFile($source, $archive);
+
+        $header = $cipher->inspectFile($archive);
+
+        $this->assertSame(BackupCipher::FILE_MAGIC, $header['magic']);
+        $this->assertSame(BackupCipher::FORMAT_VERSION, $header['version']);
+        $this->assertTrue($header['plaintext_ready']);
+    }
+}
diff --git a/tests/Unit/Logging/RedactingProcessorTest.php b/tests/Unit/Logging/RedactingProcessorTest.php
new file mode 100644
index 0000000..d75e124
--- /dev/null
+++ b/tests/Unit/Logging/RedactingProcessorTest.php
@@ -0,0 +1,158 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Tests\Unit\Logging;
+
+use App\Logging\RedactingProcessor;
+use Monolog\Level;
+use Monolog\LogRecord;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Redaction is a control, not a formatting preference: an unredacted log line
+ * during a payment incident is a credential disclosure in a ticket, a chat
+ * channel and a log aggregator at once.
+ *
+ * These tests pin the behaviour that matters — what IS redacted, and the two
+ * things that must NOT be (keys that only look sensitive, and values that carry
+ * no secret) so the redactor stays usable.
+ */
+final class RedactingProcessorTest extends TestCase
+{
+    private function record(array $context = [], array $extra = [], string $message = 'test'): LogRecord
+    {
+        return new LogRecord(
+            datetime: new \DateTimeImmutable('2026-10-24T00:00:00Z'),
+            channel: 'testing',
+            level: Level::Info,
+            message: $message,
+            context: $context,
+            extra: $extra,
+        );
+    }
+
+    public function test_credential_keys_are_masked_at_any_depth(): void
+    {
+        $processor = new RedactingProcessor;
+
+        $result = ($processor)($this->record([
+            'user_id' => 42,
+            'password' => 'hunter2',
+            'nested' => [
+                'gateway' => ['api_secret' => 'sk_live_abc', 'currency' => 'THB'],
+                'authorization' => 'Bearer abcdefghijklmnop',
+            ],
+        ]));
+
+        $this->assertSame(42, $result->context['user_id'], 'non-secret context must survive');
+        $this->assertSame('[REDACTED]', $result->context['password']);
+        $this->assertSame('[REDACTED]', $result->context['nested']['gateway']['api_secret']);
+        $this->assertSame('THB', $result->context['nested']['gateway']['currency']);
+        $this->assertSame('[REDACTED]', $result->context['nested']['authorization']);
+    }
+
+    public function test_key_matching_is_case_and_separator_insensitive(): void
+    {
+        $processor = new RedactingProcessor;
+
+        $result = ($processor)($this->record([
+            'X-Api-Key' => 'abc123',
+            'apiKey' => 'abc123',
+            'API_TOKEN' => 'abc123',
+            'ClientSecret' => 'abc123',
+        ]));
+
+        foreach (['X-Api-Key', 'apiKey', 'API_TOKEN', 'ClientSecret'] as $key) {
+            $this->assertSame('[REDACTED]', $result->context[$key], $key.' was not redacted');
+        }
+    }
+
+    public function test_policy_keys_that_only_look_sensitive_are_preserved(): void
+    {
+        // tokens / token_type / password_min_length are configuration, and
+        // redacting them makes the log useless without protecting anything.
+        $processor = new RedactingProcessor;
+
+        $result = ($processor)($this->record([
+            'token_type' => 'bearer',
+            'tokens' => 5,
+            'password_min_length' => 12,
+        ]));
+
+        $this->assertSame('bearer', $result->context['token_type']);
+        $this->assertSame(5, $result->context['tokens']);
+        $this->assertSame(12, $result->context['password_min_length']);
+    }
+
+    public function test_secrets_embedded_in_a_message_are_masked(): void
+    {
+        $processor = new RedactingProcessor;
+
+        $result = ($processor)($this->record(
+            message: 'Gateway rejected: Authorization: Bearer sk_live_abcdefgh1234 password=Sup3rSecret!'
+                .' connecting to mysql://lottery:S3cretPw@db:3306/lottery'
+        ));
+
+        $this->assertStringNotContainsString('sk_live_abcdefgh1234', $result->message);
+        $this->assertStringNotContainsString('Sup3rSecret!', $result->message);
+        $this->assertStringNotContainsString('S3cretPw', $result->message);
+        $this->assertStringContainsString('[REDACTED]', $result->message);
+    }
+
+    public function test_a_data_source_name_in_a_connection_error_is_masked(): void
+    {
+        $processor = new RedactingProcessor;
+
+        $result = ($processor)($this->record(
+            message: 'SQLSTATE[HY000] [1045] Access denied for user "lottery" (using password: YES)'
+        ));
+
+        $this->assertStringNotContainsString('using password: YES', $result->message);
+    }
+
+    public function test_objects_are_not_stringified_into_the_log(): void
+    {
+        $processor = new RedactingProcessor;
+
+        $object = new class
+        {
+            public function __toString(): string
+            {
+                return 'password=hunter2';
+            }
+        };
+
+        $result = ($processor)($this->record(['credentials' => $object, 'safe' => $object]));
+
+        $this->assertStringNotContainsString('hunter2', (string) json_encode($result->context));
+        $this->assertStringContainsString('object', (string) $result->context['safe']);
+    }
+
+    public function test_exception_messages_are_scrubbed_while_the_exception_survives(): void
+    {
+        $processor = new RedactingProcessor;
+        $exception = new \RuntimeException('PDO failed for mysql://user:S3cretPw@db/lottery');
+
+        $result = ($processor)($this->record(['exception' => $exception]));
+
+        $this->assertInstanceOf(\Throwable::class, $result->context['exception']);
+        $this->assertStringNotContainsString('S3cretPw', $result->context['exception']->getMessage());
+        $this->assertStringContainsString('[REDACTED]', $result->context['exception']->getMessage());
+    }
+
+    public function test_deep_structures_are_truncated_rather_than_followed_forever(): void
+    {
+        $processor = new RedactingProcessor;
+
+        $nested = ['level' => 'leaf'];
+
+        for ($i = 0; $i < 30; $i++) {
+            $nested = ['nested' => $nested];
+        }
+
+        $result = ($processor)($this->record(['payload' => $nested]));
+
+        $this->assertStringContainsString('[TRUNCATED]', (string) json_encode($result->context));
+    }
+}
diff --git a/tests/Unit/Logging/StructuredLogChannelTest.php b/tests/Unit/Logging/StructuredLogChannelTest.php
new file mode 100644
index 0000000..fa3eb90
--- /dev/null
+++ b/tests/Unit/Logging/StructuredLogChannelTest.php
@@ -0,0 +1,162 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Tests\Unit\Logging;
+
+use App\Logging\RedactSensitiveData;
+use Illuminate\Contracts\Console\Kernel;
+use Illuminate\Foundation\Application;
+use Illuminate\Foundation\Testing\TestCase;
+use Monolog\Formatter\JsonFormatter;
+use Monolog\Formatter\LineFormatter;
+use Monolog\Handler\StreamHandler;
+use Monolog\Level;
+use Monolog\Logger;
+
+/**
+ * The log *channel* contract, as opposed to the redaction logic itself (covered
+ * by RedactingProcessorTest).
+ *
+ * This file exists because of a bug found while verifying structured logging:
+ * `config/logging.php` declared a `stderr` channel with `handler` and
+ * `formatter`, but no `with.stream`. Laravel therefore handed the StreamHandler
+ * the application log path, so:
+ *
+ *   LOG_CHANNEL=stderr LOG_FORMAT=json
+ *
+ * wrote a TEXT line into storage/logs/laravel.log instead of JSON on stderr —
+ * and the resolved handler had no redaction tap, so a context array containing
+ * `password` was written to disk in the clear. Both halves of that are pinned
+ * here: the channel must stream to stderr, and every channel that leaves the
+ * process must carry the redaction tap.
+ */
+final class StructuredLogChannelTest extends TestCase
+{
+    public function createApplication(): Application
+    {
+        $app = require Application::inferBasePath().'/bootstrap/app.php';
+        $app->make(Kernel::class)->bootstrap();
+
+        return $app;
+    }
+
+    /**
+     * Re-read config/logging.php under a given LOG_FORMAT.
+     *
+     * The config file calls storage_path(), so it needs a booted application —
+     * the whole file is re-evaluated by rebuilding the application with the
+     * environment variable set, which is exactly what a container does on start.
+     *
+     * @return array<string, array<string, mixed>>
+     */
+    private function channels(string $logFormat = 'text'): array
+    {
+        $previous = getenv('LOG_FORMAT');
+        putenv('LOG_FORMAT='.$logFormat);
+        $_ENV['LOG_FORMAT'] = $logFormat;
+        $_SERVER['LOG_FORMAT'] = $logFormat;
+
+        try {
+            $this->refreshApplication();
+
+            /** @var array<string, array<string, mixed>> $channels */
+            $channels = $this->app['config']->get('logging.channels');
+        } finally {
+            if ($previous === false) {
+                putenv('LOG_FORMAT');
+                unset($_ENV['LOG_FORMAT'], $_SERVER['LOG_FORMAT']);
+            } else {
+                putenv('LOG_FORMAT='.$previous);
+                $_ENV['LOG_FORMAT'] = $previous;
+                $_SERVER['LOG_FORMAT'] = $previous;
+            }
+        }
+
+        return $channels;
+    }
+
+    public function test_the_stderr_channel_streams_to_stderr_not_to_the_application_log(): void
+    {
+        $stderr = $this->channels()['stderr'];
+
+        $this->assertSame(StreamHandler::class, $stderr['handler'], 'the stderr channel must use a stream handler');
+        $this->assertArrayHasKey('with', $stderr, 'a StreamHandler without an explicit stream falls back to the application log file');
+        $this->assertSame('php://stderr', $stderr['with']['stream']);
+    }
+
+    public function test_the_stderr_channel_is_json_when_log_format_asks_for_json(): void
+    {
+        $json = $this->channels('json')['stderr'];
+
+        $this->assertSame(JsonFormatter::class, $json['formatter'], 'containers need one JSON object per line to index fields');
+        $this->assertSame(JsonFormatter::BATCH_MODE_NEWLINES, $json['formatter_with']['batchMode']);
+        $this->assertTrue($json['formatter_with']['appendNewline']);
+    }
+
+    public function test_the_text_format_remains_the_default(): void
+    {
+        $text = $this->channels('text')['stderr'];
+
+        $this->assertSame(LineFormatter::class, $text['formatter']);
+        $this->assertArrayHasKey('format', $text['formatter_with']);
+    }
+
+    public function test_every_channel_that_writes_a_log_record_carries_the_redaction_tap(): void
+    {
+        $exempt = ['emergency'];
+
+        foreach ($this->channels() as $name => $config) {
+            if (! is_array($config) || in_array($name, $exempt, true)) {
+                continue;
+            }
+
+            // `stack` fans out to channels that are themselves tapped; `null`
+            // discards records; both are exempt by construction.
+            if (in_array($name, ['stack', 'null'], true)) {
+                continue;
+            }
+
+            $this->assertContains(
+                RedactSensitiveData::class,
+                $config['tap'] ?? [],
+                sprintf('log channel "%s" writes records but does not carry the redaction tap', $name)
+            );
+        }
+    }
+
+    public function test_a_record_written_through_the_stderr_channel_is_json_and_redacted(): void
+    {
+        $channel = $this->channels('json')['stderr'];
+
+        $stream = fopen('php://memory', 'wb+');
+
+        $handler = new StreamHandler($stream, Level::Debug);
+        $handler->setFormatter(new JsonFormatter(
+            JsonFormatter::BATCH_MODE_NEWLINES,
+            true,
+        ));
+
+        $logger = new \Illuminate\Log\Logger(new Logger('local', [$handler]));
+
+        // The tap is what Laravel applies; applying it here proves the pair of
+        // classes the channel configures actually redact when combined.
+        $tap = new RedactSensitiveData;
+        $tap($logger);
+
+        $logger->info('payment captured', ['password' => 'hunter2', 'amount' => 12.5]);
+
+        rewind($stream);
+        $line = trim((string) stream_get_contents($stream));
+        fclose($stream);
+
+        $this->assertNotSame('', $line, 'the channel wrote nothing');
+
+        /** @var array<string, mixed> $record */
+        $record = json_decode($line, true, 512, JSON_THROW_ON_ERROR);
+
+        $this->assertSame('payment captured', $record['message']);
+        $this->assertSame('[REDACTED]', $record['context']['password'], 'a credential survived into a structured log line');
+        $this->assertSame(12.5, $record['context']['amount'], 'non-secret context must survive redaction');
+    }
+}
