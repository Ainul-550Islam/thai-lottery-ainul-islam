includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes

    # The level 8 is the highest level of strictness in PHPStan
    level: 8

    ignoreErrors:
        - '#PHPDoc tag @var#'

    # PHPStan 2 removed checkMissingIterableValueType /
    # checkGenericClassInNonGenericObjectType; listing them makes the whole
    # configuration invalid, which is why this file never actually ran.
    reportUnmatchedIgnoredErrors: false
