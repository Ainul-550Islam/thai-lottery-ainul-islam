<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Security">
            <directory>tests/Security</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- PROMPT 3: the shared regression suite runs with the CAPTCHA
             gate disabled (the pre-existing login/register tests predate
             the challenge). The CAPTCHA contract itself is exercised by
             MemberAuthParityTest, which re-enables it per-test at runtime
             and verifies real challenges end to end. -->
        <env name="AUTH_CAPTCHA_ENABLED" value="false"/>
        <env name="APP_KEY" value="base64:ZdZRVoeGZh2IQXa67+qdQzaPbjnFovX4CCE0YgWHJI8="/>
        <env name="APP_DEBUG" value="false"/>
        <!--
            A FILE-BACKED SQLite database, not :memory:.
            The Phase 4.3+ suites use DatabaseTruncation (not RefreshDatabase) because a
            purchase refuses to run inside an outer transaction. Truncation commits, so the
            schema must outlive the per-test application refresh - which an in-memory
            database cannot do. The name stays `thai_lottery_test` because every suite
            carries a fail-safe guard that refuses to touch any other database name.
            Tests\TestCase migrates it once per process if it is empty.
        -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value="database/thai_lottery_test"/>
        <env name="DB_FOREIGN_KEYS" value="true"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="BROADCAST_CONNECTION" value="log"/>
        <!-- `array` is not a configured disk in config/filesystems.php; using it made any
             Storage call in a test fail with "Disk [array] does not have a configured driver". -->
        <env name="FILESYSTEM_DISK" value="local"/>

        <!-- LOTTERY FIXTURE LANES: REQUIRED BY THE PUBLIC-PAGE SUITES.
             Every public-page and lane-parity test seeds its data by calling
             the lane importer with the 'fixture' provider, e.g.
             $this->importer()->import($payload, 'fixture').

             config/{lane}_lottery.php defaults each fixture lane to false and
             phpunit.xml never turned them on, so those imports returned
             ['status' => 'rejected', 'source_state' => 'NOT_CONFIGURED'],
             nothing was ever published, and every public page rendered its
             empty state. That is the root cause of the public-page content
             assertions, not a missing view.

             Enabling them here is scoped to PHPUnit only. It cannot leak into
             a deployment: each lane config force-disables the fixture source
             whenever APP_ENV === 'production', .env.example / .env.ci /
             .env.production.example all ship these flags off, and
             ProductionConfigSafetyTest asserts all of that independently. -->
        <!-- risk.exposure.max_stake_per_number has no default by design:
             a silently invented real-money ceiling would look configured
             while expressing nobody's risk appetite. The test environment
             must therefore state one explicitly, exactly as a production
             operator must. -->
        <env name="RISK_MAX_STAKE_PER_NUMBER" value="100000.00"/>
        <env name="WEEKLY_LOTTERY_FIXTURE_ENABLED" value="true"/>
        <env name="NATIONAL_LOTTERY_FIXTURE_ENABLED" value="true"/>
        <env name="PCSO_LOTTERY_FIXTURE_ENABLED" value="true"/>
        <env name="BINGO_LOTTERY_FIXTURE_ENABLED" value="true"/>
    </php>
</phpunit>
