# Production environment key list. Inject actual values from a secret manager;
# this file intentionally contains no credential values.
APP_NAME="Thai Lottery"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lottery.example.invalid
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SANCTUM_TOKEN_EXPIRATION=1440

# GLO is money-bearing: production must use the official source and no fixture rung.
GLO_OFFICIAL_SOURCE_MODE=official
GLO_SOURCE_PRIORITY=official
GLO_FALL_THROUGH_TO_FIXTURE=false

# Public lottery fixtures are explicitly off in production.
NATIONAL_LOTTERY_FIXTURE_ENABLED=false
WEEKLY_LOTTERY_FIXTURE_ENABLED=false
BINGO_LOTTERY_FIXTURE_ENABLED=false
PCSO_LOTTERY_FIXTURE_ENABLED=false

# Safe payout posture until the operator has explicitly commissioned live payouts.
PRIZE_PAYOUT_SAFETY_MODE=DISABLED
PRIZE_PAYOUT_REQUIRE_APPROVAL_AT=1000000.00
LOTTERY_AUTO_PAYOUT=false

# Example credential names only; values are supplied at deployment time.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_APP_SECRET=
