# Production provisioning checklist, NOT a ready-to-deploy environment.
# Supply blank deployment values and credentials from your secret store.
# Do not derive production .env from the development or CI templates.
# No key, gateway authorization, operator identity or source agreement is supplied.
APP_NAME="Lottery Results"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=

# Shared stores are mandatory for cross-instance session/throttle/idempotency.
CACHE_STORE=redis
CACHE_PREFIX=
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
SANCTUM_TOKEN_EXPIRATION=1440
SANCTUM_STATEFUL_DOMAINS=

# Payout, settlement automation and agent commissions stay disabled.
PRIZE_PAYOUT_SAFETY_MODE=DISABLED
PRIZE_PAYOUT_AUTO_APPROVE_BELOW=0.00
PRIZE_PAYOUT_REQUIRE_APPROVAL_AT=0.00
LOTTERY_AUTO_PAYOUT=false
LOTTERY_AUTOMATION_ENABLED=false
LOTTERY_AUTO_SETTLE=false
AGENT_COMMISSION_ENABLED=false
FINANCE_DEPOSIT_AUTO_CONFIRM=false
FINANCE_LEDGER_AUTO_RECONCILE=false
FINANCE_WITHDRAWAL_KYC_GATE_ENABLED=true
# No deployment risk ceiling is invented. Provision one before accepting stakes.
RISK_MAX_STAKE_PER_NUMBER=

# Selecting official mode is not a claim of affiliation or a working feed.
# Imports still require a verified payload and independent confirmation.
GLO_OFFICIAL_SOURCE_MODE=official
GLO_SOURCE_PRIORITY=official
GLO_FALL_THROUGH_TO_FIXTURE=false
NATIONAL_LOTTERY_FIXTURE_ENABLED=false
WEEKLY_LOTTERY_FIXTURE_ENABLED=false
BINGO_LOTTERY_FIXTURE_ENABLED=false
PCSO_LOTTERY_FIXTURE_ENABLED=false
# No result endpoint/token is supplied for an uncontracted provider.
NATIONAL_LOTTERY_OFFICIAL_ENDPOINT=
NATIONAL_LOTTERY_OFFICIAL_TOKEN=
WEEKLY_LOTTERY_OFFICIAL_ENDPOINT=
WEEKLY_LOTTERY_OFFICIAL_TOKEN=
BINGO_LOTTERY_OFFICIAL_ENDPOINT=
BINGO_LOTTERY_OFFICIAL_TOKEN=
PCSO_LOTTERY_OFFICIAL_ENDPOINT=
PCSO_LOTTERY_OFFICIAL_TOKEN=
WEEKLY_LOTTERY_INTEGRITY_PUBLIC_KEY=

# Payment gateways are unavailable until separately approved and configured.
STRIPE_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
BKASH_ENABLED=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_ENABLED=false
NAGAD_APP_KEY=
NAGAD_APP_SECRET=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
CRYPTO_ENABLED=false
CRYPTO_GATEWAY_API_KEY=
CRYPTO_GATEWAY_API_SECRET=
CRYPTO_GATEWAY_WEBHOOK_SECRET=
BANK_TRANSFER_ENABLED=false
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_INSTRUCTIONS=
PROMPTPAY_ENABLED=false
PROMPTPAY_WEBHOOK_SECRET=

# Only publish real operator/support information after verification.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_REGISTRATION=
LEGAL_OPERATOR_ADDRESS=
LEGAL_SUPPORT_EMAIL=
LEGAL_SUPPORT_PHONE=
CONTACT_SUPPORT_NAME=
CONTACT_SUPPORT_EMAIL=
CONTACT_SUPPORT_HOURS=
HOME_SUPPORT_EMAIL=
HOME_SUPPORT_PHONE=
HOME_SUPPORT_HOURS=
VITE_APP_NAME="${APP_NAME}"
