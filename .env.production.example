# literal standing in for the config/config\view.php expression default
VIEW_COMPILED_PATH=framework/views
# credential-shaped: deliberately EMPTY, see CREDENTIAL_KEY above
VITE_REVERB_APP_KEY=
# literal standing in for the config/config\realtime.php expression default
VITE_REVERB_HOST=
# literal standing in for the config/config\realtime.php expression default
VITE_REVERB_PORT=443
# literal standing in for the config/config\realtime.php expression default
VITE_REVERB_SCHEME=https
# literal standing in for the config/config\payment.php expression default
WEBHOOK_REPLAY_GUARD_RETENTION_DAYS=30
# credential-shaped: deliberately EMPTY, see CREDENTIAL_KEY above
WEEKLY_LOTTERY_INTEGRITY_PUBLIC_KEY=
# literal standing in for the config/config\weekly_lottery.php expression default
WEEKLY_LOTTERY_OFFICIAL_ENDPOINT=
# credential-shaped: deliberately EMPTY, see CREDENTIAL_KEY above
WEEKLY_LOTTERY_OFFICIAL_TOKEN=

PROMPTPAY_DEFAULT_MERCHANT_ID=



# SQLite only: journal_mode PRAGMA. "null" issues none; phpunit.xml sets its own.
DB_JOURNAL_MODE=null
# SQLite only: synchronous PRAGMA. "null" issues none; phpunit.xml sets its own.
DB_SYNCHRONOUS=null
