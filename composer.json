{
    "name": "thai-lottery/system",
    "type": "project",
    "description": "Real Online Thai Lottery System - Production-grade Laravel 11 application",
    "keywords": [
        "laravel",
        "lottery",
        "thai-lottery",
        "betting",
        "wallet",
        "ledger"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "filament/filament": "^3.3",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "spatie/laravel-permission": "^6.4",
        "symfony/polyfill-intl-icu": "^1.29"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"echo PHP_EOL, '>> No .env was created. This project never derives a deployment .env from .env.example.', PHP_EOL, '   Local development:  composer run env:local', PHP_EOL, '   Production:         provision .env from your secret store using .env.production.example as the key list.', PHP_EOL, PHP_EOL;\""
        ],
        "post-create-project-cmd": [],
        "env:local": [
            "@php -r \"if (file_exists('.env')) { fwrite(STDERR, '.env already exists; refusing to overwrite.' . PHP_EOL); exit(1); } copy('.env.example', '.env'); echo '.env created from the DEVELOPMENT template.' . PHP_EOL;\"",
            "@php artisan key:generate --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "test": [
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
