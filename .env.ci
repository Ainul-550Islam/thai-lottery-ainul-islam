# Disposable CI environment only. Never deploy this file.
# PHPUnit enables its own explicitly labelled result fixtures in phpunit.xml.
# The workflow generates a temporary APP_KEY after Composer has installed.
APP_NAME="Lottery Test Suite"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=sqlite
DB_DATABASE=database/thai_lottery_test
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=15000
CACHE_STORE=array
SESSION_DRIVER=array
SESSION_ENCRYPT=false
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
SANCTUM_TOKEN_EXPIRATION=1440

AUTH_CAPTCHA_ENABLED=false
AGENT_COMMISSION_ENABLED=false
LOTTERY_AUTO_PAYOUT=false
LOTTERY_AUTOMATION_ENABLED=false
LOTTERY_AUTO_SETTLE=false
PRIZE_PAYOUT_SAFETY_MODE=DISABLED
FINANCE_DEPOSIT_AUTO_CONFIRM=false
FINANCE_LEDGER_AUTO_RECONCILE=false
# This is test data configuration, not a deployment risk limit.
RISK_MAX_STAKE_PER_NUMBER=100000.00

# No provider credentials and no real gateway access in CI.
STRIPE_ENABLED=false
BKASH_ENABLED=false
NAGAD_ENABLED=false
CRYPTO_ENABLED=false
BANK_TRANSFER_ENABLED=false
PROMPTPAY_ENABLED=false

GLO_OFFICIAL_SOURCE_MODE=fixture
GLO_SOURCE_PRIORITY=
GLO_FALL_THROUGH_TO_FIXTURE=false
NATIONAL_LOTTERY_FIXTURE_ENABLED=false
WEEKLY_LOTTERY_FIXTURE_ENABLED=false
BINGO_LOTTERY_FIXTURE_ENABLED=false
PCSO_LOTTERY_FIXTURE_ENABLED=false
NATIONAL_LOTTERY_OFFICIAL_ENDPOINT=
WEEKLY_LOTTERY_OFFICIAL_ENDPOINT=
BINGO_LOTTERY_OFFICIAL_ENDPOINT=
PCSO_LOTTERY_OFFICIAL_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"
