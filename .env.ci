# Non-secret CI runtime defaults. GitHub Actions copies this file to .env.
# PHPUnit's phpunit.xml overrides the SQLite path and other test-only settings.
APP_NAME="Thai Lottery CI"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=database/thai_lottery_test
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=15000
DB_TRANSACTION_MODE=IMMEDIATE

CACHE_STORE=array
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=array
SANCTUM_TOKEN_EXPIRATION=1440

# CI defaults to the official result source and never falls through to fixtures.
GLO_OFFICIAL_SOURCE_MODE=official
GLO_SOURCE_PRIORITY=official
GLO_FALL_THROUGH_TO_FIXTURE=false

# These provider-fixture switches remain off; tests opt into their own fixtures.
NATIONAL_LOTTERY_FIXTURE_ENABLED=false
WEEKLY_LOTTERY_FIXTURE_ENABLED=false
BINGO_LOTTERY_FIXTURE_ENABLED=false
PCSO_LOTTERY_FIXTURE_ENABLED=false

# A stated test limit; production operators must set their real limit separately.
RISK_MAX_STAKE_PER_NUMBER=100000.00
