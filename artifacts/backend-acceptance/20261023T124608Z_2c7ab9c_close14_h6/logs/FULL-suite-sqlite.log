/*\n
|--------------------------------------------------------------------------\n
| Browser payment-return pages (FINAL AUDIT #2)\n
|--------------------------------------------------------------------------\n
|\n
| Where a gateway drops the player's browser after checkout. PRESENTATION\n
| ONLY: the landing route is context, the displayed state is always the\n
| internal payment record (see PaymentCallbackController), and nothing on\n
| these pages can credit or change money. Paths come from the same\n
| config/payment.php callback block the gateway drivers build their\n
| success/cancel URLs from, so they can never drift apart.\n
|\n
*/\n
\n
Route::middleware('auth')->group(function (): void {\n
    // The config values may be absolute URLs ("${APP_URL}/payment/success")\n
    // because the gateway drivers hand them to providers; route registration\n
    // only wants the path component, so normalize once here.\n
    $callbackPath = static function (string $key, string $default): string {\n
        $value = (string) config('payment.callback.'.$key, $default);\n
        $path = parse_url($value, PHP_URL_PATH);\n
\n
        return is_string($path) && $path !== '' ? $path : $default;\n
    };\n
\n
    Route::get($callbackPath('success_url', '/payment/success'), [PaymentCallbackController::class, 'success'])\n
        ->name('payment.callback.success');\n
\n
    Route::get($callbackPath('failure_url', '/payment/failure'), [PaymentCallbackController::class, 'failure'])\n
        ->name('payment.callback.failure');\n
\n
    Route::get($callbackPath('cancel_url', '/payment/cancel'), [PaymentCallbackController::class, 'cancel'])\n
        ->name('payment.callback.cancel');\n
\n
    Route::get($callbackPath('pending_url', '/payment/pending'), [PaymentCallbackController::class, 'pending'])\n
        ->name('payment.callback.pending');\n
});\n
\n
// User-facing locale switch route (session & cookie persistence)\n
Route::get('/locale/{locale}', function (string $locale) {\n
    if (\App\Support\SupportedLocale::isSupported($locale)) {\n
        session(['locale' => $locale]);\n
        cookie()->queue(cookie('locale', $locale, 60 * 24 * 365));\n
    }\n
\n
    return redirect()->back();\n
})->name('locale.switch');\n
\n
