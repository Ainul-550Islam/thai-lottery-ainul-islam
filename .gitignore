/vendor/
/node_modules/
/.phpunit.cache/
/.phpunit.result.cache
/database/*.sqlite
/database/thai_lottery_test*
/database/*.db
/storage/*.key
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/.env
/.env.*
!/.env.example
# Both of these ARE the deployment contract, not a deployment's secrets: CI
# copies .env.ci to .env so the pipeline never boots from the development
# template, and .env.production.example ships every credential valueless.
# ProductionConfigSafetyTest asserts .env.ci is committed and that the
# production template leaks nothing, so an ignore rule here would fail the build.
!/.env.ci
!/.env.production.example
/phpunit.xml.bak

# PROMPT 6: Rust build artefacts. Cargo.lock IS committed (cargo --locked
# needs it and the crate is an application binary, not a published library);
# target/ is machine-specific output and is not.
/security/*/target

# Front-end build output (regenerated by `npm run build`; CI builds it fresh).
/public/build
vendor.tar.gz
runtime/settlement-worker/target/
