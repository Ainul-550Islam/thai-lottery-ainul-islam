/vendor/
/node_modules/
/.phpunit.cache/
/.phpunit.result.cache
/database/*.sqlite
/database/thai_lottery_test*
/database/*.db
/storage/*.key
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/.env
/.env.*
# The development template and the two reviewed deployment templates are
# version controlled on purpose. Everything else under .env* is a real
# environment and must never be committed.
!/.env.example
!/.env.ci
!/.env.production.example
/phpunit.xml.bak

# PROMPT 6: Rust build artefacts. Cargo.lock IS committed (cargo --locked
# needs it and the crate is an application binary, not a published library);
# target/ is machine-specific output and is not.
/security/*/target

# Front-end build output (regenerated by `npm run build`; CI builds it fresh).
/public/build
vendor.tar.gz

# Signed Android release artifacts. The Signed Android APK workflow uploads
# them as an Actions artifact and they are deployed out-of-band to these exact
# paths (android/README.md). A binary is never committed to Git.
/app/thai-apk.apk
/app/thai-apk.manifest.json
