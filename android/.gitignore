# Gradle / Android build output (regenerated by assembleDebug / assembleRelease).
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/

# Local SDK location written by Android Studio / sdkmanager. Machine specific.
local.properties

# Release signing material. The production keystore lives only in the
# protected GitHub Actions secrets (ANDROID_KEYSTORE_BASE64) and the
# organization's keystore backup. It must NEVER be committed.
*.jks
*.keystore

# IDE and OS noise.
.idea/
*.iml
.DS_Store
